---
const navItems = [
	{ idx: '01', label: 'Work', href: '#work' },
	{ idx: '02', label: 'Method', href: '#method' },
	{ idx: '03', label: 'Lab', href: '#lab' },
	{ idx: '04', label: 'Journal', href: '#journal' },
	{ idx: '05', label: 'Studio', href: '#studio' },
];
---

<header class="site-header" id="siteHeader">
	<div class="header-inner">
		<!-- brand-zone is its own flex item (not inline with nav) so a future sidebar
		     can reuse this same left column/edge padding without moving the logo -->
		<div class="brand-zone">
			<a href="/" class="brand" aria-label="Neulancers — home">
				<img src="/logo.png" alt="" class="brand-mark" width="30" height="27" />
				<span class="brand-word">Neulancers</span>
			</a>
		</div>

		<nav class="primary-nav" aria-label="Primary">
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href}>
							<span class="idx">{item.idx}</span>
							<span>{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="header-actions">
			<a href="#contact" class="cta-btn">Bring us a problem</a>

			<button
				class="menu-toggle"
				id="menuToggle"
				type="button"
				aria-expanded="false"
				aria-controls="mobileMenu"
				aria-label="Toggle menu"
			>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="mobileMenu">
		<nav aria-label="Mobile primary">
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href}>
							<span class="idx">{item.idx}</span>
							<span>{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="mobile-footer">
			<a href="#contact" class="cta-btn cta-btn--block">Bring us a problem</a>
			<a href="mailto:hello@neulancers.com" class="mobile-email">hello@neulancers.com</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		--ink: #f2f2f0;
		--ink-dim: rgba(242, 242, 240, 0.62);
		--ink-faint: rgba(242, 242, 240, 0.38);
		--bar-bg: #131316;
		--bar-border: rgba(255, 255, 255, 0.08);
		--pill: rgba(255, 255, 255, 0.07);
		--pill-hover: rgba(255, 255, 255, 0.12);
		--accent: #6d28d9;
		--accent-hover: #5b21b6;

		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		color: var(--ink);
		background-color: transparent;
		border-bottom: 1px solid transparent;
		box-shadow: none;
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			backdrop-filter 0.25s ease,
			box-shadow 0.25s ease;
	}

	/* solid, slightly separated state once the page has scrolled */
	.site-header.is-scrolled {
		background-color: rgba(19, 19, 22, 0.86);
		backdrop-filter: blur(12px) saturate(140%);
		-webkit-backdrop-filter: blur(12px) saturate(140%);
		border-bottom-color: var(--bar-border);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: 100%;
		max-width: 1320px;
		margin: 0 auto;
		padding: 0.9rem clamp(20px, 4vw, 32px);
	}

	.brand-zone {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--ink);
		flex-shrink: 0;
	}

	.brand-mark {
		display: block;
		width: 28px;
		height: 25px;
		object-fit: contain;
	}

	.brand-word {
		font-weight: 600;
		font-size: 0.98rem;
		letter-spacing: -0.01em;
	}

	/* ---------- primary nav ---------- */
	.primary-nav {
		flex: 1;
		display: flex;
		justify-content: center;
	}

	.primary-nav ul {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.2rem;
		margin: 0;
		padding: 0;
	}

	.primary-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.48rem 0.85rem;
		border-radius: 999px;
		color: var(--ink-dim);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 500;
	}

	.primary-nav a:hover,
	.primary-nav a:focus-visible {
		background: var(--pill);
		color: var(--ink);
	}

	.idx {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		color: var(--ink-faint);
	}

	/* ---------- actions ---------- */
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.58rem 1.15rem;
		background: linear-gradient(135deg, #9061f9, var(--accent) 65%);
		color: #ffffff;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
		white-space: nowrap;
		transition: filter 0.15s ease;
	}

	.cta-btn:hover,
	.cta-btn:focus-visible {
		filter: brightness(1.08);
	}

	/* ---------- mobile toggle ---------- */
	.menu-toggle {
		display: none;
		position: relative;
		width: 38px;
		height: 38px;
		border: none;
		border-radius: 999px;
		background: var(--pill);
		cursor: pointer;
		flex-shrink: 0;
	}

	.menu-toggle .bar {
		position: absolute;
		left: 11px;
		right: 11px;
		height: 2px;
		border-radius: 2px;
		background: var(--ink);
		transition: transform 0.25s ease, top 0.25s ease;
	}

	.menu-toggle .bar:nth-child(1) {
		top: 15px;
	}

	.menu-toggle .bar:nth-child(2) {
		top: 21px;
	}

	.menu-toggle[aria-expanded='true'] .bar:nth-child(1) {
		top: 18px;
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .bar:nth-child(2) {
		top: 18px;
		transform: rotate(-45deg);
	}

	/* ---------- mobile menu overlay ---------- */
	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 90;
		background: #0b0b0c;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 92px 24px 32px;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.2s ease, visibility 0s linear 0.2s;
	}

	.mobile-menu.is-open {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.2s ease;
	}

	.mobile-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.mobile-menu li + li {
		border-top: 1px solid var(--bar-border);
	}

	.mobile-menu a {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1.05rem 0.1rem;
		color: var(--ink);
		text-decoration: none;
		font-size: 1.4rem;
		font-weight: 600;
	}

	.mobile-footer {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.cta-btn--block {
		width: 100%;
		justify-content: center;
		padding: 0.85rem 1.1rem;
	}

	.mobile-email {
		color: var(--ink-dim);
		text-decoration: none;
		font-size: 0.88rem;
	}

	.mobile-email:hover {
		color: var(--ink);
	}

	/* ---------- responsive ---------- */
	@media (max-width: 860px) {
		.primary-nav {
			display: none;
		}

		.menu-toggle {
			display: block;
		}
	}

	@media (min-width: 861px) {
		.mobile-menu {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-btn,
		.menu-toggle .bar,
		.mobile-menu {
			transition: none;
		}
	}
</style>

<script>
	const header = document.getElementById('siteHeader');
	const toggle = document.getElementById('menuToggle');
	const mobileMenu = document.getElementById('mobileMenu');

	const setScrolled = () => {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	};

	setScrolled();
	window.addEventListener('scroll', setScrolled, { passive: true });

	const closeMenu = () => {
		toggle?.setAttribute('aria-expanded', 'false');
		mobileMenu?.classList.remove('is-open');
		document.body.style.overflow = '';
	};

	const openMenu = () => {
		toggle?.setAttribute('aria-expanded', 'true');
		mobileMenu?.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		isOpen ? closeMenu() : openMenu();
	});

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>
