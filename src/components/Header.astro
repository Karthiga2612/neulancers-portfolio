---
// `sections` lists every page section id that belongs to a nav item, so the
// scroll-spy can highlight the right item while the reader is in any of them.
const navItems = [
	{ label: 'What we do', href: '#what-we-do', sections: ['what-we-do'] },
	{ label: 'Work', href: '#work', sections: ['work'] },
	{ label: 'Method', href: '#method', sections: ['method'] },
	{ label: 'Lab', href: '#lab', sections: ['lab', 'ai', 'stack'] },
	{ label: 'Studio', href: '#people', sections: ['people', 'philosophy'] },
	{ label: 'Journal', href: '#journal', sections: ['journal'] },
];
---

<header class="site-header" id="siteHeader">
	<div class="header-inner">
		<!-- brand-zone is its own flex item (not inline with nav) so a future sidebar
		     can reuse this same left column/edge padding without moving the logo -->
		<div class="brand-zone">
			<a href="/" class="brand" aria-label="Neulancers — home">
				<img src="/logo.png" alt="" class="brand-mark" width="30" height="27" />
				<span class="brand-word">Neulancers</span>
			</a>
		</div>

		<nav class="primary-nav" aria-label="Primary">
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href} data-nav-sections={item.sections.join(' ')}>
							<span>{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="header-actions">
			<a href="#contact" class="cta-btn">Bring us a problem</a>

			<button
				class="menu-toggle"
				id="menuToggle"
				type="button"
				aria-expanded="false"
				aria-controls="mobileMenu"
				aria-label="Open menu"
			>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="mobileMenu">
		<nav aria-label="Mobile primary">
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href} data-nav-sections={item.sections.join(' ')}>
							<span>{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="mobile-footer">
			<a href="#contact" class="cta-btn cta-btn--block">Bring us a problem</a>
			<a href="mailto:hello@neulancers.com" class="mobile-email">hello@neulancers.com</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		--header-h: 4rem;
		--ink-dim: var(--muted);
		--accent-hover: #5b21b6;
		--accent-bright: #a78bfa;

		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		color: var(--ink);
		background-color: transparent;
		border-bottom: 1px solid transparent;
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease;
	}

	/* once the page has scrolled the bar becomes a plain surface with a
	   hairline — no blur, no shadow */
	.site-header.is-scrolled {
		background-color: var(--bg);
		border-bottom-color: var(--border-soft);
	}

	/* 1fr / auto / 1fr keeps the nav on the true centre line regardless of
	   how wide the brand and the CTA are */
	/* the bar sits above the full-screen menu so the brand and the toggle
	   (which turns into the close icon) stay visible while it is open */
	.header-inner {
		position: relative;
		z-index: 91;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		max-width: 1320px;
		height: var(--header-h);
		margin: 0 auto;
		padding: 0 clamp(20px, 4vw, 32px);
	}

	.brand-zone {
		display: flex;
		align-items: center;
		justify-self: start;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--ink);
	}

	.brand-mark {
		display: block;
		width: 28px;
		height: 25px;
		object-fit: contain;
	}

	.brand-word {
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: -0.02em;
	}

	/* ---------- primary nav ---------- */
	.primary-nav ul {
		list-style: none;
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 2.6vw, 2.25rem);
		margin: 0;
		padding: 0;
	}

	.primary-nav a {
		position: relative;
		display: inline-block;
		padding: 0.5rem 0;
		color: var(--ink-dim);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		transition: color 0.2s ease;
	}

	/* active/hover marker: a 1px rule under the label, not a filled chip */
	.primary-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.15rem;
		height: 1px;
		background: var(--accent-bright);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.primary-nav a:hover,
	.primary-nav a:focus-visible,
	.primary-nav a[aria-current='true'] {
		color: var(--ink);
	}

	.primary-nav a[aria-current='true']::after {
		transform: scaleX(1);
	}

	.primary-nav a:hover::after {
		transform: scaleX(1);
	}

	.site-header a:focus-visible,
	.site-header button:focus-visible {
		outline: 2px solid var(--accent-bright);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* ---------- actions ---------- */
	.header-actions {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 0.5rem;
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.6rem 1.2rem;
		background: var(--accent);
		color: #ffffff;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
		white-space: nowrap;
		transition: background-color 0.15s ease;
	}

	.cta-btn:hover,
	.cta-btn:focus-visible {
		background: var(--accent-hover);
	}

	.site-header .cta-btn:focus-visible {
		border-radius: 999px;
	}

	/* ---------- mobile toggle: 44px target, two bars, no fill ---------- */
	.menu-toggle {
		display: none;
		position: relative;
		width: 44px;
		height: 44px;
		margin-right: -10px;
		border: none;
		background: none;
		cursor: pointer;
		flex-shrink: 0;
	}

	.menu-toggle .bar {
		position: absolute;
		left: 11px;
		right: 11px;
		height: 1.5px;
		background: var(--ink);
		transition: transform 0.25s ease, top 0.25s ease;
	}

	.menu-toggle .bar:nth-child(1) {
		top: 17px;
	}

	.menu-toggle .bar:nth-child(2) {
		top: 26px;
	}

	.menu-toggle[aria-expanded='true'] .bar:nth-child(1) {
		top: 21.25px;
		transform: rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .bar:nth-child(2) {
		top: 21.25px;
		transform: rotate(-45deg);
	}

	/* ---------- mobile menu overlay ---------- */
	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 90;
		background: var(--bg);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: calc(var(--header-h) + 1.5rem) clamp(20px, 4vw, 32px) 2rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.2s ease, visibility 0s linear 0.2s;
	}

	.mobile-menu.is-open {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.2s ease;
	}

	.mobile-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border-soft);
	}

	.mobile-menu li {
		border-bottom: 1px solid var(--border-soft);
	}

	.mobile-menu a {
		display: flex;
		align-items: center;
		padding: 1.1rem 0;
		color: var(--ink);
		text-decoration: none;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.mobile-menu a[aria-current='true'] {
		color: var(--accent-bright);
	}

	.mobile-footer {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.cta-btn--block {
		width: 100%;
		justify-content: center;
		padding: 0.9rem 1.1rem;
		font-size: 0.95rem;
	}

	.mobile-email {
		color: var(--ink-dim);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.mobile-email:hover {
		color: var(--ink);
	}

	/* ---------- responsive ---------- */
	@media (max-width: 860px) {
		.header-inner {
			grid-template-columns: 1fr auto;
		}

		.primary-nav {
			display: none;
		}

		.menu-toggle {
			display: block;
		}
	}

	/* the open menu carries the same CTA in full width, so the bar itself
	   keeps only the brand and the toggle on phones */
	@media (max-width: 560px) {
		.header-actions .cta-btn {
			display: none;
		}
	}

	@media (min-width: 861px) {
		.mobile-menu {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.primary-nav a,
		.primary-nav a::after,
		.cta-btn,
		.menu-toggle .bar,
		.mobile-menu {
			transition: none;
		}
	}
</style>

<script>
	const header = document.getElementById('siteHeader');
	const toggle = document.getElementById('menuToggle');
	const mobileMenu = document.getElementById('mobileMenu');

	const setScrolled = () => {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	};

	// scroll-spy: the active nav item is the one owning the last section whose
	// top has crossed the reading line (35% down the viewport). Above the first
	// owned section (hero, problem wall) nothing is highlighted.
	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-sections]'));
	const spyTargets = navLinks.flatMap((link) =>
		(link.dataset.navSections ?? '')
			.split(' ')
			.map((id) => ({ id, el: document.getElementById(id) }))
			.filter((t): t is { id: string; el: HTMLElement } => t.el !== null),
	);

	const updateActive = () => {
		const line = window.innerHeight * 0.35;
		let activeId: string | null = null;
		let activeTop = -Infinity;
		for (const { id, el } of spyTargets) {
			const top = el.getBoundingClientRect().top;
			if (top <= line && top > activeTop) {
				activeTop = top;
				activeId = id;
			}
		}
		navLinks.forEach((link) => {
			const on = activeId !== null && (link.dataset.navSections ?? '').split(' ').includes(activeId);
			if (on) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		});
	};

	let ticking = false;
	const onScroll = () => {
		setScrolled();
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateActive();
			ticking = false;
		});
	};

	setScrolled();
	updateActive();
	window.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', updateActive);

	const closeMenu = () => {
		toggle?.setAttribute('aria-expanded', 'false');
		toggle?.setAttribute('aria-label', 'Open menu');
		mobileMenu?.classList.remove('is-open');
		document.body.style.overflow = '';
	};

	const openMenu = () => {
		toggle?.setAttribute('aria-expanded', 'true');
		toggle?.setAttribute('aria-label', 'Close menu');
		mobileMenu?.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		isOpen ? closeMenu() : openMenu();
	});

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>
