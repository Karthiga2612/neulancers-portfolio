---
const questions = [
	{
		title: 'Disappearing process',
		text: 'What if this entire process could disappear?',
	},
	{
		title: 'Manual work',
		text: 'Why does someone still do this manually?',
	},
	{
		title: 'Disconnected systems',
		text: 'Why are these five systems not talking to each other?',
	},
	{
		title: 'AI in action',
		text: 'Can an AI actually do this instead of just answering?',
	},
	{
		title: 'Rebuilt from scratch',
		text: 'What would happen if we rebuilt this from scratch?',
	},
	{
		title: 'A real product',
		text: 'Can this idea become a real product?',
	},
];
---

<section class="problem" id="problem">
	<div class="problem-inner">
		<div class="problem-header">
			<div class="header-heading-col">
				<div class="problem-eyebrow reveal" style="--reveal-order: 0">
					<span class="eyebrow-idx">03</span>
					<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
					<span class="eyebrow-label">The Problem Wall</span>
				</div>

				<h2 class="problem-heading reveal" style="--reveal-order: 1">Things We&rsquo;re Interested In</h2>
			</div>

			<div class="header-context-col">
				<p class="problem-desc reveal" style="--reveal-order: 2">
					Before we build anything, we sit with the questions most
					companies skip past.
				</p>
			</div>
		</div>

		<div class="problem-grid" id="problemGrid">
			{questions.map((q, i) => (
				<button
					type="button"
					class="problem-tile reveal"
					style={`--reveal-order: ${i + 4}`}
					data-index={i}
					aria-pressed="false"
				>
					<span class="tile-index">{`0${i + 1}`}</span>
					<span class="tile-title">{q.title}</span>
					<span class="tile-question">{q.text}</span>
					<span class="tile-divider" aria-hidden="true"></span>
					<span class="tile-explore">
						Explore
						<span class="explore-arrow" aria-hidden="true">&rarr;</span>
					</span>
				</button>
			))}
		</div>
	</div>
</section>

<script>
	const section = document.getElementById('problem');
	const grid = document.getElementById('problemGrid');
	const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.problem-tile'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let activeIndex = 0;
	let cycleTimer: ReturnType<typeof setInterval> | null = null;

	const render = () => {
		tiles.forEach((tile, i) => {
			const isActive = i === activeIndex;
			tile.classList.toggle('is-active', isActive);
			tile.setAttribute('aria-pressed', String(isActive));
		});
	};

	const activate = (index: number) => {
		if (index === activeIndex) return;
		activeIndex = index;
		render();
	};

	const stopCycle = () => {
		if (cycleTimer) {
			clearInterval(cycleTimer);
			cycleTimer = null;
		}
	};

	const startCycle = () => {
		if (reduceMotion || cycleTimer) return;
		cycleTimer = setInterval(() => {
			activate((activeIndex + 1) % tiles.length);
		}, 4200);
	};

	tiles.forEach((tile, i) => {
		tile.addEventListener('click', () => activate(i));
		tile.addEventListener('mouseenter', () => activate(i));
	});

	grid?.addEventListener('pointerenter', stopCycle);
	grid?.addEventListener('pointerleave', startCycle);
	grid?.addEventListener('focusin', stopCycle);
	grid?.addEventListener('focusout', (event) => {
		const next = (event as FocusEvent).relatedTarget as Node | null;
		if (!grid.contains(next)) startCycle();
	});

	render();

	if (section) {
		if (reduceMotion || !('IntersectionObserver' in window)) {
			section.classList.add('is-visible');
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							section.classList.add('is-visible');
							startCycle();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.15 },
			);
			observer.observe(section);
		}
	}
</script>

<style>
	.problem {
		--accent-bright: #a78bfa;
		--card-bg: #101319;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	.problem-inner {
		position: relative;
		z-index: 1;
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(56px, 8vw, 96px) clamp(20px, 4vw, 32px);
	}

	/* ---------- scroll-in reveal ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 60ms);
	}

	.problem.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	/* ---------- compact header ---------- */
	.problem-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: end;
		margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
		padding-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
		border-bottom: 1px solid var(--border-soft);
	}

	.problem-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.problem-heading {
		margin: 0;
		font-size: clamp(1.75rem, 1.8vw + 1.3rem, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.08;
	}

	.header-context-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.problem-desc {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}

	/* ---------- the 3x2 grid ---------- */
	.problem-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: clamp(1rem, 1.6vw, 1.35rem);
	}

	.problem-tile {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		min-height: clamp(200px, 19vw, 250px);
		padding: clamp(1.5rem, 2vw, 2rem);
		background: var(--card-bg);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.22);
		font: inherit;
		text-align: left;
		color: inherit;
		cursor: pointer;
		transition:
			border-color 0.3s ease,
			background 0.35s ease,
			box-shadow 0.35s ease,
			transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.problem-tile:hover:not(.is-active) {
		border-color: rgba(255, 255, 255, 0.18);
		background: #14171f;
	}

	.problem-tile:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* ---------- active: sophisticated purple gradient + glow ---------- */
	.problem-tile.is-active {
		border-color: rgba(167, 139, 250, 0.55);
		background: linear-gradient(150deg, rgba(139, 92, 246, 0.26), rgba(109, 40, 217, 0.1) 55%, rgba(16, 19, 25, 0.6));
		box-shadow:
			0 22px 46px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(109, 40, 217, 0.45),
			0 0 64px -16px rgba(139, 92, 246, 0.55);
		transform: translateY(-4px) scale(1.015);
	}

	.tile-index {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: rgba(167, 139, 250, 0.5);
		margin-bottom: 0.9rem;
		transition: color 0.3s ease;
	}

	.problem-tile.is-active .tile-index {
		color: #e9d8fd;
	}

	.tile-title {
		margin-bottom: 0.55rem;
		font-weight: 700;
		color: var(--ink);
		font-size: clamp(1.2rem, 0.9vw + 0.95rem, 1.45rem);
		transition: color 0.3s ease;
	}

	.problem-tile.is-active .tile-title {
		color: #ffffff;
	}

	.tile-question {
		flex: 1;
		font-size: 0.92rem;
		line-height: 1.55;
		color: rgba(243, 243, 241, 0.58);
		transition: color 0.3s ease;
	}

	.problem-tile.is-active .tile-question {
		color: rgba(243, 243, 241, 0.9);
	}

	.tile-divider {
		height: 1px;
		margin: 1rem 0 0.85rem;
		background: rgba(255, 255, 255, 0.12);
		transition: background-color 0.3s ease;
	}

	.problem-tile.is-active .tile-divider {
		background: rgba(167, 139, 250, 0.3);
	}

	.tile-explore {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-bright);
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.problem-tile:hover .tile-explore,
	.problem-tile.is-active .tile-explore {
		opacity: 1;
		transform: translateY(0);
	}

	.explore-arrow {
		transition: transform 0.3s ease;
	}

	.problem-tile:hover .explore-arrow {
		transform: translateX(3px);
	}

	/* ---------- responsive ---------- */
	@media (max-width: 980px) {
		.problem-header {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 1rem;
		}

		.problem-grid {
			grid-template-columns: repeat(2, 1fr);
			grid-template-rows: repeat(3, 1fr);
		}
	}

	@media (max-width: 620px) {
		.problem-grid {
			grid-template-columns: 1fr;
			grid-template-rows: none;
		}

		.problem-tile {
			min-height: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.problem-tile,
		.tile-index,
		.tile-title,
		.tile-question,
		.tile-divider,
		.tile-explore,
		.explore-arrow {
			transition: none;
		}

		.reveal {
			transition: none;
		}
	}
</style>

<noscript>
	<style>
		.problem .reveal {
			opacity: 1 !important;
			transform: none !important;
		}

		/* no JS means no click handling, so every "Explore" stays visible —
		   readable rather than permanently hidden */
		.problem .tile-explore {
			opacity: 1 !important;
			transform: none !important;
		}
	</style>
</noscript>
