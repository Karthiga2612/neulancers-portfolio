---
const questions = [
	{
		title: 'Disappearing process',
		text: 'What if this entire process could disappear?',
	},
	{
		title: 'Manual work',
		text: 'Why does someone still do this manually?',
	},
	{
		title: 'Disconnected systems',
		text: 'Why are these five systems not talking to each other?',
	},
	{
		title: 'AI in action',
		text: 'Can an AI actually do this instead of just answering?',
	},
	{
		title: 'Rebuilt from scratch',
		text: 'What would happen if we rebuilt this from scratch?',
	},
	{
		title: 'A real product',
		text: 'Can this idea become a real product?',
	},
];
---

<section class="problem" id="problem">
	<div class="glow glow-a" aria-hidden="true"></div>
	<div class="glow glow-b" aria-hidden="true"></div>

	<div class="problem-inner">
		<div class="problem-left">
			<div class="problem-eyebrow">
				<span class="eyebrow-idx">02</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The Problem Wall</span>
			</div>

			<span class="problem-pill">Problem</span>

			<h2 class="problem-heading">Things We&rsquo;re<br />Interested In</h2>

			<p class="problem-desc">
				Not a services pitch. Before we build anything, we sit with the questions most
				companies skip past.
			</p>

			<p class="problem-quote" id="problemQuote" aria-live="polite">
				<span class="quote-default">&ldquo;These guys understand how I think.&rdquo;</span>
			</p>
		</div>

		<div class="problem-right">
			<ul class="card-stack">
				{questions.map((q, i) => (
					<li class="card-item" style={i % 2 === 1 ? 'transform: translateX(28px);' : undefined}>
						<button
							type="button"
							class="problem-card"
							data-index={i}
							data-text={q.text}
							aria-pressed="false"
						>
							<span class="card-badge">{`0${i + 1}`}</span>
							<span class="card-body">
								<span class="card-title">{q.title}</span>
								<span class="card-divider" aria-hidden="true"></span>
								<span class="card-text">{q.text}</span>
							</span>
						</button>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<script>
	const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.problem-card'));
	const quoteEl = document.getElementById('problemQuote');
	const defaultQuoteHTML = quoteEl?.innerHTML ?? '';

	let activeCard: HTMLButtonElement | null = null;

	const setQuote = (card: HTMLButtonElement | null) => {
		if (!quoteEl) return;
		if (!card) {
			quoteEl.innerHTML = defaultQuoteHTML;
			quoteEl.classList.remove('is-active');
			return;
		}
		quoteEl.innerHTML = `<span class="quote-prompt">&gt;</span> logged: &ldquo;${card.dataset.text}&rdquo;`;
		quoteEl.classList.add('is-active');
	};

	cards.forEach((card) => {
		card.addEventListener('click', () => {
			const alreadyActive = card === activeCard;

			cards.forEach((c) => {
				c.classList.remove('is-active');
				c.setAttribute('aria-pressed', 'false');
			});

			if (alreadyActive) {
				activeCard = null;
				setQuote(null);
				return;
			}

			card.classList.add('is-active');
			card.setAttribute('aria-pressed', 'true');
			activeCard = card;
			setQuote(card);
		});
	});
</script>

<style>
	.problem {
		--ink: #f3f3f1;
		--muted: #8b929d;
		--ink-faint: rgba(139, 146, 157, 0.75);
		--border-soft: rgba(255, 255, 255, 0.1);
		--accent: #6d28d9;
		--accent-soft: rgba(109, 40, 217, 0.16);
		--bg: #0a0a0d;
		--card-bg: #0d1018;

		position: relative;
		overflow: hidden;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	.glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(90px);
		pointer-events: none;
		z-index: 0;
	}

	.glow-a {
		top: -120px;
		right: 8%;
		width: 420px;
		height: 420px;
		background: rgba(109, 40, 217, 0.28);
	}

	.glow-b {
		bottom: -160px;
		right: 24%;
		width: 340px;
		height: 340px;
		background: rgba(88, 28, 200, 0.18);
	}

	.problem-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(72px, 10vw, 128px) clamp(20px, 4vw, 32px);
	}

	/* ---------- left column ---------- */
	.problem-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.problem-pill {
		display: inline-block;
		margin-bottom: 1.25rem;
		padding: 0.35rem 0.9rem;
		background: var(--accent);
		color: #ffffff;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
	}

	.problem-heading {
		margin: 0 0 1.25rem;
		font-size: clamp(2rem, 2vw + 1.6rem, 3rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.problem-desc {
		margin: 0 0 1.75rem;
		max-width: 40ch;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.problem-quote {
		margin: 0;
		min-height: 1.3em;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85rem;
		color: var(--ink-faint);
		transition: color 0.2s ease;
	}

	.problem-quote.is-active {
		color: var(--ink);
	}

	.quote-prompt {
		color: var(--accent);
		font-weight: 600;
	}

	/* ---------- right column: card stack ---------- */
	.card-stack {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: clamp(0.9rem, 1.6vw, 1.25rem);
	}

	.card-item {
		display: block;
	}

	.problem-card {
		position: relative;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1rem 1.4rem 1rem 2.4rem;
		background: var(--card-bg);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		box-shadow: 0 16px 34px rgba(0, 0, 0, 0.28);
		font: inherit;
		text-align: left;
		color: inherit;
		cursor: pointer;
		transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}

	.problem-card:hover {
		border-color: rgba(255, 255, 255, 0.18);
	}

	.problem-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.problem-card.is-active {
		border-color: var(--accent);
		background: rgba(109, 40, 217, 0.14);
		box-shadow: 0 16px 34px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(109, 40, 217, 0.4);
	}

	.problem-card.is-active .card-badge {
		background: #ffffff;
		color: var(--accent);
	}

	.card-badge {
		position: absolute;
		left: -18px;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		flex-shrink: 0;
		background: var(--accent);
		color: #ffffff;
		border-radius: 50%;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		box-shadow: 0 6px 16px rgba(109, 40, 217, 0.45);
	}

	.card-body {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
	}

	.card-title {
		flex: 0 0 auto;
		max-width: 12ch;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--ink);
	}

	.card-divider {
		flex-shrink: 0;
		align-self: stretch;
		width: 1px;
		background: rgba(255, 255, 255, 0.16);
	}

	.card-text {
		flex: 1;
		font-size: 0.86rem;
		line-height: 1.5;
		color: rgba(243, 243, 241, 0.72);
	}

	/* ---------- responsive ---------- */
	@media (max-width: 900px) {
		.problem-inner {
			grid-template-columns: 1fr;
		}

		.problem-desc {
			max-width: 60ch;
		}

		.card-item {
			transform: none !important;
		}
	}

	@media (max-width: 560px) {
		.card-body {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}

		.card-divider {
			display: none;
		}

		.card-title {
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.problem-card {
			transition: none;
		}
	}
</style>
