---
// Four ways of thinking. The roles open like an accordion, and each one draws its own little scene that you can play with.
// No pictures: every drawing is line art built in code, so it stays sharp and can react to the mouse.
const roles = [
	{ idx: 1, id: 'eng', title: 'Engineer', tag: 'Systems', desc: 'Turns ideas into systems.', color: '#60a5fa' },
	{ idx: 2, id: 'bld', title: 'Builder', tag: 'Prototypes', desc: 'Makes prototypes real.', color: '#fbbf24' },
	{ idx: 3, id: 'des', title: 'Designer', tag: 'Simplicity', desc: 'Makes complicated things feel simple.', color: '#f472b6' },
	{ idx: 4, id: 'res', title: 'Researcher', tag: 'Questions', desc: 'Asks inconvenient questions.', color: '#2dd4bf' },
];
---

<section class="people" id="people">
	<div class="people-glow" aria-hidden="true"><span class="glow" id="peopleGlow"></span></div>

	<div class="people-inner">
		<div class="people-head">
			<div class="people-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">09</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The People</span>
			</div>
			<h2 class="people-heading" id="peopleHeading">Small team. Big curiosity.</h2>
		</div>

		<div class="roles" id="roles">
			{roles.map((r, i) => (
				<button type="button" class="role" data-i={i} data-id={r.id} style={`--c: ${r.color}`} aria-expanded="false" aria-controls={`role-more-${r.id}`}>
					<span class="r-progress" aria-hidden="true"></span>
					<span class="r-mark" aria-hidden="true">{`0${r.idx}`}</span>
					<span class="r-fx" aria-hidden="true"></span>

					<span class="r-top">
						<span class="r-idx">{`0${r.idx}`}</span>
						<span class="r-plus" aria-hidden="true"><i></i><i></i></span>
					</span>

					<span class="r-more" id={`role-more-${r.id}`}>
						{r.id === 'eng' && (
							<svg class="glyph" viewBox="0 0 240 170" aria-hidden="true">
								<g class="g-lines">
									<path d="M40 120 L90 60" />
									<path d="M90 60 L150 90" />
									<path d="M150 90 L200 40" />
									<path d="M90 60 L110 130" />
									<path d="M110 130 L150 90" />
									<path d="M150 90 L205 130" />
								</g>
								<g class="g-nodes">
									<circle cx="40" cy="120" r="8" />
									<circle cx="90" cy="60" r="8" />
									<circle cx="150" cy="90" r="9" />
									<circle cx="200" cy="40" r="8" />
									<circle cx="110" cy="130" r="8" />
									<circle cx="205" cy="130" r="8" />
								</g>
							</svg>
						)}
						{r.id === 'bld' && (
							<svg class="glyph" viewBox="0 0 240 170" aria-hidden="true">
								<g class="g-fills">
									<rect class="b-fill" x="30" y="20" width="180" height="26" rx="6" />
									<rect class="b-fill" x="30" y="58" width="84" height="92" rx="8" />
									<rect class="b-fill" x="126" y="58" width="84" height="40" rx="8" />
									<rect class="b-fill" x="126" y="110" width="84" height="40" rx="8" />
								</g>
								<g class="g-wire">
									<rect x="30" y="20" width="180" height="26" rx="6" />
									<rect x="30" y="58" width="84" height="92" rx="8" />
									<rect x="126" y="58" width="84" height="40" rx="8" />
									<rect x="126" y="110" width="84" height="40" rx="8" />
								</g>
								<path class="g-cursor" d="M0 0 L0 17 L4.5 12.8 L7.6 20 L10.4 18.8 L7.3 11.8 L13 11.8 Z" />
							</svg>
						)}
						{r.id === 'des' && (
							<svg class="glyph" viewBox="0 0 240 170" aria-hidden="true">
								<path class="g-tangle" d="M20 85 C60 15, 100 160, 125 55 S170 140, 140 95 S90 25, 200 75 S235 120, 222 85" />
								<path class="g-line" d="M20 85 C80 85, 160 85, 222 85" />
								<circle class="g-dot" cx="20" cy="85" r="7" />
							</svg>
						)}
						{r.id === 'res' && (
							<svg class="glyph" viewBox="0 0 240 170" aria-hidden="true">
								<circle class="g-ring" cx="120" cy="142" r="6" />
								<circle class="g-ring" cx="120" cy="142" r="6" />
								<circle class="g-ring" cx="120" cy="142" r="6" />
								<path class="g-q" d="M88 62 C88 24 152 24 152 62 C152 90 120 92 120 118" />
								<circle class="g-qdot" cx="120" cy="142" r="6" />
							</svg>
						)}
						<span class="r-tag">{r.tag}</span>
						<span class="r-desc">{r.desc}</span>
					</span>

					<span class="r-title">{r.title}</span>
				</button>
			))}
		</div>

		<p class="people-footer" id="peopleFooter">
			We&rsquo;re not hiring job titles. We&rsquo;re looking for people who like figuring things out.
		</p>
	</div>
</section>

<style>
	.people {
		--accent-bright: #a78bfa;

		position: relative;
		overflow: clip;
		background: #050506;
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	/* a soft light behind the roles that drifts, and takes the colour of the one that is open */
	.people-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.glow {
		position: absolute;
		left: 24%;
		top: 38%;
		width: 52%;
		height: 46%;
		border-radius: 50%;
		background: #6d28d9;
		opacity: 0.07;
		filter: blur(110px);
		will-change: transform;
	}

	.people-inner {
		position: relative;
		z-index: 1;
		max-width: 1240px;
		margin: 0 auto;
		padding: clamp(56px, 8vw, 100px) clamp(20px, 4vw, 32px);
	}

	.reveal {
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.people.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	.people-head {
		text-align: center;
		margin-bottom: clamp(30px, 5vw, 52px);
	}

	.people-eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.people-heading {
		margin: 0;
		font-size: clamp(2rem, 1.8vw + 1.6rem, 2.9rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.15;
	}

	/* words the script splits text into; each heading word sits in a mask and rises into view */
	.people :global(.w) {
		display: inline-block;
	}

	.people :global(.mw) {
		display: inline-block;
		overflow: hidden;
		vertical-align: top;
		padding-bottom: 0.14em;
		margin-bottom: -0.14em;
	}

	/* ---------- the four roles ---------- */
	.roles {
		display: flex;
		gap: 14px;
	}

	.role {
		position: relative;
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		min-height: clamp(400px, 40vw, 470px);
		padding: clamp(1.2rem, 1.8vw, 1.7rem);
		text-align: left;
		color: inherit;
		font: inherit;
		background: linear-gradient(160deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015));
		border: 1px solid var(--border-soft);
		border-radius: 24px;
		box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06);
		overflow: hidden;
		cursor: pointer;
		transition: border-color 0.4s ease, box-shadow 0.4s ease;
	}

	/* a light follows the pointer across a role */
	.role::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--c) 7%, transparent), transparent 70%);
		opacity: var(--spot, 0);
		transition: opacity 0.35s ease;
		pointer-events: none;
	}

	/* a light runs round the edge of the open role */
	@property --ang {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}

	.role::after {
		content: '';
		position: absolute;
		inset: 0;
		padding: 1.5px;
		border-radius: inherit;
		background: conic-gradient(from var(--ang), transparent 0 60%, var(--c) 92%, transparent 100%);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
		opacity: 0;
		transition: opacity 0.5s ease;
		pointer-events: none;
	}

	.role.is-active::after {
		opacity: 1;
		animation: spin-edge 4.5s linear infinite;
	}

	@keyframes spin-edge {
		to {
			--ang: 360deg;
		}
	}

	.role:focus-visible {
		outline: 2px solid var(--accent-bright);
		outline-offset: 3px;
	}

	.role.is-active {
		border-color: transparent;
		background: linear-gradient(160deg, color-mix(in srgb, var(--c) 9%, rgba(255, 255, 255, 0.04)), rgba(255, 255, 255, 0.015));
	}

	/* a thin line along the top shows when the next role will open by itself */
	.r-progress {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 3;
		width: 100%;
		height: 3px;
		background: var(--c);
		transform: scaleX(0);
		transform-origin: left center;
		opacity: 0;
		pointer-events: none;
	}

	/* a big outlined number behind everything */
	.r-mark {
		position: absolute;
		right: -0.04em;
		bottom: -0.2em;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(6rem, 9vw, 9rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in srgb, var(--c) 22%, transparent);
		opacity: 0.32;
		transition: opacity 0.5s ease, -webkit-text-stroke-color 0.5s ease;
		pointer-events: none;
		user-select: none;
	}

	.role.is-active .r-mark {
		opacity: 0.9;
		-webkit-text-stroke-color: color-mix(in srgb, var(--c) 45%, transparent);
	}

	/* soft particles that drift up inside the open role */
	.r-fx {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.role :global(.r-spark) {
		position: absolute;
		border-radius: 50%;
		background: var(--c);
		opacity: 0;
	}

	.r-top {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.r-idx {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--c);
	}

	/* a plus that turns into a cross when the role is open */
	.r-plus {
		position: relative;
		width: 30px;
		height: 30px;
		border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
		border-radius: 50%;
		transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease;
	}

	.r-plus i {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 12px;
		height: 1.5px;
		margin: -0.75px 0 0 -6px;
		background: var(--c);
	}

	.r-plus i:last-child {
		transform: rotate(90deg);
	}

	.role.is-active .r-plus {
		transform: rotate(45deg);
		background: color-mix(in srgb, var(--c) 18%, transparent);
	}

	/* what appears when a role is open: its drawing, its keyword and its line */
	.r-more {
		position: relative;
		z-index: 2;
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 0.6rem;
		opacity: 0;
		pointer-events: none;
	}

	.role.is-active .r-more {
		pointer-events: auto;
	}

	.glyph {
		width: 100%;
		max-width: 380px;
		height: auto;
		margin-bottom: 0.9rem;
		fill: none;
		stroke: var(--c);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	.glyph circle,
	.glyph rect {
		transform-box: fill-box;
		transform-origin: center;
	}

	.g-nodes circle {
		fill: color-mix(in srgb, var(--c) 22%, #0a0a0d);
	}

	.b-fill {
		fill: color-mix(in srgb, var(--c) 20%, transparent);
		stroke: none;
	}

	.g-cursor {
		fill: #ffffff;
		stroke: #0a0a0d;
		stroke-width: 1.2;
		opacity: 0;
	}

	.g-qdot,
	.g-dot {
		fill: var(--c);
		stroke: none;
	}

	.g-ring {
		stroke-width: 1.6;
		opacity: 0;
	}

	.glyph :global(.g-pulse) {
		fill: #ffffff;
		stroke: none;
	}

	.r-tag {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--c);
	}

	.r-desc {
		max-width: 22ch;
		font-size: clamp(1.02rem, 0.5vw + 0.92rem, 1.2rem);
		font-weight: 500;
		line-height: 1.4;
		color: var(--ink);
	}

	.r-title {
		position: relative;
		z-index: 2;
		font-size: clamp(1.35rem, 1.2vw + 1rem, 1.8rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.role:not(.is-active) .r-title {
		color: var(--muted);
	}

	/* ---------- closing line ---------- */
	.people-footer {
		position: relative;
		max-width: 44ch;
		margin: clamp(30px, 4.5vw, 46px) auto 0;
		padding-top: 1.3rem;
		text-align: center;
		font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.25rem);
		font-weight: 500;
		line-height: 1.55;
		color: var(--ink-faint);
	}

	.people-footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: 40px;
		height: 1px;
		background: rgba(167, 139, 250, 0.5);
		transform: translateX(-50%);
	}

	/* ---------- narrow screens: the roles stack and open downwards ---------- */
	@media (max-width: 860px) {
		.roles {
			flex-direction: column;
		}

		.role {
			flex: none;
			min-height: 0;
			gap: 0;
		}

		.r-top {
			position: absolute;
			left: 1.2rem;
			right: 1.2rem;
			top: 1.2rem;
		}

		.r-title {
			order: 2;
			padding: 1.9rem 0 0.1rem;
		}

		.r-more {
			order: 3;
			flex: none;
			height: 0;
			overflow: hidden;
			justify-content: flex-start;
		}

		.glyph {
			max-width: 270px;
			margin-top: 0.4rem;
		}

		.r-mark {
			font-size: 6rem;
			opacity: 0.22;
		}

		.role.is-active .r-mark {
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.role,
		.role::before,
		.role::after,
		.r-plus,
		.r-mark {
			transition: none;
		}

		.role.is-active::after {
			animation: none;
		}
	}
</style>

<noscript>
	<style>
		.people .reveal {
			opacity: 1 !important;
			transform: none !important;
		}

		.people .r-more {
			height: auto !important;
			opacity: 1 !important;
		}
	</style>
</noscript>

<script>
	import { gsap } from 'gsap';
	import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
	import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';

	gsap.registerPlugin(DrawSVGPlugin, MorphSVGPlugin);

	const section = document.getElementById('people');
	if (section) init(section);

	function init(section: HTMLElement) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const canObserve = 'IntersectionObserver' in window;
		const animated = !reduce && canObserve;
		const wide = window.matchMedia('(min-width: 861px)');
		const NS = 'http://www.w3.org/2000/svg';
		const TOUR = 5;

		const roleEls = Array.from(section.querySelectorAll<HTMLElement>('.role'));
		const mores = roleEls.map((r) => r.querySelector<HTMLElement>('.r-more')!);
		const glyphs = roleEls.map((r) => r.querySelector<SVGSVGElement>('.glyph')!);
		const bars = roleEls.map((r) => r.querySelector<HTMLElement>('.r-progress')!);
		const fxBoxes = roleEls.map((r) => r.querySelector<HTMLElement>('.r-fx')!);
		const glow = section.querySelector<HTMLElement>('#peopleGlow')!;
		const heading = section.querySelector<HTMLElement>('#peopleHeading')!;
		const footer = section.querySelector<HTMLElement>('#peopleFooter')!;
		const colors = roleEls.map((r) => r.style.getPropertyValue('--c').trim());

		let active = -1;
		let touched = false;
		let tourCall: gsap.core.Tween | null = null;
		let current: { tl: gsap.core.Timeline; off: () => void } | null = null;
		let sparks: HTMLElement[] = [];
		let descWords: HTMLElement[][] = [];

		// ---------- words that rise (headings) and fade up (the closing line) ----------
		const words = (el: HTMLElement, mask: boolean) => {
			const parts = (el.textContent ?? '').split(/\s+/).filter(Boolean);
			el.textContent = '';
			return parts.map((word, k) => {
				const sp = document.createElement('span');
				sp.className = 'w';
				sp.textContent = word;
				if (mask) {
					const wrap = document.createElement('span');
					wrap.className = 'mw';
					wrap.appendChild(sp);
					el.appendChild(wrap);
				} else el.appendChild(sp);
				if (k < parts.length - 1) el.appendChild(document.createTextNode(' '));
				return sp;
			});
		};

		// where a mouse is, in the drawing's own coordinates
		const svgPoint = (svg: SVGSVGElement, e: PointerEvent) => {
			const r = svg.getBoundingClientRect();
			const vb = svg.viewBox.baseVal;
			return { x: ((e.clientX - r.left) * vb.width) / r.width, y: ((e.clientY - r.top) * vb.height) / r.height };
		};

		// ---------- each role's drawing, and how it reacts to the mouse ----------
		const scene = (i: number): { tl: gsap.core.Timeline; off: () => void } => {
			const el = roleEls[i];
			const svg = glyphs[i];
			const q = (sel: string) => Array.from(el.querySelectorAll<SVGElement>(sel));
			const tl = gsap.timeline();
			const extras: Array<{ kill: () => void }> = [];
			const made: Element[] = [];
			const offs: Array<() => void> = [];
			const on = (type: string, fn: (e: PointerEvent) => void) => {
				el.addEventListener(type, fn as EventListener);
				offs.push(() => el.removeEventListener(type, fn as EventListener));
			};
			const mouse = (fn: (e: PointerEvent) => void) => (e: PointerEvent) => e.pointerType === 'mouse' && fn(e);

			if (i === 0) {
				// ideas become a system: nodes appear, lines connect them, signals travel, and the network leans towards you
				const lineEls = q('.g-lines path') as SVGPathElement[];
				const nodeEls = q('.g-nodes circle') as SVGCircleElement[];
				const pts = nodeEls.map((c) => ({ x: Number(c.getAttribute('cx')), y: Number(c.getAttribute('cy')), ox: 0, oy: 0 }));
				const links: Array<[number, number]> = [
					[0, 1],
					[1, 2],
					[2, 3],
					[1, 4],
					[4, 2],
					[2, 5],
				];
				const redraw = () => {
					links.forEach(([a, b], k) => {
						lineEls[k].setAttribute('d', `M${pts[a].x + pts[a].ox} ${pts[a].y + pts[a].oy} L${pts[b].x + pts[b].ox} ${pts[b].y + pts[b].oy}`);
					});
					nodeEls.forEach((c, n) => {
						c.setAttribute('cx', String(pts[n].x + pts[n].ox));
						c.setAttribute('cy', String(pts[n].y + pts[n].oy));
					});
				};
				redraw();
				tl.fromTo(nodeEls, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: 'back.out(3)', stagger: 0.07 }, 0.1);
				tl.fromTo(lineEls, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.6, ease: 'power2.inOut', stagger: 0.09, onComplete: () => gsap.set(lineEls, { clearProps: 'strokeDasharray,strokeDashoffset' }) }, 0.35);
				tl.to(nodeEls, { scale: 1.16, duration: 1.2, ease: 'sine.inOut', yoyo: true, repeat: -1, stagger: { each: 0.2, repeat: -1, yoyo: true } }, 1.4);

				// signals travelling along the lines
				for (let k = 0; k < 3; k++) {
					const dot = document.createElementNS(NS, 'circle');
					dot.setAttribute('class', 'g-pulse');
					dot.setAttribute('r', '4');
					dot.setAttribute('opacity', '0');
					svg.appendChild(dot);
					made.push(dot);
					const t = { v: 0, link: k * 2 };
					const tween = gsap.fromTo(
						t,
						{ v: 0 },
						{
							v: 1,
							duration: 1.1,
							ease: 'power1.inOut',
							repeat: -1,
							repeatDelay: 0.5,
							delay: 1.6 + k * 0.55,
							onRepeat: () => {
								t.link = Math.floor(Math.random() * links.length);
								if (Math.random() > 0.5) t.v = 0;
							},
							onStart: () => dot.setAttribute('opacity', '1'),
							onUpdate: () => {
								const [a, b] = links[t.link];
								const pa = pts[a];
								const pb = pts[b];
								dot.setAttribute('cx', String(pa.x + pa.ox + (pb.x + pb.ox - pa.x - pa.ox) * t.v));
								dot.setAttribute('cy', String(pa.y + pa.oy + (pb.y + pb.oy - pa.y - pa.oy) * t.v));
							},
						},
					);
					extras.push(tween);
				}

				// the network leans towards the pointer
				const lean = pts.map((p) => ({
					x: gsap.quickTo(p, 'ox', { duration: 0.6, ease: 'power3.out', onUpdate: redraw }),
					y: gsap.quickTo(p, 'oy', { duration: 0.6, ease: 'power3.out', onUpdate: redraw }),
				}));
				on(
					'pointermove',
					mouse((e) => {
						const m = svgPoint(svg, e);
						pts.forEach((p, n) => {
							lean[n].x(Math.max(-16, Math.min(16, (m.x - p.x) * 0.14)));
							lean[n].y(Math.max(-16, Math.min(16, (m.y - p.y) * 0.14)));
						});
					}),
				);
				on('pointerleave', () => lean.forEach((l) => (l.x(0), l.y(0))));
			} else if (i === 1) {
				// a wireframe is drawn, then it fills in and becomes real; a cursor then clicks through it
				const wire = q('.g-wire rect');
				const fills = q('.b-fill');
				const cursor = q('.g-cursor')[0];
				tl.fromTo(wire, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.7, ease: 'power2.inOut', stagger: 0.12 }, 0.1);
				tl.fromTo(fills, { opacity: 0, y: -14 }, { opacity: 1, y: 0, duration: 0.5, ease: 'back.out(2)', stagger: 0.12 }, 0.9);
				tl.fromTo(wire, { opacity: 1 }, { opacity: 0.55, duration: 0.5 }, 1.3);

				const targets = [
					{ x: 168, y: 78, f: 2 },
					{ x: 72, y: 104, f: 1 },
					{ x: 168, y: 130, f: 3 },
					{ x: 120, y: 33, f: 0 },
				];
				const click = gsap.timeline({ repeat: -1, repeatDelay: 0.8, delay: 2.2 });
				click.set(cursor, { x: 232, y: 168, opacity: 0, scale: 1 });
				click.to(cursor, { opacity: 1, duration: 0.2 });
				targets.forEach((t) => {
					click.to(cursor, { x: t.x, y: t.y, duration: 0.7, ease: 'power2.inOut' });
					click.to(cursor, { scale: 0.8, duration: 0.1, yoyo: true, repeat: 1, transformOrigin: '0 0' });
					click.fromTo(fills[t.f], { opacity: 0.55, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.55, ease: 'back.out(3)' }, '<0.05');
				});
				click.to(cursor, { opacity: 0, duration: 0.3 });
				extras.push(click);
			} else if (i === 2) {
				// a tangle is drawn, then it straightens out into one clean line, which you can pluck like a string
				const tangle = q('.g-tangle')[0];
				const line = q('.g-line')[0];
				const dot = q('.g-dot')[0];
				const original = tangle.dataset.original ?? (tangle.dataset.original = tangle.getAttribute('d') ?? '');
				gsap.set(line, { opacity: 0 });
				gsap.set(tangle, { attr: { d: original } });
				let ready = false;
				const str = { bend: 0 };
				const setString = () => tangle.setAttribute('d', `M20 85 Q121 ${85 + str.bend} 222 85`);
				tl.fromTo(tangle, { drawSVG: '0%' }, { drawSVG: '100%', duration: 1, ease: 'power2.inOut' }, 0.1);
				tl.to(tangle, { morphSVG: line, duration: 0.9, ease: 'power3.inOut' }, 1.3);
				tl.fromTo(dot, { opacity: 0, x: 0 }, { opacity: 1, x: 0, duration: 0.2 }, 2.1);
				tl.to(dot, { x: 202, duration: 0.9, ease: 'power2.inOut' }, 2.2);
				tl.to(dot, { scale: 1.5, duration: 0.3, yoyo: true, repeat: 1, ease: 'power2.out' }, 3.1);
				tl.add(() => {
					ready = true;
					gsap.set(tangle, { clearProps: 'strokeDasharray,strokeDashoffset' });
					str.bend = 0;
					setString();
				}, 3.2);
				const bend = gsap.quickTo(str, 'bend', { duration: 0.35, ease: 'power3.out', onUpdate: setString });
				on(
					'pointermove',
					mouse((e) => {
						if (!ready) return;
						const m = svgPoint(svg, e);
						bend(Math.max(-110, Math.min(110, (m.y - 85) * 2)));
					}),
				);
				on('pointerleave', () => {
					if (!ready) return;
					extras.push(gsap.to(str, { bend: 0, duration: 1.4, ease: 'elastic.out(1, 0.28)', onUpdate: setString, overwrite: true }));
				});
			} else {
				// a question mark is drawn and its dot sends out ripples, and so does a click or a touch
				const mark = q('.g-q')[0];
				const dot = q('.g-qdot')[0];
				const rings = q('.g-ring');
				tl.fromTo(mark, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.9, ease: 'power2.inOut' }, 0.1);
				tl.fromTo(dot, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.4, ease: 'back.out(3)' }, 0.85);
				rings.forEach((ring, k) => {
					tl.fromTo(ring, { attr: { r: 6 }, opacity: 0.9 }, { attr: { r: 50 }, opacity: 0, duration: 1.8, ease: 'power2.out', repeat: -1, repeatDelay: 0.4 }, 1.2 + k * 0.7);
				});
				const ripple = (x: number, y: number) => {
					const c = document.createElementNS(NS, 'circle');
					c.setAttribute('cx', String(x));
					c.setAttribute('cy', String(y));
					c.setAttribute('class', 'g-ring');
					svg.appendChild(c);
					made.push(c);
					gsap.fromTo(c, { attr: { r: 3 }, opacity: 0.9 }, { attr: { r: 44 }, opacity: 0, duration: 1.2, ease: 'power2.out', onComplete: () => c.remove() });
				};
				let last = 0;
				on(
					'pointermove',
					mouse((e) => {
						const now = performance.now();
						if (now - last < 260) return;
						last = now;
						const m = svgPoint(svg, e);
						ripple(m.x, m.y);
					}),
				);
				on('pointerdown', (e) => {
					const m = svgPoint(svg, e);
					ripple(m.x, m.y);
				});
			}

			return {
				tl,
				off: () => {
					offs.forEach((f) => f());
					extras.forEach((x) => x.kill());
					made.forEach((m) => m.remove());
				},
			};
		};

		// ---------- soft particles that drift up inside the open role ----------
		const spawnSparks = (i: number) => {
			sparks.forEach((s) => {
				gsap.killTweensOf(s);
				s.remove();
			});
			sparks = [];
			if (i < 0 || !animated) return;
			for (let k = 0; k < 10; k++) {
				const s = document.createElement('span');
				s.className = 'r-spark';
				const size = gsap.utils.random(2.5, 5.5);
				s.style.width = s.style.height = `${size}px`;
				s.style.left = `${gsap.utils.random(4, 96)}%`;
				s.style.top = `${gsap.utils.random(40, 98)}%`;
				fxBoxes[i].appendChild(s);
				sparks.push(s);
				gsap.fromTo(
					s,
					{ y: 0, opacity: 0 },
					{ y: -gsap.utils.random(60, 150), x: gsap.utils.random(-18, 18), opacity: gsap.utils.random(0.25, 0.55), duration: gsap.utils.random(2.6, 5), ease: 'sine.inOut', yoyo: true, repeat: -1, repeatRefresh: false, delay: gsap.utils.random(0, 2.5) },
				);
			}
		};

		// ---------- opening one role ----------
		const layout = (i: number, instant: boolean) => {
			const d = instant || !animated ? 0 : 0.7;
			roleEls.forEach((r, k) => {
				const on = k === i;
				if (wide.matches) {
					gsap.set(mores[k], { clearProps: 'height' });
					gsap.to(r, { flexGrow: on ? 3.2 : 1, duration: d, ease: 'power3.inOut', overwrite: 'auto' });
					gsap.to(mores[k], { opacity: on ? 1 : 0, y: on ? 0 : 14, duration: on ? (instant ? 0 : 0.5) : instant ? 0 : 0.2, delay: on && !instant ? 0.3 : 0, overwrite: 'auto' });
				} else {
					gsap.set(r, { clearProps: 'flexGrow' });
					gsap.to(mores[k], { height: on ? 'auto' : 0, opacity: on ? 1 : 0, y: 0, duration: d ? 0.55 : 0, ease: 'power3.inOut', overwrite: 'auto' });
				}
			});
		};

		const setActive = (i: number, instant = false) => {
			if (active === i) return;
			active = i;
			roleEls.forEach((r, k) => {
				r.classList.toggle('is-active', k === i);
				r.setAttribute('aria-expanded', String(k === i));
			});
			layout(i, instant);
			gsap.to(glow, { backgroundColor: i >= 0 ? colors[i] : '#6d28d9', opacity: i >= 0 ? 0.11 : 0.07, duration: animated ? 0.8 : 0, overwrite: 'auto' });
			current?.tl.kill();
			current?.off();
			current = null;
			if (i >= 0 && animated) current = scene(i);
			spawnSparks(i);
			// the keyword slides in and the line rises word by word
			if (i >= 0 && animated && descWords[i]) {
				gsap.fromTo(roleEls[i].querySelector('.r-tag'), { x: -16, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: 'power3.out', delay: 0.35, overwrite: 'auto' });
				gsap.fromTo(descWords[i], { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: 'power3.out', stagger: 0.055, delay: 0.45, overwrite: 'auto' });
			}
		};

		wide.addEventListener('change', () => layout(active, true));

		// ---------- the tour: the roles take turns until the visitor touches them ----------
		const showProgress = (i: number) => {
			bars.forEach((b, k) => {
				gsap.killTweensOf(b);
				if (k === i) gsap.fromTo(b, { scaleX: 0, opacity: 1 }, { scaleX: 1, duration: TOUR, ease: 'none' });
				else gsap.set(b, { opacity: 0, scaleX: 0 });
			});
		};
		const tourStep = () => {
			if (touched) return;
			const next = (active + 1) % roleEls.length;
			setActive(next);
			showProgress(next);
			tourCall = gsap.delayedCall(TOUR, tourStep);
		};
		const stopTour = () => {
			touched = true;
			tourCall?.kill();
			tourCall = null;
			bars.forEach((b) => {
				gsap.killTweensOf(b);
				gsap.to(b, { opacity: 0, duration: 0.3 });
			});
		};

		// ---------- interaction: hover or focus opens, tap toggles, arrow keys move between roles ----------
		roleEls.forEach((r, i) => {
			r.addEventListener('pointerenter', (e) => {
				if (e.pointerType !== 'mouse' || !wide.matches) return;
				stopTour();
				setActive(i);
			});
			r.addEventListener('focus', () => {
				stopTour();
				setActive(i);
			});
			r.addEventListener('click', () => {
				stopTour();
				setActive(i);
			});
			r.addEventListener('keydown', (e) => {
				const next = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
				if (!next) return;
				e.preventDefault();
				roleEls[(i + next + roleEls.length) % roleEls.length].focus();
			});
		});

		// ---------- a light and a gentle tilt that follow the pointer ----------
		if (animated) {
			roleEls.forEach((r, i) => {
				const rx = gsap.quickTo(r, 'rotationX', { duration: 0.7, ease: 'power3.out' });
				const ry = gsap.quickTo(r, 'rotationY', { duration: 0.7, ease: 'power3.out' });
				const gx = gsap.quickTo(glyphs[i], 'x', { duration: 0.8, ease: 'power3.out' });
				const gy = gsap.quickTo(glyphs[i], 'y', { duration: 0.8, ease: 'power3.out' });
				let perspective = false;
				r.addEventListener('pointermove', (e) => {
					if (e.pointerType !== 'mouse') return;
					const b = r.getBoundingClientRect();
					const px = (e.clientX - b.left) / b.width;
					const py = (e.clientY - b.top) / b.height;
					r.style.setProperty('--mx', `${e.clientX - b.left}px`);
					r.style.setProperty('--my', `${e.clientY - b.top}px`);
					r.style.setProperty('--spot', '1');
					if (active !== i || !wide.matches) return;
					if (!perspective) {
						gsap.set(r, { transformPerspective: 1100 });
						perspective = true;
					}
					ry((px - 0.5) * 6);
					rx(-(py - 0.5) * 5);
					gx(-(px - 0.5) * 12);
					gy(-(py - 0.5) * 9);
				});
				r.addEventListener('pointerleave', () => {
					r.style.setProperty('--spot', '0');
					rx(0);
					ry(0);
					gx(0);
					gy(0);
				});
			});
		}

		// ---------- start ----------
		if (!animated) {
			section.classList.add('is-visible');
			setActive(0, true);
			return;
		}

		const headWords = words(heading, true);
		const footWords = words(footer, false);
		descWords = roleEls.map((r) => words(r.querySelector<HTMLElement>('.r-desc')!, false));
		gsap.set(headWords, { yPercent: 118, rotate: 5, transformOrigin: 'left bottom' });
		gsap.set(footWords, { opacity: 0, y: 10 });
		gsap.set(roleEls, { opacity: 0, y: 40, scale: 0.96 });
		// every role starts closed, with its drawing hidden
		layout(-1, true);
		// the light behind the roles drifts slowly
		gsap.to(glow, { x: 90, y: -30, duration: 9, ease: 'sine.inOut', yoyo: true, repeat: -1 });

		const once = (el: Element, threshold: number, run: () => void) => {
			const io = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						io.disconnect();
						run();
					}
				},
				{ threshold },
			);
			io.observe(el);
		};

		once(heading, 0.6, () => {
			section.classList.add('is-visible');
			gsap.to(headWords, { yPercent: 0, rotate: 0, duration: 0.95, ease: 'power4.out', stagger: 0.09 });
		});

		once(section.querySelector('#roles')!, 0.25, () => {
			section.classList.add('is-visible');
			gsap.to(roleEls, { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: 'power4.out', stagger: 0.1, clearProps: 'opacity,transform' });
			// the first one opens by itself, then they take turns
			gsap.delayedCall(1, () => {
				if (touched) return;
				setActive(0);
				showProgress(0);
				tourCall = gsap.delayedCall(TOUR, tourStep);
			});
		});

		once(footer, 0.8, () => {
			gsap.to(footWords, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.04 });
		});
	}
</script>
