---
// "We start from what's broken." A simple picture, told by scrolling: a chain of steps with a break in it, many tools around it that
// do not fix it, then a different route that bridges the gap, and the whole chain working.
const lines = [
	{ text: 'There are already thousands of tools.', tone: 'muted' },
	{ text: "We don't need another one.", tone: 'muted' },
	{ text: 'Unless it solves something differently.', tone: 'accent' },
	{ text: "That's where we come in.", tone: 'strong' },
];

// a typical piece of work, step by step (the break is between step 3 and step 4)
const steps = [
	{ label: 'Order', icon: ['M3 4h2l2 11h11l2-8H7', 'M10 20h.01', 'M17 20h.01'] },
	{ label: 'Check', icon: ['M11 4a7 7 0 100 14 7 7 0 000-14z', 'M16 16l5 5'] },
	{ label: 'Approve', icon: ['M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z', 'M9 12l2 2 4-4'] },
	{ label: 'Invoice', icon: ['M7 3h7l5 5v13H7z', 'M14 3v5h5', 'M10 13h6', 'M10 17h6'] },
	{ label: 'Report', icon: ['M5 20V10', 'M12 20V4', 'M19 20v-7'] },
];
---

<section class="philosophy" id="philosophy">
	<div class="stage" id="philoStage">
		<div class="stage-inner">
			<div class="philosophy-eyebrow reveal">
				<span class="eyebrow-idx">10</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The Internet Is Full of Software</span>
			</div>

			<!-- the picture: many tools around a chain of steps that has a break in it -->
			<div class="flow" id="philoFlow" aria-hidden="true">
				<div class="tools tools--top" id="toolsTop"></div>

				<div class="chain" id="philoChain">
					{steps.map((s, i) => (
						<>
							<div class="fnode" data-i={i}>
								<span class="fn-box">
									<svg viewBox="0 0 24 24">
										{s.icon.map((d) => (
											<path d={d} />
										))}
									</svg>
									<span class="fn-ok">&check;</span>
								</span>
								<span class="fn-label">{s.label}</span>
							</div>
							{i < steps.length - 1 && (
								i === 2 ? (
									<div class="fconn is-broken" id="philoBreak">
										<i class="fline fl-a"></i>
										<span class="warn">!</span>
										<i class="fline fl-b"></i>
										<span class="state">
											<span class="st-broken">Broken</span>
											<span class="st-fixed">Fixed</span>
										</span>
									</div>
								) : (
									<div class="fconn"><i class="fline"></i></div>
								)
							)}
						</>
					))}
					<span class="pulse"></span>
				</div>

				<div class="tools tools--bottom" id="toolsBottom"></div>

				<svg class="bridge" id="philoBridge"><path class="bridge-path"></path></svg>
			</div>

			<div class="philosophy-lines" id="philoLines">
				{lines.map((line) => (
					<p class={`philosophy-line tone-${line.tone}`}>{line.text}</p>
				))}
			</div>

			<p class="philosophy-footer" id="philoFooter">We start from what's broken, not from what's easy to ship.</p>
		</div>
	</div>
</section>

<style>
	.philosophy {
		--accent: #a78bfa;
		--broken: #f87171;
		--ok: #34d399;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	/* the part that stays put while you scroll through the story */
	.stage {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(40px, 6vh, 80px) clamp(20px, 4vw, 32px);
	}

	.stage-inner {
		width: 100%;
		max-width: 980px;
		text-align: center;
	}

	.reveal {
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.philosophy.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	.philosophy-eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: clamp(1.2rem, 3vh, 2rem);
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	/* ---------- the picture ---------- */
	.flow {
		--box: clamp(40px, 6.6vw, 68px);

		position: relative;
		margin: 0 auto clamp(1.4rem, 3.4vh, 2.4rem);
	}

	.tools {
		display: grid;
		gap: 6px;
	}

	.tools--top {
		margin-bottom: clamp(56px, 9vh, 84px);
	}

	.tools--bottom {
		margin-top: clamp(14px, 3vh, 26px);
	}

	.philosophy :global(.tool) {
		aspect-ratio: 4 / 3;
		position: relative;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 7px;
		background: rgba(255, 255, 255, 0.025);
	}

	.philosophy :global(.tool i) {
		position: absolute;
		left: 18%;
		height: 2px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.15);
	}

	.philosophy :global(.tool i:nth-child(1)) {
		top: 34%;
		width: 44%;
	}

	.philosophy :global(.tool i:nth-child(2)) {
		top: 52%;
		width: 28%;
	}

	/* the chain of steps */
	.chain {
		position: relative;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.fnode {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
		width: calc(var(--box) + 10px);
	}

	.fn-box {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--box);
		height: var(--box);
		border: 1.5px solid rgba(255, 255, 255, 0.22);
		border-radius: 16px;
		background: #101015;
	}

	.fn-box svg {
		width: 46%;
		height: 46%;
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.fn-ok {
		position: absolute;
		right: -7px;
		top: -7px;
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--ok);
		font-size: 0.7rem;
		font-weight: 700;
		color: #04241a;
		opacity: 0;
	}

	.fn-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(0.7rem, 0.4vw + 0.58rem, 0.78rem);
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	/* the links between steps */
	.fconn {
		position: relative;
		flex: 1;
		height: var(--box);
		margin: 0 4px;
		display: flex;
		align-items: center;
	}

	.fline {
		display: block;
		flex: 1;
		height: 2px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.3);
		transform-origin: left center;
	}

	/* the break: two short stubs with a gap and a warning between them */
	.fconn.is-broken {
		flex: 1.7;
		gap: 0;
	}

	.fconn.is-broken .fline {
		flex: 0 0 26%;
		background: var(--broken);
	}

	.fl-b {
		margin-left: auto;
		transform-origin: right center;
	}

	.warn {
		position: absolute;
		left: 50%;
		top: 50%;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		margin: -13px 0 0 -13px;
		border: 2px solid var(--broken);
		border-radius: 50%;
		background: #1a0e10;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.82rem;
		font-weight: 800;
		color: var(--broken);
	}

	/* "Broken" under the gap, which turns into "Fixed" */
	.state {
		position: absolute;
		left: 50%;
		top: calc(100% + 0.55rem);
		display: grid;
		transform: translateX(-50%);
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(0.6rem, 0.4vw + 0.52rem, 0.76rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.state span {
		grid-area: 1 / 1;
		text-align: center;
	}

	.st-broken {
		color: var(--broken);
	}

	.st-fixed {
		color: var(--ok);
		opacity: 0;
	}

	/* the dot that runs along the finished chain */
	.pulse {
		position: absolute;
		left: 0;
		top: calc(var(--box) / 2 - 6px);
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--ok);
		opacity: 0;
		pointer-events: none;
	}

	/* the different route over the gap */
	.bridge {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.bridge-path {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2.6;
		stroke-linecap: round;
	}

	/* ---------- the four-line statement ---------- */
	.philosophy-lines {
		display: flex;
		flex-direction: column;
		gap: 0.32em;
		margin-bottom: clamp(1.2rem, 3vh, 2rem);
	}

	.philosophy-line {
		margin: 0;
		font-size: clamp(1.3rem, 2.2vw + 0.9rem, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.2;
	}

	.philosophy :global(.w) {
		display: inline-block;
	}

	.tone-muted {
		color: var(--ink-faint);
		font-weight: 500;
	}

	.tone-accent {
		color: var(--accent);
	}

	.tone-strong {
		color: var(--ink);
	}

	.philosophy-footer {
		margin: 0;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--ink-faint);
	}

	@media (max-height: 720px) {
		.stage {
			padding-block: 28px;
		}

		.tools--bottom {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.fn-label {
			font-size: 0.66rem;
		}

		.fnode {
			width: calc(var(--box) + 4px);
		}

		.fconn {
			margin: 0 2px;
		}

		/* the gap is narrow here, so the label drops below the step names instead of between them */
		.state {
			top: calc(100% + 1.7rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			transition: none;
		}
	}
</style>

<noscript>
	<style>
		.philosophy .reveal {
			opacity: 1 !important;
			transform: none !important;
		}

		.philosophy .flow {
			display: none;
		}
	</style>
</noscript>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

	gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);

	const section = document.getElementById('philosophy');
	if (section) init(section);

	function init(section: HTMLElement) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const canObserve = 'IntersectionObserver' in window;

		const stage = section.querySelector<HTMLElement>('#philoStage')!;
		const flow = section.querySelector<HTMLElement>('#philoFlow')!;
		const chain = section.querySelector<HTMLElement>('#philoChain')!;
		const topRow = section.querySelector<HTMLElement>('#toolsTop')!;
		const bottomRow = section.querySelector<HTMLElement>('#toolsBottom')!;
		const svg = section.querySelector<SVGSVGElement>('#philoBridge')!;
		const bridge = svg.querySelector<SVGPathElement>('.bridge-path')!;
		const nodes = Array.from(section.querySelectorAll<HTMLElement>('.fnode'));
		const boxes = nodes.map((n) => n.querySelector<HTMLElement>('.fn-box')!);
		const oks = nodes.map((n) => n.querySelector<HTMLElement>('.fn-ok')!);
		const links = Array.from(section.querySelectorAll<HTMLElement>('.fconn:not(.is-broken) .fline'));
		const stubA = section.querySelector<HTMLElement>('.fl-a')!;
		const stubB = section.querySelector<HTMLElement>('.fl-b')!;
		const warn = section.querySelector<HTMLElement>('.warn')!;
		const stBroken = section.querySelector<HTMLElement>('.st-broken')!;
		const stFixed = section.querySelector<HTMLElement>('.st-fixed')!;
		const pulse = section.querySelector<HTMLElement>('.pulse')!;
		const lineEls = Array.from(section.querySelectorAll<HTMLElement>('.philosophy-line'));
		const footer = section.querySelector<HTMLElement>('#philoFooter')!;

		// split each line into words, so they can come in one at a time
		const wordsOf = lineEls.map((el) => {
			const parts = (el.textContent ?? '').split(/\s+/).filter(Boolean);
			el.textContent = '';
			return parts.map((word, k) => {
				const sp = document.createElement('span');
				sp.className = 'w';
				sp.textContent = word;
				el.appendChild(sp);
				if (k < parts.length - 1) el.appendChild(document.createTextNode(' '));
				return sp;
			});
		});

		let tl: gsap.core.Timeline | null = null;
		let st: ScrollTrigger | null = null;
		let builtFor = 0;

		// ---------- the tools around the chain: as many as fit the width ----------
		const buildTools = () => {
			const w = flow.clientWidth;
			const n = Math.max(8, Math.min(22, Math.floor(w / 52)));
			const tiles: HTMLElement[] = [];
			[topRow, bottomRow].forEach((row) => {
				row.innerHTML = '';
				row.style.gridTemplateColumns = `repeat(${n}, minmax(0, 1fr))`;
				for (let c = 0; c < n; c++) {
					const t = document.createElement('span');
					t.className = 'tool';
					t.innerHTML = '<i></i><i></i>';
					row.appendChild(t);
					tiles.push(t);
				}
			});
			return { tiles, n };
		};

		// ---------- the route over the gap, drawn from where the two steps really are ----------
		const placeBridge = () => {
			const f = flow.getBoundingClientRect();
			const a = boxes[2].getBoundingClientRect();
			const b = boxes[3].getBoundingClientRect();
			svg.setAttribute('viewBox', `0 0 ${f.width} ${f.height}`);
			const x1 = a.left + a.width / 2 - f.left;
			const x2 = b.left + b.width / 2 - f.left;
			const y = a.top - f.top - 2;
			const rise = Math.min(58, Math.max(34, (x2 - x1) * 0.28));
			bridge.setAttribute('d', `M${x1} ${y} C${x1} ${y - rise * 1.5}, ${x2} ${y - rise * 1.5}, ${x2} ${y}`);
		};

		const teardown = () => {
			st?.kill();
			tl?.kill();
			st = null;
			tl = null;
		};

		// ---------- the story, tied to the scroll ----------
		const build = () => {
			teardown();
			const { tiles } = buildTools();
			builtFor = window.innerWidth;
			placeBridge();
			const allWords = wordsOf.flat();

			// the starting picture: nothing there yet
			gsap.set(tiles, { opacity: 0, scale: 0.6, y: 10 });
			gsap.set(allWords, { opacity: 0.12, y: 12 });
			gsap.set(footer, { opacity: 0, y: 12 });
			gsap.set(nodes, { opacity: 0, y: 16 });
			gsap.set([links, stubA, stubB].flat(), { scaleX: 0 });
			gsap.set(warn, { scale: 0, opacity: 0 });
			gsap.set(stBroken, { opacity: 0 });
			gsap.set(stFixed, { opacity: 0 });
			gsap.set(bridge, { drawSVG: '0%' });
			gsap.set(pulse, { opacity: 0, x: 0 });
			gsap.set(oks, { scale: 0, opacity: 0 });
			gsap.set(boxes, { borderColor: 'rgba(255,255,255,0.22)' });

			tl = gsap.timeline({ defaults: { ease: 'power2.out' } });

			// 1 · thousands of tools, and a chain of steps that is broken in the middle
			tl.to(tiles, { opacity: 1, scale: 1, y: 0, duration: 0.6, stagger: { amount: 1.4, from: 'center' } }, 0);
			tl.to(wordsOf[0], { opacity: 1, y: 0, duration: 0.5, stagger: 0.14 }, 0.3);
			tl.to(nodes, { opacity: 1, y: 0, duration: 0.55, stagger: 0.18 }, 0.6);
			tl.to(links.slice(0, 2), { scaleX: 1, duration: 0.5, stagger: 0.2 }, 1.2);
			tl.to([stubA, stubB], { scaleX: 1, duration: 0.45 }, 1.5);
			tl.to(links.slice(2), { scaleX: 1, duration: 0.5 }, 1.6);
			tl.to(warn, { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(3)' }, 1.9);
			tl.to(stBroken, { opacity: 1, duration: 0.4 }, 2.1);
			tl.to([nodes[3], nodes[4]], { opacity: 0.45, duration: 0.5 }, 2.2);

			// 2 · we don't need another one: more tools do not fix it, so they fade away
			tl.to(wordsOf[1], { opacity: 1, y: 0, duration: 0.5, stagger: 0.14 }, 2.9);
			tl.to(warn, { x: 4, duration: 0.07, yoyo: true, repeat: 5, ease: 'none' }, 3.5);
			// three tools head for the break, one after another, and each one bounces off
			const half = tiles.length / 2;
			const mid = Math.floor(half / 2);
			const tries = [tiles[mid - 2], tiles[half + mid], tiles[mid + 2]];
			const toBreak = (el: HTMLElement) => {
				const w = warn.getBoundingClientRect();
				const t = el.getBoundingClientRect();
				return { dx: w.left + w.width / 2 - (t.left + t.width / 2), dy: w.top + w.height / 2 - (t.top + t.height / 2) };
			};
			tries.forEach((el, k) => {
				const at = 3.5 + k * 0.62;
				tl!.to(el, { x: () => toBreak(el).dx * 0.72, y: () => toBreak(el).dy * 0.72, scale: 1.25, duration: 0.5, ease: 'power2.in' }, at);
				tl!.to(el, { borderColor: '#f87171', duration: 0.08 }, at + 0.5);
				tl!.to(el, { x: 0, y: 0, scale: 1, rotation: k === 1 ? -9 : 9, duration: 0.6, ease: 'back.out(2.2)' }, at + 0.52);
				tl!.to(el, { borderColor: 'rgba(255,255,255,0.1)', rotation: 0, duration: 0.4 }, at + 1.1);
			});
			// then the tools fade away: more of them is not the answer
			tl.to(tiles, { opacity: 0.12, scale: 0.88, duration: 0.8, stagger: { amount: 0.9, from: 'random' } }, 5.4);

			// 3 · unless it solves something differently: a new route is drawn over the gap
			tl.to(wordsOf[2], { opacity: 1, y: 0, duration: 0.5, stagger: 0.12 }, 5.9);
			tl.to(bridge, { drawSVG: '100%', duration: 1.5, ease: 'power2.inOut' }, 6.2);
			tl.to([stubA, stubB], { opacity: 0.25, duration: 0.5 }, 7.4);
			tl.to(warn, { scale: 0, opacity: 0, duration: 0.4, ease: 'back.in(2)' }, 7.4);
			tl.to(stBroken, { opacity: 0, duration: 0.3 }, 7.4);
			tl.to(stFixed, { opacity: 1, duration: 0.4 }, 7.7);
			tl.to([nodes[3], nodes[4]], { opacity: 1, duration: 0.6 }, 7.5);

			// 4 · that's where we come in: everything flows again, step by step
			tl.to(wordsOf[3], { opacity: 1, y: 0, duration: 0.55, stagger: 0.14 }, 8.4);
			tl.to(pulse, { opacity: 1, duration: 0.2 }, 8.8);
			tl.to(pulse, { x: () => chain.offsetWidth - 12, duration: 1.7, ease: 'power1.inOut' }, 8.8);
			tl.to(pulse, { opacity: 0, duration: 0.3 }, 10.5);
			nodes.forEach((_, i) => {
				const at = 8.9 + (i / (nodes.length - 1)) * 1.5;
				tl!.to(boxes[i], { borderColor: '#34d399', duration: 0.3 }, at);
				tl!.to(oks[i], { scale: 1, opacity: 1, duration: 0.4, ease: 'back.out(3)' }, at);
			});
			tl.to([links, bridge].flat(), { backgroundColor: '#34d399', duration: 0.6 }, 9.8);
			tl.to(bridge, { stroke: '#34d399', duration: 0.6 }, 9.8);
			tl.to(footer, { opacity: 1, y: 0, duration: 0.6 }, 10.6);
			tl.to({}, { duration: 0.6 });

			st = ScrollTrigger.create({
				trigger: stage,
				start: 'top top',
				end: () => `+=${Math.round(window.innerHeight * 2.4)}`,
				pin: true,
				scrub: 0.8,
				anticipatePin: 1,
				invalidateOnRefresh: true,
				animation: tl,
				onRefresh: placeBridge,
			});
		};

		// the finished picture, for people who prefer less motion
		const still = () => {
			const { tiles } = buildTools();
			placeBridge();
			gsap.set(tiles, { opacity: 0.18 });
			gsap.set([stubA, stubB], { opacity: 0.25 });
			gsap.set(warn, { opacity: 0 });
			gsap.set(stBroken, { opacity: 0 });
			gsap.set(stFixed, { opacity: 1 });
			gsap.set(bridge, { stroke: '#34d399' });
			gsap.set(oks, { scale: 1, opacity: 1 });
			gsap.set(boxes, { borderColor: '#34d399' });
			gsap.set(links, { backgroundColor: '#34d399' });
			section.classList.add('is-visible');
		};

		if (reduce || !canObserve) {
			still();
			return;
		}

		// the eyebrow fades in as the section arrives
		const io = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					section.classList.add('is-visible');
					io.disconnect();
				}
			},
			{ threshold: 0.1 },
		);
		io.observe(section);

		build();

		// rebuild when the width really changes (turning a phone, resizing a window)
		let timer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(timer);
			timer = setTimeout(() => {
				if (Math.abs(window.innerWidth - builtFor) > 40) {
					build();
					ScrollTrigger.refresh();
				}
			}, 250);
		});
		if (document.fonts?.ready) document.fonts.ready.then(placeBridge);
	}
</script>
