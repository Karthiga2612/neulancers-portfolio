---
const stages = ['Thinking', 'Experimenting', 'Prototype', 'Building', 'Live'] as const;

const experiments = [
	{
		name: 'AI × Business',
		tagline: 'Where day-to-day decisions could just... happen.',
		stage: 2,
		log: 'We keep asking: which decisions in a business are actually just pattern-matching in a trench coat? Testing whether an agent can make the boring 80% of calls correctly, and only flag the ones that need a human.',
	},
	{
		name: 'AI × Search',
		tagline: 'Search that understands the question behind the question.',
		stage: 1,
		log: 'Most search returns documents. We want it to return answers — and the reasoning behind them. Still figuring out how much context is too much before it starts guessing.',
	},
	{
		name: 'AI × Operations',
		tagline: "Watching how work actually moves, not how it's supposed to.",
		stage: 0,
		log: "Before automating anything, we're just watching — screen recordings, shadowing, timing things with a stopwatch. Old-fashioned, but it's the only way to find the real bottleneck.",
	},
	{
		name: 'AI × Knowledge',
		tagline: 'What a company knows, made findable.',
		stage: 3,
		log: "Every company has tribal knowledge trapped in someone's head or a forgotten doc. Building a way to make it queryable without turning it into another wiki nobody updates.",
	},
	{
		name: 'Automation × WhatsApp',
		tagline: 'The most-used app becomes the least-used interface.',
		stage: 4,
		log: "For a lot of businesses, WhatsApp already is the interface. So instead of building an app nobody opens, we're teaching WhatsApp to do the app's job.",
	},
	{
		name: 'Data × Decision Making',
		tagline: 'Numbers that argue back before you commit.',
		stage: 0,
		log: 'Dashboards show you numbers. We want something that pushes back — "are you sure?" — before a bad call gets made, not after.',
	},
	{
		name: 'Software × Traditional Business',
		tagline: 'Old business, new nervous system.',
		stage: 1,
		log: "Can a business that's run on paper and phone calls for 20 years get a real nervous system without becoming unrecognizable to the people who built it?",
	},
].map((e, idx) => ({
	...e,
	idx,
	kicker: `Lab Notebook · 0${idx + 1}`,
}));

// ---------- extras for the index layout ----------
const pad = (n: number) => String(n).padStart(2, '0');
const total = experiments.length;
const stageCounts = stages.map((_, si) => experiments.filter((e) => e.stage === si).length);

// faint line drawings, one per experiment (400 x 240, strokes use currentColor)
const p = (d: string, x = '') => `<path data-d pathLength="1" d="${d}" ${x}/>`;
const r = (x: number, y: number, w: number, h: number, rx: number, ex = '') =>
	`<rect data-d pathLength="1" x="${x}" y="${y}" width="${w}" height="${h}" rx="${rx}" ${ex}/>`;
const c = (cx: number, cy: number, rad: number, ex = '') => `<circle data-d pathLength="1" cx="${cx}" cy="${cy}" r="${rad}" ${ex}/>`;

const arts = [
	// AI x Business: a decision that resolves itself
	[c(70, 120, 22), p('M92 120H150'), p('M150 120C170 120 170 70 200 70H250'), p('M150 120C170 120 170 170 200 170H250'), r(250, 50, 110, 40, 10), r(250, 150, 110, 40, 10, 'opacity=".5"'), p('M268 70l8 8 14-16')].join(''),
	// AI x Search: a question and the answer behind it
	[r(40, 40, 320, 46, 23), c(78, 63, 10), p('M86 71l10 10'), p('M120 63H280'), p('M60 120H340', 'opacity=".4"'), r(60, 140, 280, 44, 10), p('M78 162H250'), p('M78 150H150', 'opacity=".5"')].join(''),
	// AI x Operations: the work as it really moves
	[r(30, 90, 64, 56, 12), r(168, 90, 64, 56, 12), r(306, 90, 64, 56, 12), p('M94 118H168'), p('M232 118H306'), c(200, 46, 18), p('M200 36V46L208 52')].join(''),
	// AI x Knowledge: scattered notes pulled into one answer
	[r(30, 40, 70, 46, 8), r(30, 154, 70, 46, 8), r(130, 96, 70, 46, 8, 'opacity=".5"'), p('M100 63C140 63 150 100 190 110'), p('M100 177C140 177 150 140 190 130'), c(260, 120, 26), p('M286 120H350M330 106l16 14-16 14')].join(''),
	// Automation x WhatsApp: the chat is the app
	[r(30, 40, 190, 52, 20), p('M52 66H190'), r(180, 110, 190, 52, 20), p('M202 136H340'), r(30, 180, 130, 40, 18, 'opacity=".5"'), p('M52 200H130', 'opacity=".5"')].join(''),
	// Data x Decision Making: numbers that push back
	[p('M40 200H360'), r(60, 130, 36, 70, 4), r(120, 90, 36, 110, 4), r(180, 60, 36, 140, 4), r(240, 110, 36, 90, 4), r(290, 36, 80, 54, 14), p('M312 56h36M312 70h22')].join(''),
	// Software x Traditional Business: paper that grows a nervous system
	[r(30, 50, 110, 140, 8), p('M50 80H120M50 104H120M50 128H98'), p('M140 120H190'), c(220, 120, 8), c(290, 70, 8), c(290, 170, 8), c(350, 120, 8), p('M227 116L283 74M227 124L283 166M297 70L343 116M297 170L343 124')].join(''),
];


const rowsData = experiments;

const mail = (subject: string) => `mailto:hello@neulancers.com?subject=${encodeURIComponent(subject)}`;
---

<section class="lab" id="lab" aria-labelledby="lab-title">
	<div class="lab-inner">
		<div class="lab-head">
			<div class="lab-head-text">
				<div class="lab-eyebrow reveal" style="--reveal-order: 0">
					<span class="eyebrow-idx">06</span>
					<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
					<span class="eyebrow-label">The Lab</span>
				</div>
				<h2 class="lab-heading reveal" id="lab-title" style="--reveal-order: 1">N Lab</h2>
				<p class="lab-desc reveal" style="--reveal-order: 2">
					Some ideas are too early to become products. So we experiment with them.
				</p>
			</div>

			<div class="lab-stats reveal" style="--reveal-order: 3">
				<p class="stat-big" aria-label={`${total} experiments`}>
					<span class="stat-num" data-count={total}>{pad(total)}</span>
					<span class="stat-label">experiments on the bench</span>
				</p>
				<ul class="stat-row" aria-label="Experiments by stage">
					{stages.map((s, si) => (
						<li>
							<b data-count={stageCounts[si]}>{pad(stageCounts[si])}</b>
							<span>{s}</span>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="lab-main reveal" id="labMain" style="--reveal-order: 5">
			<div class="idx-col">
			<p class="idx-hint" id="labHint">
				<span class="hint-dot" aria-hidden="true"></span>
				<span id="labHintText">Playing on its own. Hover or tap any row to take over.</span>
			</p>
			<ol class="idx" aria-label="Experiments">
				{rowsData.map((e) => (
					<li class="item" data-index={e.idx}>
						<button type="button" class="row" data-index={e.idx} aria-controls="labSpec">
							<span class="row-n">{pad(e.idx + 1)}</span>
							<span class="row-name">{e.name}</span>
							<span class="row-tag">{e.tagline}</span>
							<span class="row-stage">{stages[e.stage]}</span>
							<span class="row-arrow" aria-hidden="true"></span>
							<span class="row-timer" aria-hidden="true"></span>
						</button>

						<!-- phones and tablets open the note right under the row -->
						<div class="row-detail">
							<div class="row-detail-in">
								<p class="rd-text">{e.log}</p>
								<ol class="track" aria-label={`Stage: ${stages[e.stage]}`}>
									{stages.map((s, i) => (
										<li class={i <= e.stage ? 'is-on' : ''}><i></i><span>{s}</span></li>
									))}
								</ol>
								<a class="spec-cta" href={mail(`About your lab experiment: ${e.name}`)}>
									Ask us about this one <span aria-hidden="true">&rarr;</span>
								</a>
							</div>
						</div>
					</li>
				))}
			</ol>
			</div>

			<div class="spec" id="labSpec">
				{rowsData.map((e) => (
					<article class="spec-item" data-index={e.idx}>
						<div class="spec-stage">
							<span class="spec-chip">{stages[e.stage]}</span>
							<svg class="spec-art" viewBox="0 0 400 240" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arts[e.idx]} />
						</div>
						<p class="spec-kicker">{e.kicker}</p>
						<h3 class="spec-title">{e.name}</h3>
						<p class="spec-text">{e.log}</p>
						<ol class="track" aria-label={`Stage: ${stages[e.stage]}`}>
							{stages.map((s, i) => (
								<li class={i <= e.stage ? 'is-on' : ''}><i></i><span>{s}</span></li>
							))}
						</ol>
						<a class="spec-cta" href={mail(`About your lab experiment: ${e.name}`)}>
							Ask us about this one <span aria-hidden="true">&rarr;</span>
						</a>
					</article>
				))}
			</div>
		</div>

		<p class="lab-footer reveal" style="--reveal-order: 6">
			Nothing here is finished, and that&rsquo;s the point.
		</p>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const root = document.getElementById('lab');
	const main = document.getElementById('labMain');

	if (root && main) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const wide = window.matchMedia('(min-width: 901px)');
		const rows = Array.from(main.querySelectorAll<HTMLButtonElement>('.row'));
		const items = Array.from(main.querySelectorAll<HTMLElement>('.item'));
		const specs = Array.from(main.querySelectorAll<HTMLElement>('.spec-item'));
		const spec = document.getElementById('labSpec')!;
		const CYCLE = rows.length;
		const pad = (n: number) => String(n).padStart(2, '0');

		let cur = -1;
		let interacted = false;
		let inside = false;
		let visible = false;
		let started = false;
		let tween: gsap.core.Tween | null = null;
		const hint = document.getElementById('labHint')!;
		const hintText = document.getElementById('labHintText')!;
		// nothing plays by itself with reduced motion, so the hint must not say it does
		if (reduce) {
			hint.classList.add('is-manual');
			hintText.textContent = 'Hover or tap any row to preview it.';
		}

		const drawIn = (el: HTMLElement) => {
			const strokes = el.querySelectorAll('[data-d]');
			const segs = el.querySelectorAll<HTMLElement>('.track li.is-on i');
			gsap.fromTo(strokes, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.9, stagger: 0.06, ease: 'power2.out' });
			gsap.fromTo(segs, { scaleX: 0 }, { scaleX: 1, duration: 0.5, stagger: 0.08, ease: 'power3.out', transformOrigin: 'left center' });
		};

		const show = (i: number, animate = true) => {
			const closing = i < 0;
			if (i === cur && !closing) {
				if (!wide.matches) return;
				return;
			}
			const prev = cur;
			cur = i;

			items.forEach((li, k) => li.classList.toggle('is-active', k === i));
			rows.forEach((b, k) => (k === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
			arm();

			if (!wide.matches) return; // the mobile accordion is pure CSS off is-active

			specs.forEach((s, k) => {
				if (k !== i && k !== prev) gsap.set(s, { autoAlpha: 0 });
			});
			if (closing) return;

			const next = specs[i];
			const old = prev >= 0 ? specs[prev] : null;
			gsap.killTweensOf([next, old]);

			if (!animate || reduce) {
				if (old) gsap.set(old, { autoAlpha: 0 });
				gsap.set(next, { autoAlpha: 1, y: 0 });
				return;
			}
			if (old) gsap.to(old, { autoAlpha: 0, y: -10, duration: 0.2, ease: 'power2.in' });
			gsap.fromTo(next, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.45, delay: old ? 0.12 : 0, ease: 'power3.out' });
			drawIn(next);
		};

		// ---------- the tour: advances on its own until the visitor takes over ----------
		// each active row fills a thin bar over 4.2s; when it's full, the next row
		// takes over. The bar is the visitor's cue that this is playing by itself.
		const touring = () => wide.matches && !interacted && !reduce && started;
		const halt = () => {
			tween?.kill();
			tween = null;
		};
		const sync = () => tween?.paused(!(visible && !inside && !document.hidden));
		const arm = () => {
			halt();
			items.forEach((li) => gsap.set(li.querySelector('.row-timer'), { scaleX: 0 }));
			if (!touring() || cur < 0 || cur >= CYCLE) return;
			tween = gsap.fromTo(
				items[cur].querySelector('.row-timer'),
				{ scaleX: 0 },
				{ scaleX: 1, duration: 4.2, ease: 'none', onComplete: () => show((cur + 1) % CYCLE) },
			);
			sync();
		};
		const start = () => {
			started = true;
			arm();
		};
		const take = () => {
			if (interacted) return;
			interacted = true;
			spec.setAttribute('aria-live', 'polite');
			halt();
			items.forEach((li) => gsap.set(li.querySelector('.row-timer'), { scaleX: 0 }));
			hint.classList.add('is-manual');
			hintText.textContent = 'You’re in control. Hover or tap any row.';
		};

		// ---------- events ----------
		rows.forEach((row, i) => {
			row.addEventListener('pointerenter', (e) => {
				if (e.pointerType !== 'mouse' || !wide.matches) return;
				take();
				show(i);
			});
			row.addEventListener('focus', () => {
				if (!wide.matches) return;
				take();
				show(i);
			});
			// arrow keys walk the list, which also previews each row
			row.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					rows[i + (e.key === 'ArrowDown' ? 1 : -1)]?.focus();
				}
			});
			row.addEventListener('click', () => {
				take();
				// phones: tapping the open row closes it
				if (!wide.matches && cur === i) show(-1);
				else show(i);
			});
		});

		main.addEventListener('pointerenter', () => {
			inside = true;
			sync();
		});
		main.addEventListener('pointerleave', () => {
			inside = false;
			sync();
		});
		document.addEventListener('visibilitychange', sync);

		wide.addEventListener('change', () => {
			cur = -2;
			if (wide.matches) show(0, false);
			else show(-1);
		});

		// ---------- reveal, counters, first state ----------
		const reveal = () => {
			root.classList.add('is-visible');
			if (reduce) return;
			root.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
				const to = Number(el.dataset.count);
				const o = { v: 0 };
				el.textContent = '00';
				gsap.to(o, {
					v: to,
					duration: 1.3,
					delay: 0.35,
					ease: 'power2.out',
					onUpdate: () => (el.textContent = pad(Math.round(o.v))),
					onComplete: () => (el.textContent = pad(to)),
				});
			});
			if (cur >= 0 && wide.matches) drawIn(specs[cur]);
		};

		if (wide.matches) show(0, false);

		if (reduce || !('IntersectionObserver' in window)) {
			root.classList.add('is-visible');
			visible = true;
		} else {
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						visible = entry.isIntersecting;
						sync();
						if (entry.isIntersecting && !root.classList.contains('is-visible')) {
							reveal();
							start();
						}
					});
				},
				{ threshold: 0.2 },
			);
			io.observe(root);
		}
	}
</script>

<style>
	.lab {
		--accent-bright: #a78bfa;
		--mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
		overflow: hidden;
	}

	.lab-inner {
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(64px, 9vw, 112px) clamp(20px, 4vw, 32px);
	}

	/* ---------- scroll-in reveal ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 90ms);
	}

	.lab.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	/* ---------- header: text left, giant counter right ---------- */
	.lab-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 2rem 4rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.lab-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.lab-heading {
		margin: 0 0 0.75rem;
		font-size: clamp(2.4rem, 3vw + 1.5rem, 4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.lab-desc {
		margin: 0;
		max-width: 34rem;
		font-size: 1.02rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.lab-stats {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.9rem;
	}

	.stat-big {
		display: flex;
		align-items: flex-end;
		gap: 0.9rem;
		margin: 0;
	}

	.stat-num {
		font-size: clamp(4.5rem, 9vw, 8rem);
		font-weight: 800;
		letter-spacing: -0.06em;
		line-height: 0.8;
		font-variant-numeric: tabular-nums;
		background: linear-gradient(180deg, rgba(196, 181, 253, 0.95), rgba(139, 92, 246, 0.28));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.stat-label {
		max-width: 6.5rem;
		padding-bottom: 0.2rem;
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--muted);
	}

	.stat-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.4rem 1.2rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.stat-row li {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.stat-row b {
		font-weight: 600;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	/* ---------- list + preview ---------- */
	.lab-main {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(1.5rem, 4vw, 4.5rem);
		align-items: start;
	}

	.idx {
		margin: 0;
		padding: 0;
		list-style: none;
		border-bottom: 1px solid var(--border-soft);
	}

	.item {
		border-top: 1px solid var(--border-soft);
	}

	.row {
		position: relative;
		display: grid;
		grid-template-columns: 2.6rem minmax(0, 1fr) auto 1.2rem;
		grid-template-areas:
			'n name stage arrow'
			'n tag  stage arrow';
		align-items: center;
		column-gap: 1rem;
		row-gap: 0.1rem;
		width: 100%;
		padding: 1.05rem 0.5rem 1.05rem 0;
		background: none;
		border: 0;
		font: inherit;
		text-align: left;
		color: inherit;
		cursor: pointer;
		transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.row::before {
		content: '';
		position: absolute;
		left: 0;
		top: -1px;
		bottom: -1px;
		width: 2px;
		background: var(--accent-bright);
		transform: scaleY(0);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.row-n {
		grid-area: n;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: var(--muted);
		transition: color 0.25s ease;
	}

	.row-name {
		grid-area: name;
		font-size: clamp(1.05rem, 0.7vw + 0.9rem, 1.35rem);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: rgba(243, 243, 241, 0.8);
		transition: color 0.25s ease;
	}

	.row-tag {
		grid-area: tag;
		font-size: 0.84rem;
		line-height: 1.4;
		color: var(--muted);
	}

	.row-stage {
		grid-area: stage;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--border-soft);
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease;
	}

	.row-arrow {
		grid-area: arrow;
		justify-self: end;
		width: 0.55rem;
		height: 0.55rem;
		border-top: 1.5px solid var(--muted);
		border-right: 1.5px solid var(--muted);
		transform: rotate(45deg);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
	}

	.row:hover .row-name,
	.item.is-active .row-name {
		color: var(--ink);
	}

	.item.is-active .row {
		padding-left: 1rem;
	}

	.item.is-active .row::before {
