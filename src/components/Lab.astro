---
const stages = ['Thinking', 'Experimenting', 'Prototype', 'Building', 'Live'] as const;

const experiments = [
	{
		name: 'AI × Business',
		tagline: 'Where day-to-day decisions could just... happen.',
		stage: 2,
		log: 'We keep asking: which decisions in a business are actually just pattern-matching in a trench coat? Testing whether an agent can make the boring 80% of calls correctly, and only flag the ones that need a human.',
	},
	{
		name: 'AI × Search',
		tagline: 'Search that understands the question behind the question.',
		stage: 1,
		log: 'Most search returns documents. We want it to return answers — and the reasoning behind them. Still figuring out how much context is too much before it starts guessing.',
	},
	{
		name: 'AI × Operations',
		tagline: "Watching how work actually moves, not how it's supposed to.",
		stage: 0,
		log: "Before automating anything, we're just watching — screen recordings, shadowing, timing things with a stopwatch. Old-fashioned, but it's the only way to find the real bottleneck.",
	},
	{
		name: 'AI × Knowledge',
		tagline: 'What a company knows, made findable.',
		stage: 3,
		log: "Every company has tribal knowledge trapped in someone's head or a forgotten doc. Building a way to make it queryable without turning it into another wiki nobody updates.",
	},
	{
		name: 'Automation × WhatsApp',
		tagline: 'The most-used app becomes the least-used interface.',
		stage: 4,
		log: "For a lot of businesses, WhatsApp already is the interface. So instead of building an app nobody opens, we're teaching WhatsApp to do the app's job.",
	},
	{
		name: 'Data × Decision Making',
		tagline: 'Numbers that argue back before you commit.',
		stage: 0,
		log: 'Dashboards show you numbers. We want something that pushes back — "are you sure?" — before a bad call gets made, not after.',
	},
	{
		name: 'Software × Traditional Business',
		tagline: 'Old business, new nervous system.',
		stage: 1,
		log: "Can a business that's run on paper and phone calls for 20 years get a real nervous system without becoming unrecognizable to the people who built it?",
	},
].map((e, idx) => ({
	...e,
	idx,
	kicker: `Lab Notebook · 0${idx + 1}`,
	// top row (0-3) sits on grid lines 1,3,5,7 of an 8-column track; bottom
	// row (4-6) sits on 2,4,6 — each one column-line short of its top-row
	// neighbours, which centers it exactly on the boundary between them
	colStart: idx < 4 ? idx * 2 + 1 : (idx - 4) * 2 + 2,
	row: idx < 4 ? 1 : 2,
}));
---

<section class="lab" id="lab">
	<div class="lab-inner">
		<div class="lab-head">
			<div class="lab-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">05</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The Lab</span>
			</div>

			<h2 class="lab-heading reveal" style="--reveal-order: 1">N Lab</h2>
			<p class="lab-desc reveal" style="--reveal-order: 2">
				Some ideas are too early to become products. So we experiment with them.
			</p>
		</div>

		<div class="lab-filters reveal" id="labFilters" style="--reveal-order: 3">
			<button type="button" class="filter-pill" data-filter="all" aria-pressed="true">All</button>
			{stages.map((s) => (
				<button type="button" class="filter-pill" data-filter={s.toLowerCase()} aria-pressed="false">
					{s}
				</button>
			))}
		</div>

		<!-- staggered 4+3 editorial grid on an 8-column track (each card spans
		     2 of 8, so both rows stay the same width). Every card has a fixed
		     height and holds two stacked, absolutely-positioned faces
		     (default / notebook) that cross-fade in place — selecting a card
		     never changes its box, so the grid geometry never moves. -->
		<div class="lab-grid reveal" id="labGrid" style="--reveal-order: 4">
			{experiments.map((e) => (
				<article
					class="exp-card"
					data-stage={stages[e.stage].toLowerCase()}
					style={`--col-start: ${e.colStart}; --row: ${e.row};`}
				>
					<button
						type="button"
						class="exp-trigger exp-face exp-face--default"
						id={`exp-trigger-${e.idx}`}
						aria-expanded="false"
						aria-controls={`exp-notebook-${e.idx}`}
					>
						<span class="face-top">
							<span class="exp-name">{e.name}</span>
							<span class="face-icon" aria-hidden="true">&rarr;</span>
						</span>

						<span class="exp-tagline">{e.tagline}</span>

						<span class="exp-meter" aria-hidden="true">
							{stages.map((_, i) => (
								<span class={`meter-seg${i <= e.stage ? ' is-filled' : ''}${i === e.stage ? ' is-current' : ''}`}></span>
							))}
						</span>

						<span class="exp-stage">{stages[e.stage]}</span>
					</button>

					<div
						class="exp-face exp-face--notebook"
						id={`exp-notebook-${e.idx}`}
						role="region"
						aria-labelledby={`exp-trigger-${e.idx}`}
					>
						<button type="button" class="face-close" data-index={e.idx} aria-label={`Close ${e.name} notebook`}>
							&times;
						</button>

						<p class="notebook-kicker">{e.kicker}</p>
						<h4 class="notebook-title">{e.name}</h4>
						<p class="notebook-excerpt">{e.log}</p>

						<button
							type="button"
							class="notebook-explore"
							data-kicker={e.kicker}
							data-name={e.name}
							data-stage={stages[e.stage]}
							data-log={e.log}
						>
							Explore experiment
							<span aria-hidden="true">&rarr;</span>
						</button>
					</div>
				</article>
			))}
		</div>

		<p class="lab-footer reveal" style="--reveal-order: 5">
			Open any card to read the notes. Nothing here is finished, and that's the point.
		</p>
	</div>

	<div class="lab-modal" id="labModal" aria-hidden="true">
		<div class="modal-backdrop" data-close="true"></div>
		<div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
			<button type="button" class="modal-close" data-close="true" aria-label="Close experiment details">&times;</button>
			<p class="modal-kicker" id="modalKicker">Lab Notebook</p>
			<h3 class="modal-title" id="modalTitle">Experiment</h3>
			<span class="modal-stage" id="modalStage">Thinking</span>
			<p class="modal-text" id="modalText"></p>
		</div>
	</div>
</section>

<style>
	.lab {
		--accent-bright: #a78bfa;
		--card-bg: #0d1018;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	.lab-inner {
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(64px, 9vw, 112px) clamp(20px, 4vw, 32px);
	}

	/* ---------- scroll-in reveal ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 90ms);
	}

	.lab.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	.lab-head {
		max-width: 560px;
		margin: 0 auto clamp(32px, 4vw, 44px);
		text-align: center;
	}

	.lab-eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.lab-heading {
		margin: 0 0 0.75rem;
		font-size: clamp(2rem, 1.6vw + 1.7rem, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.lab-desc {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--muted);
	}

	/* ---------- filters ---------- */
	.lab-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
	}

	.filter-pill {
		padding: 0.5rem 1.05rem;
		background: none;
		border: 1px solid var(--border-soft);
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 500;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
	}

	.filter-pill:hover {
		color: var(--ink);
		border-color: rgba(255, 255, 255, 0.22);
	}

	.filter-pill[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: #ffffff;
	}

	/* ---------- experiment grid ----------
	   an 8-column track lets each card span 2 columns while the bottom row
	   sits one column-line short of the top row — that's what centers each
	   bottom card exactly on the boundary between two top cards, using fr
	   units throughout so it holds at any desktop width (no pixel offsets).
	   every card also has a fixed height, so a row's track size is fixed
	   too — selecting a card can never change it, which is what keeps the
	   whole grid geometrically stable. */
	.lab-grid {
		display: grid;
		grid-template-columns: repeat(8, 1fr);
		gap: 1.25rem;
	}

	.exp-card {
		position: relative;
		grid-column: var(--col-start) / span 2;
		grid-row: var(--row);
		height: 15.5rem;
		background: var(--card-bg);
		border: 1px solid var(--border-soft);
		border-radius: 16px;
		overflow: hidden;
		transition:
			border-color 0.28s ease-out,
			background-color 0.28s ease-out,
			box-shadow 0.28s ease-out;
	}

	.exp-card:hover {
		border-color: rgba(255, 255, 255, 0.2);
	}

	.exp-card.is-hidden {
		display: none;
	}

	/* with a stage filter on, the remaining cards would keep their staggered
	   column slots and leave gaps — let them flow left to right instead */
	.lab-grid.is-filtered .exp-card {
		grid-column: auto / span 2;
		grid-row: auto;
	}

	/* selected: slightly brighter surface, thin purple border, restrained
	   glow — never a size change */
	.exp-card.is-open {
		border-color: var(--accent);
		background: rgba(109, 40, 217, 0.09);
		box-shadow:
			0 0 0 1px rgba(109, 40, 217, 0.3),
			0 8px 22px rgba(109, 40, 217, 0.14);
	}

	/* ---------- two stacked faces, cross-fading in place ----------
	   both faces are absolutely positioned to fill the fixed-height card,
	   so swapping which one is visible never touches the card's box model. */
	.exp-face {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1.5rem;
		text-align: left;
		transition:
			opacity 0.26s ease-out,
			transform 0.26s ease-out;
	}

	.exp-face--default {
		background: none;
		border: none;
		width: 100%;
		cursor: pointer;
		font-family: inherit;
		color: inherit;
		opacity: 1;
		transform: translateY(0);
	}

	.exp-card.is-open .exp-face--default {
		opacity: 0;
		transform: translateY(-6px);
		pointer-events: none;
	}

	.exp-face--notebook {
		opacity: 0;
		transform: translateY(6px);
		pointer-events: none;
	}

	.exp-card.is-open .exp-face--notebook {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
		transition-delay: 60ms;
	}

	.face-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
	}

	.exp-name {
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.005em;
		color: var(--ink);
	}

	.face-icon {
		flex-shrink: 0;
		margin-top: 0.1rem;
		font-size: 0.95rem;
		color: var(--ink-faint);
		transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), color 0.25s ease;
	}

	.exp-face--default:hover .face-icon {
		color: var(--accent-bright);
		transform: translateX(3px);
	}

	.exp-tagline {
		flex: 1;
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--muted);
	}

	/* ---------- 5-segment stage meter ---------- */
	.exp-meter {
		display: flex;
		gap: 4px;
		width: 100%;
	}

	.meter-seg {
		flex: 1;
		height: 4px;
		border-radius: 2px;
		background: var(--border-soft);
	}

	.meter-seg.is-filled {
		background: var(--accent);
	}

	.meter-seg.is-current {
		animation: meter-pulse 2.6s ease-in-out infinite;
	}

	@keyframes meter-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.55;
		}
	}

	.exp-stage {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	/* ---------- notebook face ---------- */
	.face-close {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		background: none;
		border: 1px solid var(--border-soft);
		border-radius: 50%;
		color: var(--ink-faint);
		font-size: 0.85rem;
		line-height: 1;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.face-close:hover {
		color: var(--ink);
		border-color: rgba(255, 255, 255, 0.3);
	}

	.notebook-kicker {
		margin: 0;
		padding-right: 1.75rem;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.64rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-bright);
	}

	.notebook-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		color: #ffffff;
	}

	.notebook-excerpt {
		flex: 1;
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.notebook-explore {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0;
		background: none;
		border: none;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-bright);
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.notebook-explore:hover {
		color: #ffffff;
	}

	/* ---------- footer ---------- */
	.lab-footer {
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		text-align: center;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}

	/* ---------- explore-experiment modal ---------- */
	.lab-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease-out, visibility 0s linear 0.25s;
	}

	.lab-modal.is-open {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.25s ease-out;
	}

	.modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(6, 6, 9, 0.72);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.modal-panel {
		position: relative;
		width: 100%;
		max-width: 520px;
		max-height: 80vh;
		overflow-y: auto;
		background: var(--card-bg);
		border: 1px solid rgba(109, 40, 217, 0.35);
		border-radius: 20px;
		padding: clamp(1.75rem, 4vw, 2.5rem);
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
		transform: translateY(10px) scale(0.98);
		opacity: 0;
		transition: transform 0.28s ease-out, opacity 0.28s ease-out;
	}

	.lab-modal.is-open .modal-panel {
		transform: translateY(0) scale(1);
		opacity: 1;
	}

	.modal-close {
		position: absolute;
		top: 1.1rem;
		right: 1.1rem;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: 1px solid var(--border-soft);
		border-radius: 50%;
		color: var(--ink-faint);
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.modal-close:hover {
		color: var(--ink);
		border-color: rgba(255, 255, 255, 0.3);
	}

	.modal-kicker {
		margin: 0 0 0.6rem;
		padding-right: 2rem;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-bright);
	}

	.modal-title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.4rem, 1.5vw + 1.1rem, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #ffffff;
	}

	.modal-stage {
		display: inline-block;
		margin-bottom: 1.25rem;
		padding: 0.3rem 0.7rem;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-faint);
		border: 1px solid var(--border-soft);
		border-radius: 999px;
	}

	.modal-text {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--muted);
	}

	/* ---------- responsive ----------
	   the staggered composition is a desktop-only flourish — below 980px
	   there isn't room for it to read as intentional rather than cramped,
	   so it collapses to a plain 2-column track. With 7 cards and normal
	   row-by-row auto-placement that yields 2+2+2+1, a balanced fallback
	   rather than a forced, squeezed staggered layout. */
	@media (max-width: 1100px) {
		.lab-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.exp-card,
		.lab-grid.is-filtered .exp-card {
			grid-column: auto;
			grid-row: auto;
		}
	}

	@media (max-width: 640px) {
		.lab-grid {
			grid-template-columns: 1fr;
		}

		.exp-card {
			height: 14.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.filter-pill,
		.exp-card,
		.exp-face,
		.face-icon,
		.face-close,
		.notebook-explore,
		.lab-modal,
		.modal-panel,
		.modal-close {
			transition: none;
		}

		.meter-seg.is-current {
			animation: none;
		}
	}
</style>

<noscript>
	<style>
		.lab .reveal {
			opacity: 1 !important;
			transform: none !important;
		}

		.lab-filters {
			display: none !important;
		}

		.lab-modal {
			display: none !important;
		}
	</style>
</noscript>

<script>
	const section = document.getElementById('lab');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (reduceMotion || !('IntersectionObserver' in window)) {
		section?.classList.add('is-visible');
	} else {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						section?.classList.add('is-visible');
						revealObserver.disconnect();
					}
				});
			},
			{ threshold: 0.1 },
		);
		if (section) revealObserver.observe(section);
	}

	const filterPills = Array.from(document.querySelectorAll('.filter-pill')) as HTMLButtonElement[];
	const cards = Array.from(document.querySelectorAll('.exp-card')) as HTMLElement[];
	const triggers = Array.from(document.querySelectorAll('.exp-trigger')) as HTMLButtonElement[];
	const closeButtons = Array.from(document.querySelectorAll('.face-close')) as HTMLButtonElement[];
	const exploreButtons = Array.from(document.querySelectorAll('.notebook-explore')) as HTMLButtonElement[];

	let openIndex: number | null = null;

	const applyOpenState = () => {
		cards.forEach((card, i) => {
			const isOpen = i === openIndex;
			card.classList.toggle('is-open', isOpen);
			triggers[i]?.setAttribute('aria-expanded', String(isOpen));
		});
	};

	const setOpen = (index: number | null) => {
		openIndex = index;
		applyOpenState();
	};

	triggers.forEach((trigger, i) => {
		trigger.addEventListener('click', () => {
			setOpen(openIndex === i ? null : i);
		});
	});

	closeButtons.forEach((btn, i) => {
		btn.addEventListener('click', (event) => {
			event.stopPropagation();
			if (openIndex === i) setOpen(null);
		});
	});

	applyOpenState();

	filterPills.forEach((pill) => {
		pill.addEventListener('click', () => {
			const filter = pill.dataset.filter ?? 'all';

			filterPills.forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
			document.getElementById('labGrid')?.classList.toggle('is-filtered', filter !== 'all');

			cards.forEach((card) => {
				const matches = filter === 'all' || card.dataset.stage === filter;
				card.classList.toggle('is-hidden', !matches);
			});

			// if filtering hides the open card, just close it rather than
			// guessing which other card should take its place
			if (openIndex !== null && cards[openIndex]?.classList.contains('is-hidden')) {
				setOpen(null);
			}
		});
	});

	// ---------- explore-experiment modal ----------
	const modal = document.getElementById('labModal');
	const modalKicker = document.getElementById('modalKicker');
	const modalTitle = document.getElementById('modalTitle');
	const modalStage = document.getElementById('modalStage');
	const modalText = document.getElementById('modalText');
	let lastFocused: HTMLElement | null = null;

	const openModal = (trigger: HTMLButtonElement) => {
		lastFocused = trigger;
		if (modalKicker) modalKicker.textContent = trigger.dataset.kicker ?? '';
		if (modalTitle) modalTitle.textContent = trigger.dataset.name ?? '';
		if (modalStage) modalStage.textContent = trigger.dataset.stage ?? '';
		if (modalText) modalText.textContent = trigger.dataset.log ?? '';
		modal?.classList.add('is-open');
		modal?.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		(modal?.querySelector('.modal-close') as HTMLElement | null)?.focus();
	};

	const closeModal = () => {
		modal?.classList.remove('is-open');
		modal?.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
		lastFocused?.focus();
	};

	exploreButtons.forEach((btn) => {
		btn.addEventListener('click', (event) => {
			event.stopPropagation();
			openModal(btn);
		});
	});

	modal?.querySelectorAll('[data-close]').forEach((el) => {
		el.addEventListener('click', closeModal);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal?.classList.contains('is-open')) closeModal();
	});
</script>
