---
const steps = [
	{ label: 'Why?', desc: 'Before anything else, we ask why this needs to exist at all.' },
	{ label: 'Problem', desc: "We sit with the real problem, not the version that's easy to solve." },
	{ label: 'Think', desc: 'No tools yet. Just people, a whiteboard, and hard questions.' },
	{ label: 'Experiment', desc: 'Small, fast, disposable attempts — most of which will fail on purpose.' },
	{ label: 'Build', desc: 'What survives the experiments gets built for real.' },
	{ label: 'Connect', desc: 'Wired into the systems and people that already exist — not replacing them.' },
	{ label: 'Scale', desc: 'Once it works for one team, we make it work for everyone.' },
];
---

<section class="method" id="method">
	<div class="method-scroll">
		<div class="method-sticky">
			<div class="method-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">04</span>
				<span class="eyebrow-line" aria-hidden="true"></span>
				<span class="eyebrow-label">The Neulancers Method</span>
			</div>

			<h2 class="method-heading reveal" style="--reveal-order: 1">We don&rsquo;t start with technology.</h2>

			<nav class="method-nav reveal" aria-label="Method steps" style="--reveal-order: 2">
				<div class="nav-track" aria-hidden="true">
					<div class="nav-track-fill" id="navTrackFill"></div>
				</div>
				<ol class="nav-list" id="navList">
					{steps.map((step, i) => (
						<li class="nav-step-item">
							<a class="nav-item" href={`#method-step-${i}`} data-index={i} aria-current={i === 0 ? 'true' : 'false'}>
								<span class="nav-node" aria-hidden="true">
									<span class="nav-node-glow"></span>
									<span class="nav-node-ring"></span>
									<span class="nav-node-num">{`0${i + 1}`}</span>
								</span>
								<span class="nav-label">{step.label}</span>
							</a>
						</li>
					))}
				</ol>
			</nav>
		</div>

		<div class="method-steps" id="methodSteps">
			{steps.map((step, i) => (
				<div class="step-block" id={`method-step-${i}`} data-index={i}>
					<span class="step-block-idx">{`0${i + 1}`}</span>
					<h3 class="step-block-label">{step.label}</h3>
					<p class="step-block-desc">{step.desc}</p>
				</div>
			))}

			<p class="method-footer">Technology is usually the last part of the conversation.</p>
		</div>
	</div>
</section>

<style>
	.method {
		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	.method-scroll {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
		gap: clamp(2rem, 6vw, 5rem);
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(72px, 10vw, 128px) clamp(20px, 4vw, 32px);
	}

	/* ---------- scroll-in reveal (sticky column only) ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 90ms);
	}

	.method.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	/* ---------- sticky left column ---------- */
	.method-sticky {
		position: sticky;
		top: clamp(96px, 14vh, 140px);
		align-self: start;
	}

	.method-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.eyebrow-idx {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.eyebrow-line {
		width: 32px;
		height: 1px;
		background: var(--border-soft);
	}

	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.method-heading {
		margin: 0 0 2.5rem;
		font-size: clamp(1.7rem, 1.3vw + 1.5rem, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		max-width: 16ch;
	}

	/* ---------- nav rail: tracks scroll position ---------- */
	.method-nav {
		position: relative;
		--node-size: 2.5rem;
	}

	.nav-track {
		position: absolute;
		top: calc(var(--node-size) / 2);
		bottom: calc(var(--node-size) / 2);
		left: calc(var(--node-size) / 2);
		width: 1.5px;
		background: rgba(255, 255, 255, 0.08);
	}

	.nav-track-fill {
		width: 100%;
		height: 0%;
		background: linear-gradient(to bottom, var(--accent), #a78bfa);
		box-shadow: 0 0 10px 1px rgba(139, 92, 246, 0.5);
		transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.65rem;
	}

	.nav-step-item {
		position: relative;
	}

	/* CSS-only chevron marker in the gap between two nodes, echoing the
	   downward arrows in the reference's connecting line */
	.nav-step-item:not(:last-child)::after {
		content: '';
		position: absolute;
		left: calc(var(--node-size) / 2);
		bottom: calc(-0.825rem - 1px);
		width: 6px;
		height: 6px;
		border-right: 1.4px solid rgba(167, 139, 250, 0.55);
		border-bottom: 1.4px solid rgba(167, 139, 250, 0.55);
		transform: translate(-50%, 0) rotate(45deg);
		z-index: 2;
		pointer-events: none;
	}

	.nav-item {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		text-decoration: none;
		color: inherit;
	}

	.nav-node {
		position: relative;
		flex-shrink: 0;
		width: var(--node-size);
		height: var(--node-size);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: radial-gradient(circle at 50% 38%, rgba(109, 40, 217, 0.16), rgba(10, 10, 13, 0.9) 72%);
		border: 1.5px solid var(--border-soft);
		transition:
			border-color 0.3s ease,
			background 0.3s ease,
			box-shadow 0.3s ease,
			transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-node-glow {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(109, 40, 217, 0.5), transparent 70%);
		filter: blur(9px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.nav-node-ring {
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		border: 1px solid rgba(139, 92, 246, 0.4);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.nav-node-num {
		position: relative;
		z-index: 1;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--ink-faint);
		transition: color 0.3s ease;
	}

	.nav-label {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--muted);
		transition: color 0.25s ease;
	}

	.nav-item:hover .nav-label {
		color: var(--ink);
	}

	.nav-item[aria-current='true'] .nav-node {
		border-color: var(--accent);
		background: radial-gradient(circle at 50% 35%, rgba(139, 92, 246, 0.55), rgba(76, 29, 149, 0.4) 72%);
		box-shadow:
			0 0 0 1px rgba(109, 40, 217, 0.5),
			0 8px 22px rgba(109, 40, 217, 0.4);
		transform: scale(1.08);
	}

	.nav-item[aria-current='true'] .nav-node-num {
		color: #ffffff;
	}

	.nav-item[aria-current='true'] .nav-node-glow {
		opacity: 1;
		animation: navNodePulse 2.6s ease-in-out infinite;
	}

	.nav-item[aria-current='true'] .nav-node-ring {
		opacity: 1;
	}

	.nav-item[aria-current='true'] .nav-label {
		color: var(--ink);
	}

	@keyframes navNodePulse {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(0.92);
		}
		50% {
			opacity: 1;
			transform: scale(1.1);
		}
	}

	/* ---------- right column: full-height step reading blocks ---------- */
	.step-block {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		min-height: 22vh;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border-soft);
	}

	.step-block:first-child {
		padding-top: 0;
	}

	.step-block-idx {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.8rem;
		color: var(--ink-faint);
		margin-bottom: 0.75rem;
	}

	.step-block-label {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 2.4vw + 1.3rem, 3.2rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.step-block-desc {
		margin: 0;
		max-width: 42ch;
		font-size: clamp(1rem, 0.5vw + 0.9rem, 1.2rem);
		line-height: 1.6;
		color: var(--muted);
	}

	.method-footer {
		margin: 2.5rem 0 0;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}

	/* ---------- responsive: sticky two-column doesn't work on narrow
	   screens — stack normally instead ---------- */
	@media (max-width: 860px) {
		.method-scroll {
			display: block;
		}

		.method-sticky {
			position: static;
			margin-bottom: clamp(2.5rem, 8vw, 3.5rem);
		}

		.method-heading {
			max-width: none;
		}

		/* the step list below already repeats every label, so the rail
		   would just show the same seven items twice on a narrow screen */
		.method-nav {
			display: none;
		}

		.method-heading {
			margin-bottom: 0;
		}

		.nav-track {
			display: none;
		}

		.nav-step-item:not(:last-child)::after {
			display: none;
		}

		.step-block {
			min-height: 0;
			padding: 1.25rem 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-node,
		.nav-node-num,
		.nav-node-glow,
		.nav-node-ring,
		.nav-label,
		.nav-track-fill,
		.reveal {
			transition: none;
		}

		.nav-item[aria-current='true'] .nav-node-glow {
			animation: none;
			opacity: 0.8;
		}
	}
</style>

<noscript>
	<style>
		.method .reveal {
			opacity: 1 !important;
			transform: none !important;
		}

		.method-sticky {
			position: static !important;
		}
	</style>
</noscript>

<script>
	const section = document.getElementById('method');
	const navItems = Array.from(document.querySelectorAll('.nav-item')) as HTMLAnchorElement[];
	const trackFill = document.getElementById('navTrackFill');
	const stepBlocks = Array.from(document.querySelectorAll('.step-block')) as HTMLElement[];
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// section entrance (eyebrow / heading / nav) fades in once, same as
	// the other sections
	if (section) {
		if (reduceMotion || !('IntersectionObserver' in window)) {
			section.classList.add('is-visible');
		} else {
			const entranceObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							section.classList.add('is-visible');
							entranceObserver.disconnect();
						}
					});
				},
				{ threshold: 0.15 },
			);
			entranceObserver.observe(section);
		}
	}

	// active-step tracking: whichever step-block occupies the vertical
	// center of the viewport is "current" — highlights the matching nav
	// item and fills the rail up to it.
	if (navItems.length && stepBlocks.length && 'IntersectionObserver' in window) {
		const setActive = (index: number) => {
			navItems.forEach((item, i) => {
				item.setAttribute('aria-current', String(i === index));
			});
			if (trackFill) {
				trackFill.style.height = `${(index / (navItems.length - 1)) * 100}%`;
			}
		};

		const activeObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const index = Number((entry.target as HTMLElement).dataset.index ?? 0);
						setActive(index);
					}
				});
			},
			{ rootMargin: '-45% 0px -45% 0px', threshold: 0 },
		);

		stepBlocks.forEach((block) => activeObserver.observe(block));
	}

	// clicking a nav item still works as a plain anchor link without this,
	// but smooth-scroll it when motion is allowed
	if (!reduceMotion) {
		navItems.forEach((item) => {
			item.addEventListener('click', (event) => {
				const targetId = item.getAttribute('href')?.slice(1);
				const target = targetId ? document.getElementById(targetId) : null;
				if (target) {
					event.preventDefault();
					target.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			});
		});
	}
</script>
