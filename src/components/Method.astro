---
// each step: the big word, one sentence, and a small line icon (24 grid)
const steps = [
	{
		label: 'Why?',
		desc: 'Before anything else, we ask why this needs to exist at all.',
		icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1 1-1.1 1.8M12 17h.01"/>',
	},
	{
		label: 'Problem',
		desc: "We sit with the real problem, not the version that's easy to solve.",
		icon: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
	},
	{
		label: 'Think',
		desc: 'No tools yet. Just people, a whiteboard, and hard questions.',
		icon: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>',
	},
	{
		label: 'Experiment',
		desc: 'Small, fast, disposable attempts — most of which will fail on purpose.',
		icon: '<path d="M9 3h6M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2.2h12.4A1.5 1.5 0 0 0 19.5 19L14 9V3"/><path d="M7.5 15h9"/>',
	},
	{
		label: 'Build',
		desc: 'What survives the experiments gets built for real.',
		icon: '<path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9L12 3Z"/><path d="M12 12 3.5 7.5M12 12l8.5-4.5M12 12v9"/>',
	},
	{
		label: 'Connect',
		desc: 'Wired into the systems and people that already exist — not replacing them.',
		icon: '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/>',
	},
	{
		label: 'Scale',
		desc: 'Once it works for one team, we make it work for everyone.',
		icon: '<path d="M4 20 20 4M20 4h-7M20 4v7"/>',
	},
];
---

<section class="method" id="method" aria-labelledby="method-title">
	<div class="method-bg" aria-hidden="true">
		<span class="bg-well bg-well--a"></span>
		<span class="bg-well bg-well--b"></span>
		<span class="bg-well bg-well--c"></span>
	</div>

	<div class="method-inner">
		<div class="method-head">
			<div class="method-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">05</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The Neulancers Method</span>
			</div>

			<h2 class="method-heading reveal" id="method-title" style="--reveal-order: 1">We don&rsquo;t start with technology.</h2>
			<p class="method-sub reveal" style="--reveal-order: 2">Seven steps, in this order. Follow the line<span class="sub-hint">, and hover any step to read it again</span>.</p>
			<ol class="method-legend reveal" style="--reveal-order: 3" aria-label="Jump to a step">
				{steps.map((step, i) => (
					<li data-index={i}><button type="button" class="legend-btn"><span>{`0${i + 1}`}</span>{step.label}</button></li>
				))}
			</ol>
		</div>

		<div class="mp" id="methodPath">
			<svg class="mp-svg" aria-hidden="true" fill="none">
				<defs>
					<linearGradient id="mpGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color="#c4b5fd"></stop>
						<stop offset="1" stop-color="#7c3aed"></stop>
					</linearGradient>
				</defs>
				<path class="mp-track"></path>
				<path class="mp-prog"></path>
				<g class="mp-cap mp-cap--start"><circle class="cap-shadow" r="16"></circle><circle class="cap-dot" r="8"></circle></g>
				<g class="mp-cap mp-cap--end"><circle class="cap-shadow" r="16"></circle><circle class="cap-dot" r="8"></circle></g>
				<circle class="mp-pen" r="7"></circle>
			</svg>

			<ol class="mp-stops">
				{steps.map((step, i) => (
					<li class="stop" data-index={i}>
						<span class="stop-dot" aria-hidden="true"></span>
						<div class="stop-body">
							<p class="stop-n">{`0${i + 1}`}</p>
							<div class="stop-row" tabindex="0">
								<h3 class="stop-word">{step.label}</h3>
								<span class="stop-tile" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon}></svg>
								</span>
							</div>
							<div class="stop-desc">
								<p class="card-kicker"><span>{`Step 0${i + 1}`}</span><i aria-hidden="true"></i><span>{step.label.replace('?', '')}</span></p>
								<p class="card-text">{step.desc}</p>
								<ol class="card-dots" aria-hidden="true">
									{steps.map((_, k) => (
										<li class:list={[k < i && 'is-past', k === i && 'is-now']}></li>
									))}
								</ol>
							</div>
						</div>
					</li>
				))}
			</ol>
		</div>

		<div class="method-end reveal" style="--reveal-order: 0">
			<p class="method-footer">Technology is usually the last part of the conversation.</p>
			<a href="#contact" class="method-cta">
				<span>Bring us a problem</span>
				<span class="cta-arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const section = document.getElementById('method');
	const wrap = document.getElementById('methodPath');

	if (section && wrap) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const svg = wrap.querySelector<SVGSVGElement>('.mp-svg')!;
		const track = wrap.querySelector<SVGPathElement>('.mp-track')!;
		const prog = wrap.querySelector<SVGPathElement>('.mp-prog')!;
		const pen = wrap.querySelector<SVGCircleElement>('.mp-pen')!;
		const stops = Array.from(wrap.querySelectorAll<HTMLElement>('.stop'));
		const legend = Array.from(section.querySelectorAll<HTMLElement>('.method-legend li'));
		const N = stops.length;

		// each big word is split into letters so it can rise in one by one; the
		// heading keeps its full text for screen readers
		stops.forEach((el) => {
			const word = el.querySelector<HTMLElement>('.stop-word');
			if (!word || word.querySelector('.ch')) return;
			const text = word.textContent ?? '';
			word.setAttribute('aria-label', text);
			word.innerHTML = Array.from(text)
				.map((c) => `<span class="ch" aria-hidden="true">${c}</span>`)
				.join('');
		});

		// ---------- entrance for the heading block ----------
		const revealEls = Array.from(section.querySelectorAll<HTMLElement>('.reveal'));
		if (reduceMotion || !('IntersectionObserver' in window)) {
			revealEls.forEach((el) => el.classList.add('is-visible'));
		} else {
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}),
				{ threshold: 0.15 },
			);
			revealEls.forEach((el) => io.observe(el));
		}

		// legend buttons jump to their step
		let stopY: number[] = [];
		// where to scroll so the line has just reached a step (set once the line is
		// built; the line is drawn by path length, so a step's height on the page
		// is not a reliable guide)
		let scrollFor: ((i: number) => number) | null = null;
		section.querySelectorAll<HTMLButtonElement>('.legend-btn').forEach((btn, i) =>
			btn.addEventListener('click', () => {
				const y = scrollFor
					? scrollFor(i)
					: wrap.getBoundingClientRect().top + window.scrollY + (stopY[i] ?? 0) - window.innerHeight * 0.4;
				window.scrollTo({ top: y, behavior: reduceMotion ? 'auto' : 'smooth' });
			}),
		);

		// the glow behind the line drifts a little against the scroll
		if (!reduceMotion) {
			gsap.to(section.querySelectorAll('.bg-well'), {
				yPercent: (i: number) => (i % 2 ? -10 : 10),
				ease: 'none',
				scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: true },
			});
		}

		// a smooth curve through the points. Each segment's handles are one third
		// of that segment's own length, pointing along the local direction, so
		// uneven point spacing (a long line next to a tight loop) can't make the
		// curve overshoot into little hooks.
		type P = { x: number; y: number };
		const curve = (p: P[]) => {
			const dir = (a: P, b: P) => {
				const l = Math.hypot(b.x - a.x, b.y - a.y) || 1;
				return { x: (b.x - a.x) / l, y: (b.y - a.y) / l };
			};
			let d = `M${p[0].x.toFixed(1)} ${p[0].y.toFixed(1)}`;
			for (let k = 0; k < p.length - 1; k++) {
				const p1 = p[k];
				const p2 = p[k + 1];
				const t1 = dir(p[k - 1] ?? p1, p2);
				const t2 = dir(p1, p[k + 2] ?? p2);
				const h = Math.hypot(p2.x - p1.x, p2.y - p1.y) / 3;
				d += ` C${(p1.x + t1.x * h).toFixed(1)} ${(p1.y + t1.y * h).toFixed(1)} ${(p2.x - t2.x * h).toFixed(1)} ${(p2.y - t2.y * h).toFixed(1)} ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
			}
			return d;
		};

		// a loop-the-loop in the line between two stops: the line runs straight,
		// curls once round a circle (drifting forward a little so it crosses
		// itself) and carries on, all sitting on the line between the two stops
		const loop = (a: P, b: P, flip: number, at: number): P[] => {
			const dx = b.x - a.x;
			const dy = b.y - a.y;
			const L = Math.hypot(dx, dy);
			const u = { x: dx / L, y: dy / L };
			const n = { x: -u.y * flip, y: u.x * flip };
			const R = Math.min(L * 0.17, 56);
			const D = R * 2.5;
			const base = { x: a.x + u.x * L * at, y: a.y + u.y * L * at };
			const out: P[] = [];
			const steps = 40;
			for (let k = 0; k <= steps; k++) {
				const th = (k / steps) * Math.PI * 2;
				const xl = R * Math.sin(th) + (D * th) / (Math.PI * 2);
				const yl = R * (1 - Math.cos(th));
				out.push({ x: base.x + u.x * xl + n.x * yl, y: base.y + u.y * xl + n.y * yl });
			}
			return out;
		};
		const NS = 'http://www.w3.org/2000/svg';

		// ---------- path styles: one for wider screens, one for phones ----------
		type Cfg = {
			plan: (W: number, mobile: boolean) => Array<[number, number]>;
			start: (W: number, H: number, lg: number, rg: number) => P;
			end: (W: number, H: number, lg: number, rg: number) => P;
			loops: Set<number>;
			free: boolean;
			k: number;
			amp: number;
			bow: number;
			wobble: number;
			doodles: Set<number>;
			seed: number;
		};
		const edgeStart = (W: number, H: number, lg: number, rg: number): P => ({ x: W + rg - 34, y: H * 0.02 });
		const edgeEnd = (W: number, H: number, lg: number, rg: number): P => ({ x: -lg + 34, y: H * 0.955 });
		const VARIANTS: Record<string, Cfg> = {
			// phones: alternating sides, one loop
			classic: {
				plan: (W, m) => {
					const r = W * (m ? 0.76 : 0.84);
					const l = W * (m ? 0.24 : 0.16);
					return [[r, 0.07], [l, 0.205], [r, 0.345], [l, 0.49], [r, 0.64], [W * 0.34, 0.79], [W * (m ? 0.14 : 0.1), 0.92]];
				},
				start: edgeStart,
				end: edgeEnd,
				loops: new Set([0]),
				free: false,
				k: 0.3,
				amp: 0,
				bow: 0.16,
				wobble: 0,
				doodles: new Set(),
				seed: 1,
			},
			// phones: a straight line down the left with every step hung on it
			timeline: {
				plan: (W) => Array.from({ length: 7 }, (_, i): [number, number] => [W * 0.1, 0.05 + i * 0.135]),
				start: (W) => ({ x: W * 0.1, y: 0 }),
				end: (W, H) => ({ x: W * 0.1, y: H }),
				loops: new Set(),
				free: false,
				k: 0.3,
				amp: 0,
				bow: 0,
				wobble: 0,
				doodles: new Set(),
				seed: 1,
			},
			// wider screens: one flowing line at irregular spots, a few drawings
			mix: {
				plan: (W) => [[W * 0.84, 0.06], [W * 0.3, 0.19], [W * 0.7, 0.35], [W * 0.16, 0.5], [W * 0.78, 0.66], [W * 0.38, 0.8], [W * 0.12, 0.93]],
				start: edgeStart,
				end: edgeEnd,
				loops: new Set([0]),
				free: true,
				k: 0.16,
				amp: 0.3,
				bow: 0.16,
				wobble: 0,
				doodles: new Set([2, 3, 6]),
				seed: 7,
			},
		};
		const variant = 'mix';

		// small seeded random numbers, so a rebuild draws the same line
		const mulberry = (a: number) => () => {
			a |= 0;
			a = (a + 0x6d2b79f5) | 0;
			let t = Math.imul(a ^ (a >>> 15), 1 | a);
			t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
			return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
		};

		// a hand-drawn look: resample the line and nudge each sample sideways
		const wobbleLine = (d: string, amount: number, rnd: () => number) => {
			track.setAttribute('d', d);
			const L = track.getTotalLength();
			const n = Math.max(8, Math.round(L / 16));
			const out: P[] = [];
			let drift = 0;
			for (let k = 0; k <= n; k++) {
				const a = track.getPointAtLength((k / n) * L);
				const b = track.getPointAtLength(Math.min(L, (k / n) * L + 2));
				const l = Math.hypot(b.x - a.x, b.y - a.y) || 1;
				drift = drift * 0.6 + (rnd() - 0.5) * amount * 1.6;
				out.push({ x: a.x + (-(b.y - a.y) / l) * drift, y: a.y + ((b.x - a.x) / l) * drift });
			}
			return curve(out);
		};

		// little drawings that appear beside a step once the line reaches it
		const spiral = () => {
			let d = '';
			for (let k = 0; k <= 70; k++) {
				const t = (k / 70) * Math.PI * 5.5;
				const r = 2 + t * 2.4;
				d += `${k ? 'L' : 'M'}${(r * Math.cos(t)).toFixed(1)} ${(r * Math.sin(t)).toFixed(1)} `;
			}
			return d;
		};
		const DOODLES: string[] = [
			'M0 14 C16 -12 42 -12 56 10 M46 3 L56 10 L48 19', // an arrow curling toward the answer
			'M0 0 q7 -9 14 0 t14 0 t14 0 t14 0 t14 0', // a quick underline squiggle
			spiral(), // thinking in circles
			'M0 0 H18 M18 0 C32 0 36 -16 52 -16 M18 0 C32 0 36 16 52 16 M18 0 H56 M52 -20 l8 8 m0 -8 l-8 8 M52 12 l8 8 m0 -8 l-8 8', // a fork: two attempts fail, one goes on
			'M0 6 L12 20 L40 -14', // a tick
			'M0 0 L32 -16 M0 0 L32 16 M32 -16 L32 16 M-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M27 -16 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M27 16 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0', // connected dots
			'M0 -20 L5 -5 L20 0 L5 5 L0 20 L-5 5 L-20 0 L-5 -5 Z', // a spark
		];
		type Spot = { dir: number; dx: number; dy: number };
		const drawDoodles = (cfg: Cfg, pts: P[], spots: Spot[]) => {
			svg.querySelector('.mp-doodles')?.remove();
			if (!cfg.doodles.size) return;
			const g = document.createElementNS(NS, 'g');
			g.setAttribute('class', 'mp-doodles');
			pts.forEach((p, i) => {
				if (!cfg.doodles.has(i)) return;
				const sp = spots[i] ?? { dir: 1, dx: 88, dy: -46 };
				const dir = sp.dir;
				const wrapG = document.createElementNS(NS, 'g');
				wrapG.setAttribute('transform', `translate(${(p.x + dir * sp.dx).toFixed(1)} ${(p.y + sp.dy).toFixed(1)}) scale(${dir} 1)`);
				const path = document.createElementNS(NS, 'path');
				path.setAttribute('d', DOODLES[i]);
				path.setAttribute('pathLength', '1');
				path.setAttribute('class', 'mp-doodle');
				path.dataset.stop = String(i);
				path.setAttribute('fill', 'none');
				path.setAttribute('stroke', '#c4b5fd');
				path.setAttribute('stroke-width', '2.2');
				path.setAttribute('stroke-linecap', 'round');
				path.setAttribute('stroke-linejoin', 'round');
				path.style.strokeDasharray = '1';
				path.style.strokeDashoffset = '1';
				path.style.transition = 'stroke-dashoffset 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
				path.style.filter = 'drop-shadow(0 0 6px rgba(139,92,246,0.6))';
				wrapG.appendChild(path);
				g.appendChild(wrapG);
			});
			svg.appendChild(g);
		};
		const setDoodles = (reached: (i: number) => boolean) =>
			svg.querySelectorAll<SVGPathElement>('.mp-doodle').forEach((el) => {
				el.style.strokeDashoffset = reached(Number(el.dataset.stop)) ? '0' : '1';
			});

		// a slim bar that stays on screen once the step list has scrolled away:
		// where you are, and a dot per step to jump to
		let setSticky: (cur: number) => void = () => {};
		if (!reduceMotion) {
			const names = stops.map((el, i) => el.querySelector('.stop-word')?.getAttribute('aria-label') ?? `Step ${i + 1}`);
			const bar = document.createElement('div');
			bar.className = 'method-sticky';
			bar.setAttribute('role', 'navigation');
			bar.setAttribute('aria-label', 'Method steps');
			bar.innerHTML = `<span class="ms-count">01 / 0${N}</span><span class="ms-name">${names[0]}</span><span class="ms-dots">${stops
				.map((_, i) => `<button type="button" class="ms-dot" aria-label="Go to step ${i + 1}: ${names[i]}"></button>`)
				.join('')}</span>`;
			document.body.appendChild(bar);
			const count = bar.querySelector<HTMLElement>('.ms-count')!;
			const nameEl = bar.querySelector<HTMLElement>('.ms-name')!;
			const dots = Array.from(bar.querySelectorAll<HTMLButtonElement>('.ms-dot'));
			dots.forEach((d, i) => d.addEventListener('click', () => legend[i].querySelector('button')?.click()));
			setSticky = (cur) => {
				const c = Math.max(0, cur);
				count.textContent = `0${c + 1} / 0${N}`;
				nameEl.textContent = names[c];
				dots.forEach((d, i) => {
					d.classList.toggle('is-on', i <= c);
					d.classList.toggle('is-cur', i === c);
					if (i === c) d.setAttribute('aria-current', 'step');
					else d.removeAttribute('aria-current');
				});
			};
			setSticky(0);
			const legendEl = section.querySelector<HTMLElement>('.method-legend');
			let queued = false;
			const place = () => {
				queued = false;
				const sr = section.getBoundingClientRect();
				const legendGone = !legendEl || legendEl.getBoundingClientRect().bottom < 76 || getComputedStyle(legendEl).display === 'none';
				const headGone = section.querySelector('.method-head')!.getBoundingClientRect().bottom < 76;
				bar.classList.toggle('is-on', (legendGone && headGone) && sr.bottom > 240 && sr.top < window.innerHeight);
			};
			const queue = () => {
				if (!queued) {
					queued = true;
					requestAnimationFrame(place);
				}
			};
			window.addEventListener('scroll', queue, { passive: true });
			window.addEventListener('resize', queue);
			place();
		}

		let stopTick: (() => void) | null = null;
		let ctx: gsap.Context | null = null;
		let width = 0;

		const build = () => {
			ctx?.revert();
			stopTick?.();
			stopTick = null;
			wrap.classList.add('is-ready');

			const W = wrap.clientWidth;
			width = W;
			const mobile = W < 700;
			wrap.classList.toggle('is-mobile', mobile);

			// the whole line is about three screens tall, so the last step arrives
			// after roughly three scrolls
			const vh = window.innerHeight;
			// three screens tall: steps 1-2 on the first screen, 3-4 on the second
			// and 5-7 on the third, as in the sketch
			// about a screen and a quarter on desktop: the stops are close enough
			// that three or four are visible together. The explanation opens beside
			// each word, so the tighter spacing doesn't make it collide with the next.
			const H = Math.max(mobile ? 1500 : 1100, Math.min(1.25 * vh, 1500));
			wrap.style.height = `${H}px`;
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			svg.setAttribute('width', String(W));
			svg.setAttribute('height', String(H));
			svg.querySelector('#mpGrad')?.setAttribute('y2', String(H));

			const box = wrap.getBoundingClientRect();
			const rightGap = Math.max(0, window.innerWidth - box.right);
			const leftGap = Math.max(0, box.left);
			// phones always use the plain path; the styles are for wider screens
			const cfg = mobile ? VARIANTS.timeline : VARIANTS[variant];
			const stopPts: P[] = cfg.plan(W, mobile).map(([x, fy]) => ({ x, y: H * fy }));
			const startPt = cfg.start(W, H, leftGap, rightGap);
			const endPt = cfg.end(W, H, leftGap, rightGap);
			const rnd = mulberry(cfg.seed);
			const minX = -leftGap + 24;
			const maxX = W + rightGap - 24;
			// every stop is passed on a diagonal aimed at its neighbours, with a
			// control point just before and after it
			const near = (p: P, q: P, k: number): P => ({ x: p.x + (q.x - p.x) * k, y: p.y + (q.y - p.y) * k });
			const pts: P[] = [startPt];
			// the line's first and last stretches get a bend too, so it doesn't
			// arrive or leave in a ruler-straight run
			const bendBetween = (a: P, b: P): P => {
				const dx = b.x - a.x;
				const dy = b.y - a.y;
				const L = Math.hypot(dx, dy) || 1;
				const o = (rnd() - 0.5) * 2 * cfg.amp * L * 0.7;
				return { x: Math.min(maxX, Math.max(minX, a.x + dx * 0.5 + (-dy / L) * o)), y: a.y + dy * 0.5 + (dx / L) * o };
			};
			if (cfg.free) pts.push(bendBetween(startPt, stopPts[0]));
			stopPts.forEach((p, i) => {
				const pre = i > 0 ? near(p, stopPts[i - 1], cfg.k) : null;
				const post = i < N - 1 ? near(p, stopPts[i + 1], cfg.k) : null;
				if (pre) pts.push(pre);
				pts.push(p);
				if (post) {
					pts.push(post);
					const nextPre = near(stopPts[i + 1], p, cfg.k);
					const dx = nextPre.x - post.x;
					const dy = nextPre.y - post.y;
					if (cfg.loops.has(i)) {
						pts.push(...loop(post, nextPre, i % 2 === 0 ? 1 : -1, 0.5));
					} else if (cfg.free) {
						// two bends of random size and direction, so no two stretches look alike
						const L = Math.hypot(dx, dy) || 1;
						const nx = -dy / L;
						const ny = dx / L;
						const a1 = (rnd() - 0.5) * 2 * cfg.amp * L;
						const a2 = (rnd() - 0.5) * 2 * cfg.amp * L;
						const clampX = (x: number) => Math.min(maxX, Math.max(minX, x));
						pts.push({ x: clampX(post.x + dx * 0.33 + nx * a1), y: post.y + dy * 0.33 + ny * a1 });
						pts.push({ x: clampX(post.x + dx * 0.67 + nx * a2), y: post.y + dy * 0.67 + ny * a2 });
					} else {
						// a soft bow so the stretch between stops is a curve, not a ruler line
						const bow = (i % 2 === 0 ? -1 : 1) * cfg.bow;
						pts.push({ x: post.x + dx / 2 - dy * bow, y: post.y + dy / 2 + dx * bow });
					}
				}
			});
			if (cfg.free) pts.push(bendBetween(stopPts[N - 1], endPt));
			pts.push(endPt);

			let d = curve(pts);
			if (cfg.wobble) d = wobbleLine(d, cfg.wobble, rnd);
			[track, prog].forEach((path) => {
				path.setAttribute('d', d);
				path.setAttribute('pathLength', '1');
			});

			const placeCap = (sel: string, pt: P) => {
				svg.querySelectorAll<SVGCircleElement>(`${sel} circle`).forEach((c, k) => {
					c.setAttribute('cx', (pt.x + 0).toFixed(1));
					c.setAttribute('cy', (pt.y + 0).toFixed(1));
				});
			};
			placeCap('.mp-cap--start', startPt);
			placeCap('.mp-cap--end', endPt);

			stopY = stopPts.map((p) => p.y);
			stops.forEach((el, i) => {
				el.style.left = `${stopPts[i].x}px`;
				el.style.top = `${stopPts[i].y}px`;
				el.dataset.side = stopPts[i].x > W * 0.5 ? 'node-right' : 'node-left';
			});

			// where along the line each stop sits (0..1), found by sampling
			const len = track.getTotalLength();
			// the part of the line that is still ahead is dotted; the bright line
			// drawn over it is the part already travelled. (pathLength is 1, so
			// dash sizes are fractions of the whole line.)
			track.style.strokeDasharray = `${0.5 / len} ${12 / len}`;
			const samples = 1400;
			const frac = stops.map((_, i) => {
				const target = stopPts[i];
				let best = 0;
				let bestDist = Infinity;
				for (let s = 0; s <= samples; s++) {
					const pt = track.getPointAtLength((s / samples) * len);
					const dist = (pt.x - target.x) ** 2 + (pt.y - target.y) ** 2;
					if (dist < bestDist) {
						bestDist = dist;
						best = s / samples;
					}
				}
				return best;
			});

			// For each step, choose the side (and, if needed, a small lift) where its
			// word does not sit on the line. The line is sampled every 6px and each
			// option's word box is tested against it.
			const dirs: number[] = stopPts.map((p) => (p.x > W * 0.5 ? 1 : -1));
			stops.forEach((el) => el.style.setProperty('--wy', '0px'));
			if (!mobile) {
				const dense: P[] = [];
				for (let at = 0; at <= len; at += 6) {
					const q = track.getPointAtLength(at);
					dense.push({ x: q.x, y: q.y });
				}
				type Box = { x0: number; x1: number; y0: number; y1: number };
				const hits = (r: Box) => {
					const m = 8;
					let n = 0;
					for (const q of dense) if (q.x > r.x0 - m && q.x < r.x1 + m && q.y > r.y0 - m && q.y < r.y1 + m) n++;
					return n;
				};
				stops.forEach((el, i) => {
					const p = stopPts[i];
					const word = el.querySelector<HTMLElement>('.stop-word')!;
					const tile = el.querySelector<HTMLElement>('.stop-tile')!.offsetWidth || 44;
					const gap = parseFloat(getComputedStyle(el.querySelector('.stop-row')!).columnGap) || 14;
					const w = word.offsetWidth;
					const h = word.offsetHeight;
					const prefer: 'left' | 'right' = p.x > W * 0.5 ? 'left' : 'right';
					const other: 'left' | 'right' = prefer === 'left' ? 'right' : 'left';
					const box = (side: 'left' | 'right', dy: number): Box =>
						side === 'right'
							? { x0: p.x + tile / 2 + gap, x1: p.x + tile / 2 + gap + w, y0: p.y - h / 2 + dy, y1: p.y + h / 2 + dy }
							: { x0: p.x - tile / 2 - gap - w, x1: p.x - tile / 2 - gap, y0: p.y - h / 2 + dy, y1: p.y + h / 2 + dy };
					const lift = h / 2 + 10;
					const tries: Array<['left' | 'right', number]> = [[prefer, 0], [other, 0], [prefer, -lift], [prefer, lift], [other, -lift], [other, lift]];
					let best = tries[0];
					let bestHits = Infinity;
					for (const t of tries) {
						const n = hits(box(t[0], t[1]));
						if (n < bestHits) {
							best = t;
							bestHits = n;
							if (n === 0) break;
						}
					}
					// the word sits to the right of the node ("node-left") or to the left of it
					el.dataset.side = best[0] === 'right' ? 'node-left' : 'node-right';
					el.style.setProperty('--wy', `${best[1].toFixed(1)}px`);
					dirs[i] = best[0] === 'right' ? -1 : 1;
				});
			}
			// each drawing takes the first spot beside its node that the line misses,
			// preferring the side away from the word
			const spots: Spot[] = [];
			if (!mobile) {
				const dense2: P[] = [];
				for (let at = 0; at <= len; at += 6) {
					const q = track.getPointAtLength(at);
					dense2.push({ x: q.x, y: q.y });
				}
				stopPts.forEach((p, i) => {
					if (!cfg.doodles.has(i)) return;
					const tries: Spot[] = [
						{ dir: dirs[i], dx: 88, dy: -46 },
						{ dir: -dirs[i], dx: 88, dy: -46 },
						{ dir: dirs[i], dx: 88, dy: 50 },
						{ dir: -dirs[i], dx: 88, dy: 50 },
						{ dir: dirs[i], dx: 150, dy: -46 },
						{ dir: -dirs[i], dx: 150, dy: -46 },
					];
					let best = tries[0];
					let bestHits = Infinity;
					for (const t of tries) {
						const cx = p.x + t.dir * (t.dx + 30);
						const cy = p.y + t.dy;
						let n = 0;
						for (const q of dense2) if (Math.abs(q.x - cx) < 52 && Math.abs(q.y - cy) < 52) n++;
						if (n < bestHits) {
							best = t;
							bestHits = n;
							if (n === 0) break;
						}
					}
					spots[i] = best;
				});
			}
			drawDoodles(cfg, stopPts, spots);

			const movePen = (p: number) => {
				const pt = prog.getPointAtLength(p * len);
				pen.setAttribute('cx', pt.x.toFixed(1));
				pen.setAttribute('cy', pt.y.toFixed(1));
			};

			// finished state: used when motion is off
			prog.style.strokeDasharray = '1';
			prog.style.strokeDashoffset = '0';
			movePen(1);
			legend.forEach((li) => li.classList.add('is-done'));
			stops.forEach((el) => el.classList.add('is-reached'));
			setDoodles(() => true);

			if (reduceMotion) {
				// no scroll story to follow, so every explanation stays open
				stops.forEach((el) => el.classList.add('is-current'));
				return;
			}

			ctx = gsap.context(() => {
				const parts = (el: HTMLElement) => ({
					dot: el.querySelector('.stop-dot')!,
					n: el.querySelector('.stop-n')!,
					icon: el.querySelector('.stop-tile')!,
					word: el.querySelector('.stop-word')!,
					desc: el.querySelector('.stop-desc')!,
				});

				gsap.set(prog, { strokeDashoffset: 1 });
				gsap.set(pen, { opacity: 0 });
				legend.forEach((li) => li.classList.remove('is-done'));
				stops.forEach((el) => el.classList.remove('is-reached', 'is-current'));

				// the legend lights up as the line passes each step; the newest
				// step reached is "current" and keeps its explanation open
				let tlRef: gsap.core.Timeline | null = null;
				const paint = () => {
					if (!tlRef) return;
					const p = tlRef.progress();
					let cur = -1;
					stops.forEach((el, i) => {
						const reached = p >= frac[i] - 0.01;
						el.classList.toggle('is-reached', reached);
						legend[i].classList.toggle('is-done', reached);
						if (reached) cur = i;
					});
					stops.forEach((el, i) => el.classList.toggle('is-current', i === cur));
					setDoodles((i) => stops[i].classList.contains('is-reached'));
					setSticky(cur);
					legend.forEach((li, i) => {
						li.classList.toggle('is-current', i === cur);
						const btn = li.querySelector('.legend-btn');
						if (i === cur) btn?.setAttribute('aria-current', 'step');
						else btn?.removeAttribute('aria-current');
					});
				};

				// The timeline is driven by hand: scroll sets where it should be, and a
				// short ease carries it there. Arriving at the section also draws the line
				// as far as the first step on its own, so the path is never an empty void.
				const tl = gsap.timeline({ defaults: { ease: 'none' }, paused: true, onUpdate: paint });
				tlRef = tl;
				let target = 0;
				let shown = 0;
				const floor = { v: 0 };
				const drive = ScrollTrigger.create({
					trigger: wrap,
					start: 'top 92%',
					end: 'bottom 88%',
					invalidateOnRefresh: true,
					onUpdate: (self) => (target = self.progress),
					onRefresh: (self) => (target = self.progress),
				});
				scrollFor = (i) => drive.start + Math.min(1, frac[i] + 0.012) * (drive.end - drive.start);
				const tick = () => {
					const goal = Math.max(target, floor.v);
					const k = 1 - Math.pow(0.9, Math.min(gsap.ticker.deltaRatio(), 4));
					shown += (goal - shown) * k;
					if (Math.abs(goal - shown) < 0.0002) shown = goal;
					tl.progress(shown);
				};
				gsap.ticker.add(tick);
				stopTick = () => gsap.ticker.remove(tick);
				ScrollTrigger.create({
					trigger: section,
					start: 'top 90%',
					once: true,
					onEnter: () => gsap.to(floor, { v: Math.min(frac[0] + 0.04, 0.16), duration: 1.6, delay: 0.3, ease: 'power2.out' }),
				});

				// the line draws itself, and a dot rides its tip
				tl.to(prog, { strokeDashoffset: 0, duration: 1 }, 0);
				const head = { p: 0 };
				tl.to(head, { p: 1, duration: 1, onUpdate: () => movePen(head.p) }, 0);
				tl.fromTo(pen, { opacity: 0 }, { opacity: 1, duration: 0.02 }, 0);
				tl.to(pen, { opacity: 0, duration: 0.03 }, 0.97);

				// each stop opens as the line reaches it
				stops.forEach((el, i) => {
					const o = parts(el);
					const at = Math.max(0, frac[i] - 0.035);
					gsap.set([o.dot, o.n, o.icon, o.word], { opacity: 0 });
					tl.fromTo(o.dot, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.04, ease: 'back.out(3)' }, at);
					tl.fromTo(o.n, { opacity: 0, x: -8 }, { opacity: 1, x: 0, duration: 0.04, ease: 'power2.out' }, at + 0.005);
					tl.fromTo(o.icon, { scale: 0, rotation: -30, opacity: 0 }, { scale: 1, rotation: -4, opacity: 1, duration: 0.06, ease: 'back.out(2.5)' }, at + 0.01);
					tl.fromTo(o.word, { opacity: 0 }, { opacity: 1, duration: 0.01 }, at + 0.01);
					tl.fromTo(
						o.word.querySelectorAll('.ch'),
						{ y: 34, opacity: 0, rotate: 7 },
						{ y: 0, opacity: 1, rotate: 0, duration: 0.05, stagger: 0.006, ease: 'back.out(1.6)' },
						at + 0.01,
					);
				});
			}, wrap);
		};

		build();

		// rebuild when the available width changes (not on every height change,
		// which would fire constantly with mobile address bars)
		let timer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(timer);
			timer = setTimeout(() => {
				if (Math.abs(wrap.clientWidth - width) > 1) {
					build();
					ScrollTrigger.refresh();
				}
			}, 200);
		});
	}
</script>

