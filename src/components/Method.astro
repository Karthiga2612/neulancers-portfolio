---
// The seven steps. Layout and the trail follow Animorio's "Stars along the
// trail" (free to use on your own site: https://animorio.com/en/license/);
// GSAP keeps its own licence.
//
// Each step has a large step number with a small line drawing beside it that
// draws itself as the step arrives. The number of the step you are on lights up.
const steps = [
	{
		label: 'Why?',
		desc: 'Before anything else, we ask why this needs to exist at all.',
		icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1 1-1.1 1.8M12 17h.01"/>',
	},
	{
		label: 'Problem',
		desc: "We sit with the real problem, not the version that's easy to solve.",
		icon: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
	},
	{
		label: 'Think',
		desc: 'No tools yet. Just people, a whiteboard, and hard questions.',
		icon: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>',
	},
	{
		label: 'Experiment',
		desc: 'Small, fast, disposable attempts — most of which will fail on purpose.',
		icon: '<path d="M9 3h6M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2.2h12.4A1.5 1.5 0 0 0 19.5 19L14 9V3"/><path d="M7.5 15h9"/>',
	},
	{
		label: 'Build',
		desc: 'What survives the experiments gets built for real.',
		icon: '<path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9L12 3Z"/><path d="M12 12 3.5 7.5M12 12l8.5-4.5M12 12v9"/>',
	},
	{
		label: 'Connect',
		desc: 'Wired into the systems and people that already exist — not replacing them.',
		icon: '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/>',
	},
	{
		label: 'Scale',
		desc: 'Once it works for one team, we make it work for everyone.',
		icon: '<path d="M4 20 20 4M20 4h-7M20 4v7"/>',
	},
];
const total = String(steps.length).padStart(2, '0');
---

<section class="method" id="method" aria-labelledby="method-title">
	<div class="method-bg" aria-hidden="true">
		<span class="bg-well bg-well--a"></span>
		<span class="bg-well bg-well--b"></span>
		<span class="bg-well bg-well--c"></span>
	</div>

	<div class="method-inner">
		<div class="method-head">
			<div class="method-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">05</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The Neulancers Method</span>
			</div>

			<h2 class="method-heading reveal" id="method-title" style="--reveal-order: 1">We don&rsquo;t start with technology.</h2>
			<p class="method-sub reveal" style="--reveal-order: 2">Seven steps, in this order. Follow the trail.</p>
			<ol class="method-legend reveal" style="--reveal-order: 3" aria-label="Jump to a step">
				{steps.map((step, i) => (
					<li data-index={i}><button type="button" class="legend-btn"><span>{`0${i + 1}`}</span>{step.label}</button></li>
				))}
			</ol>
		</div>

		<div class="mt" id="methodPath" data-trail-wrap>
			<svg class="trail-svg" data-trail-svg aria-hidden="true" focusable="false">
				<defs>
					<symbol id="mtStar" viewBox="-10 -10 20 20"><path d="M0 -10C1.2 -2.5 2.5 -1.2 10 0C2.5 1.2 1.2 2.5 0 10C-1.2 2.5 -2.5 1.2 -10 0C-2.5 -1.2 -1.2 -2.5 0 -10Z"/></symbol>
					<symbol id="mtFlower" viewBox="-10 -10 20 20"><circle cx="0.00" cy="-4.90" r="4.3"/><circle cx="4.66" cy="-1.51" r="4.3"/><circle cx="2.88" cy="3.96" r="4.3"/><circle cx="-2.88" cy="3.96" r="4.3"/><circle cx="-4.66" cy="-1.51" r="4.3"/><circle r="3.4"/></symbol>
					<symbol id="mtRing" viewBox="-10 -10 20 20"><path d="M0 -9A9 9 0 1 1 0 9A9 9 0 1 1 0 -9ZM0 -4.5A4.5 4.5 0 1 0 0 4.5A4.5 4.5 0 1 0 0 -4.5Z" fill-rule="evenodd"/></symbol>
					<symbol id="mtKite" viewBox="-10 -10 20 20"><path d="M0 -10L7 -1.5L0 10L-7 -1.5Z"/></symbol>
					<symbol id="mtDrop" viewBox="-10 -10 20 20"><path d="M0 -10C4 -4 7.5 -0.5 7.5 3A7.5 7.5 0 0 1 -7.5 3C-7.5 -0.5 -4 -4 0 -10Z"/></symbol>
				</defs>
				<path class="trail-line" data-trail-line d="M0 0"/>
				<g class="trail-shapes" data-trail-shapes></g>
			</svg>

			<ol class="steps">
				{steps.map((step, i) => (
					<li class={`step ${i % 2 === 0 ? 'step--left' : 'step--right'}`} data-step data-side={i % 2 === 0 ? 'left' : 'right'}>
						<div class="vis" aria-hidden="true">
							<span class="vis-num">{`0${i + 1}`}</span>
							<svg class="vis-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon}></svg>
						</div>
						<h3 class="step__title">{step.label}</h3>
						<p class="step__meta">{`Step 0${i + 1} of ${total}`}</p>
						<p class="step__text">{step.desc}</p>
					</li>
				))}
			</ol>
		</div>

		<div class="method-end reveal" style="--reveal-order: 0">
			<p class="method-footer">Technology is usually the last part of the conversation.</p>
			<a href="#contact" class="method-cta">
				<span>Bring us a problem</span>
				<span class="cta-arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

	/* Stars along the trail, after Animorio (free on your own sites:
	   https://animorio.com/en/license/; GSAP keeps its own licence).
	   An invisible trail winds between the steps. The scroll moves one number
	   from 0 to 1; every shape asks MotionPathPlugin where on the trail that
	   number, less its place in the train, falls, so the shapes start bunched up
	   and end strung out along the whole way. */

	/* ---- values to change ---- */
	const COUNT = 24; // how many shapes travel along the trail
	const SIZE = [26, 20]; // their size in pixels, on a computer and on a phone
	// where the trip starts and ends: a point of the section meets a point of the
	// screen. It starts as soon as the first step is coming into view (the demo
	// waited until a fifth of the way down, which for seven steps is around step 4)
	const TRAIL = ['top 80%', 'bottom 55%'];
	const SPIN = 540; // how many degrees each shape turns on its way down
	const SWING = 0.26; // how far from the middle the trail swings, as a share of the width

	gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

	const section = document.getElementById('method');
	const wrap = document.querySelector<HTMLElement>('[data-trail-wrap]');
	const svg = document.querySelector<SVGSVGElement>('[data-trail-svg]');
	const line = document.querySelector<SVGPathElement>('[data-trail-line]');
	const group = document.querySelector<SVGGElement>('[data-trail-shapes]');

	if (section && wrap && svg && line && group) {
		const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const steps = Array.from(wrap.querySelectorAll<HTMLElement>('[data-step]'));
		const legend = Array.from(section.querySelectorAll<HTMLElement>('.method-legend li'));
		const NS = 'http://www.w3.org/2000/svg';
		const SHAPES = ['mtStar', 'mtFlower', 'mtRing', 'mtKite', 'mtDrop'];

		// ---------- entrance for the heading block ----------
		const revealEls = Array.from(section.querySelectorAll<HTMLElement>('.reveal'));
		if (REDUCED || !('IntersectionObserver' in window)) {
			revealEls.forEach((el) => el.classList.add('is-visible'));
		} else {
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}),
				{ threshold: 0.15 },
			);
			revealEls.forEach((el) => io.observe(el));
		}

		// ---------- the shapes ----------
		const shapes: SVGUseElement[] = [];
		for (let i = 0; i < COUNT; i += 1) {
			const u = document.createElementNS(NS, 'use');
			u.setAttribute('href', `#${SHAPES[i % SHAPES.length]}`);
			group.appendChild(u);
			shapes.push(u);
		}

		// ---------- the trail ----------
		// a point at the top in the middle, one beside every step on the other
		// side from its words, one at the bottom in the middle; then a smooth
		// curve through them (each piece leans towards the points before and after it)
		let raw: unknown = null;
		let size = SIZE[0];
		const trail = () => {
			const box = wrap.getBoundingClientRect();
			const w = box.width;
			const h = box.height;
			const phone = window.innerWidth <= 720;
			size = phone ? SIZE[1] : SIZE[0];
			svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
			const pts: Array<[number, number]> = [[w / 2, 0]];
			steps.forEach((p, i) => {
				const r = p.getBoundingClientRect();
				const left = p.dataset.side === 'left';
				const swing = phone ? (i % 2 ? -1 : 1) * SWING * 1.4 : (left ? 1 : -1) * SWING;
				pts.push([w * (0.5 + swing), r.top - box.top + r.height / 2]);
			});
			pts.push([w / 2, h]);
			let d = `M${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
			for (let i = 0; i < pts.length - 1; i += 1) {
				const a = pts[Math.max(0, i - 1)];
				const b = pts[i];
				const c = pts[i + 1];
				const e = pts[Math.min(pts.length - 1, i + 2)];
				const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];
				const c2 = [c[0] - (e[0] - b[0]) / 6, c[1] - (e[1] - b[1]) / 6];
				d += `C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${c[0].toFixed(1)} ${c[1].toFixed(1)}`;
			}
			line.setAttribute('d', d);
			raw = MotionPathPlugin.getRawPath(line);
			MotionPathPlugin.cacheRawPathMeasurements(raw as never);
		};

		const journey = { progress: 0 };
		const place = () => {
			if (!raw) return;
			const gap = 1 / COUNT;
			shapes.forEach((u, i) => {
				const p = Math.max(0, Math.min(0.999, journey.progress - i * gap));
				// a shape that has not had its turn yet stays hidden instead of
				// waiting in a pile at the entrance, so the train comes in one by one
				u.style.opacity = journey.progress - i * gap > 0 ? '1' : '0';
				const at = MotionPathPlugin.getPositionOnPath(raw as never, p) as { x: number; y: number };
				u.setAttribute('width', String(size));
				u.setAttribute('height', String(size));
				u.setAttribute('x', (-size / 2).toFixed(1));
				u.setAttribute('y', (-size / 2).toFixed(1));
				u.setAttribute('transform', `translate(${at.x.toFixed(1)} ${at.y.toFixed(1)}) rotate(${(p * SPIN).toFixed(1)})`);
			});
		};

		// ---------- the current step ----------
		// the last step whose top has risen above 62% of the screen, worked out
		// from positions so it is right even after a jump
		let shownStep = -2;
		const setCurrent = (cur: number) => {
			if (cur === shownStep) return;
			shownStep = cur;
			legend.forEach((li, i) => {
				li.classList.toggle('is-done', i <= cur);
				li.classList.toggle('is-current', i === cur);
				const btn = li.querySelector('.legend-btn');
				if (i === cur) btn?.setAttribute('aria-current', 'step');
				else btn?.removeAttribute('aria-current');
			});
			steps.forEach((s, i) => {
				s.classList.toggle('is-current', i === cur);
				s.classList.toggle('is-past', i < cur);
			});
		};
		const findCurrent = () => {
			let cur = -1;
			steps.forEach((s, i) => {
				if (s.getBoundingClientRect().top < window.innerHeight * 0.62) cur = i;
			});
			setCurrent(cur);
		};

		// legend buttons jump to their step
		legend.forEach((li, i) =>
			li.querySelector('button')?.addEventListener('click', () => {
				const r = steps[i].getBoundingClientRect();
				window.scrollTo({ top: window.scrollY + r.top - window.innerHeight * 0.35, behavior: REDUCED ? 'auto' : 'smooth' });
			}),
		);

		// ---------- the drawings draw themselves as their step arrives ----------
		steps.forEach((s) => {
			const kids = Array.from(s.querySelectorAll<SVGElement>('.vis-icon > *'));
			kids.forEach((k) => {
				k.setAttribute('pathLength', '1');
				k.style.strokeDasharray = '1';
				k.style.strokeDashoffset = REDUCED ? '0' : '1';
			});
			if (!REDUCED) {
				ScrollTrigger.create({
					trigger: s,
					start: 'top 82%',
					once: true,
					onEnter: () => gsap.to(kids, { strokeDashoffset: 0, duration: 1, ease: 'power2.out', stagger: 0.14 }),
				});
			}
		});

		// ---------- start ----------
		const start = () => {
			trail();
			if (REDUCED) {
				// nothing travels: the shapes are already strung out along the whole trail
				journey.progress = 1;
				place();
				findCurrent();
				gsap.from(group, { opacity: 0, duration: 0.6, ease: 'power1.out' });
				return;
			}
			place();
			gsap.to(journey, {
				progress: 1,
				ease: 'none',
				onUpdate: place,
				scrollTrigger: { trigger: wrap, start: TRAIL[0], end: TRAIL[1], scrub: true, invalidateOnRefresh: true },
			});
			ScrollTrigger.create({
				trigger: wrap,
				start: 'top bottom',
				end: 'bottom top',
				onUpdate: findCurrent,
				onRefresh: findCurrent,
			});
			ScrollTrigger.addEventListener('refreshInit', trail);
			findCurrent();
		};

		if (document.fonts && document.fonts.ready) document.fonts.ready.then(start, start);
		else start();
	}
</script>

<style>
	.method {
		--accent-bright: #a78bfa;
		--mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
		overflow: hidden;
	}

	/* ---------- atmosphere: the hero's soft wells and faint rings ---------- */
	.method-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.bg-well {
		position: absolute;
		width: min(120vw, 1300px);
		aspect-ratio: 1.6;
		translate: -50% -50%;
		background: radial-gradient(ellipse at center, rgba(109, 40, 217, 0.2), rgba(109, 40, 217, 0.05) 38%, transparent 66%);
	}

	.bg-well::after {
		content: '';
		position: absolute;
		inset: -12%;
		border-radius: 50%;
		background: repeating-radial-gradient(ellipse at center, transparent 0 78px, rgba(255, 255, 255, 0.03) 78px 79px);
		-webkit-mask-image: radial-gradient(ellipse at center, #000 10%, transparent 62%);
		mask-image: radial-gradient(ellipse at center, #000 10%, transparent 62%);
	}

	.bg-well--a {
		left: 78%;
		top: 22%;
	}

	.bg-well--b {
		left: 22%;
		top: 52%;
	}

	.bg-well--c {
		left: 70%;
		top: 82%;
	}

	.method-inner {
		position: relative;
		z-index: 1;
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(72px, 9vw, 112px) clamp(20px, 4vw, 32px) clamp(72px, 9vw, 112px);
	}

	/* ---------- entrance ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 80ms);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: none;
	}

	.method-head {
		margin-bottom: clamp(1.5rem, 4vw, 3rem);
	}

	.method-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.9rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent-bright);
	}

	.method-heading {
		margin: 0 0 0.7rem;
		max-width: 18ch;
		font-size: clamp(2rem, 2.6vw + 1.1rem, 3.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
		text-wrap: balance;
	}

	.method-sub {
		margin: 0 0 1.4rem;
		font-size: 1rem;
		color: rgba(243, 243, 241, 0.7);
	}

	/* the seven steps as a quiet legend; each lights up as the line reaches it */
	.method-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.method-legend li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(243, 243, 241, 0.5);
		transition: color 0.4s ease;
	}

	.legend-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.2rem 0;
		background: none;
		border: 0;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		color: inherit;
		cursor: pointer;
	}

	.legend-btn:hover {
		color: var(--ink);
	}

	.legend-btn:focus-visible {
		outline: 2px solid var(--accent-bright);
		outline-offset: 3px;
		border-radius: 4px;
	}

	.method-legend li {
		gap: 0;
	}

	.method-legend li::before {
		margin-right: 0.5rem;
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.22);
		transition: background-color 0.4s ease, box-shadow 0.4s ease;
	}

	.method-legend li span {
		color: inherit;
		opacity: 0.7;
	}

	.method-legend li.is-done {
		color: var(--ink);
	}

	.method-legend li.is-done::before {
		background: var(--accent-bright);
		box-shadow: 0 0 10px rgba(167, 139, 250, 0.7);
	}

	/* the step you are on: brighter, with a ring round its dot */
	.method-legend li.is-current {
		color: var(--ink);
	}

	.method-legend li.is-current span {
		opacity: 1;
	}

	.method-legend li.is-current::before {
		background: var(--accent-bright);
		box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.28), 0 0 12px rgba(167, 139, 250, 0.8);
	}

	/* ---------- the trail ----------
	   The steps sit in two columns, one on the left and the next on the right.
	   Behind them an svg as big as the whole list holds an invisible trail, drawn
	   by the script between the steps, and the little shapes that travel along it. */
	.method {
		/* the shapes on the trail, in turn, lifted for a dark page */
		--shape-1: #ff6b81;
		--shape-2: #ffc247;
		--shape-3: #3fd0be;
		--shape-4: #a78bfa;
		--shape-5: #f3f3f1;
		--accent-soft: #8f7df0;
	}

	.mt {
		position: relative;
		padding: clamp(0.5rem, 2vh, 1.5rem) 0 10vh;
	}

	.trail-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.trail-line {
		fill: none;
		stroke: none;
	}

	/* the shapes are made by the script, so they carry no component attribute */
	.mt :global(.trail-shapes use:nth-of-type(5n + 1)) {
		fill: var(--shape-1);
	}

	.mt :global(.trail-shapes use:nth-of-type(5n + 2)) {
		fill: var(--shape-2);
	}

	.mt :global(.trail-shapes use:nth-of-type(5n + 3)) {
		fill: var(--shape-3);
	}

	.mt :global(.trail-shapes use:nth-of-type(5n + 4)) {
		fill: var(--shape-4);
	}

	.mt :global(.trail-shapes use:nth-of-type(5n + 5)) {
		fill: var(--shape-5);
	}

	.steps {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		row-gap: clamp(64px, 15vh, 170px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.step {
		max-width: 30em;
	}

	/* one step per row, so the trail can swing from side to side between them */
	.step:nth-child(1) { grid-row: 1; }
	.step:nth-child(2) { grid-row: 2; }
	.step:nth-child(3) { grid-row: 3; }
	.step:nth-child(4) { grid-row: 4; }
	.step:nth-child(5) { grid-row: 5; }
	.step:nth-child(6) { grid-row: 6; }
	.step:nth-child(7) { grid-row: 7; }

	.step--left {
		grid-column: 1;
	}

	.step--right {
		grid-column: 2;
		justify-self: end;
		text-align: right;
	}

	/* ---------- the step mark: big number and line drawing ---------- */
	.vis {
		display: flex;
