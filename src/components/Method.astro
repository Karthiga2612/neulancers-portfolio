---
const steps = [
	{ label: 'Why?', desc: 'Before anything else, we ask why this needs to exist at all.' },
	{ label: 'Problem', desc: "We sit with the real problem, not the version that's easy to solve." },
	{ label: 'Think', desc: 'No tools yet. Just people, a whiteboard, and hard questions.' },
	{ label: 'Experiment', desc: 'Small, fast, disposable attempts — most of which will fail on purpose.' },
	{ label: 'Build', desc: 'What survives the experiments gets built for real.' },
	{ label: 'Connect', desc: 'Wired into the systems and people that already exist — not replacing them.' },
	{ label: 'Scale', desc: 'Once it works for one team, we make it work for everyone.' },
];
---

<section class="method" id="method">
	<div class="method-inner">
		<div class="method-eyebrow">
			<span class="eyebrow-idx">04</span>
			<span class="eyebrow-line" aria-hidden="true"></span>
			<span class="eyebrow-label">The Neulancers Method</span>
		</div>

		<h2 class="method-heading">We don&rsquo;t start with technology.</h2>

		<div class="method-list" id="methodList">
			{steps.map((step, i) => (
				<div class="method-step" data-index={i}>
					<button
						type="button"
						class="step-trigger"
						id={`step-trigger-${i}`}
						aria-expanded={i === 0 ? 'true' : 'false'}
						aria-controls={`step-panel-${i}`}
					>
						<span class="step-rail" aria-hidden="true">
							<span class="step-dot"></span>
							{i < steps.length - 1 && <span class="step-line"></span>}
						</span>
						<span class="step-idx">{`0${i + 1}`}</span>
						<span class="step-label">{step.label}</span>
						<svg class="step-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="m6 9 6 6 6-6"/>
						</svg>
					</button>

					<div class={`step-panel${i === 0 ? ' is-open' : ''}`} id={`step-panel-${i}`} role="region" aria-labelledby={`step-trigger-${i}`}>
						<div class="step-panel-inner">
							<p class="step-desc">{step.desc}</p>
						</div>
					</div>
				</div>
			))}
		</div>

		<p class="method-footer">Technology is usually the last part of the conversation.</p>
	</div>
</section>

<style>
	.method {
		--ink: #f3f3f1;
		--muted: #8b929d;
		--ink-faint: rgba(139, 146, 157, 0.75);
		--border-soft: rgba(255, 255, 255, 0.1);
		--accent: #6d28d9;
		--bg: #0a0a0d;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	.method-inner {
		max-width: 900px;
		margin: 0 auto;
		padding: clamp(72px, 10vw, 128px) clamp(20px, 4vw, 32px);
	}

	.method-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.eyebrow-idx {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.eyebrow-line {
		width: 32px;
		height: 1px;
		background: var(--border-soft);
	}

	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.method-heading {
		margin: 0 0 3rem;
		font-size: clamp(1.8rem, 1.3vw + 1.6rem, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		max-width: 18ch;
	}

	/* ---------- accordion timeline ---------- */
	.method-list {
		border-top: 1px solid var(--border-soft);
	}

	.method-step {
		border-bottom: 1px solid var(--border-soft);
	}

	.step-trigger {
		display: flex;
		align-items: center;
		gap: clamp(0.9rem, 2vw, 1.5rem);
		width: 100%;
		padding: clamp(1.1rem, 2vw, 1.5rem) 0.25rem;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		font-family: inherit;
		color: var(--ink);
	}

	.step-rail {
		position: relative;
		flex-shrink: 0;
		display: flex;
		justify-content: center;
		width: 12px;
		align-self: stretch;
	}

	.step-dot {
		position: absolute;
		top: 0.4rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--bg);
		border: 1.5px solid var(--border-soft);
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	.step-line {
		position: absolute;
		top: 1.1rem;
		bottom: -1.5rem;
		width: 1px;
		background: var(--border-soft);
	}

	.step-trigger[aria-expanded='true'] .step-dot {
		background: var(--accent);
		border-color: var(--accent);
	}

	.step-idx {
		flex-shrink: 0;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.78rem;
		color: var(--ink-faint);
	}

	.step-label {
		flex: 1;
		font-size: clamp(1.15rem, 0.6vw + 1.05rem, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.005em;
		color: var(--muted);
		transition: color 0.2s ease;
	}

	.step-trigger[aria-expanded='true'] .step-label {
		color: var(--ink);
	}

	.step-chevron {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		color: var(--ink-faint);
		transition: transform 0.3s ease, color 0.2s ease;
	}

	.step-trigger[aria-expanded='true'] .step-chevron {
		color: var(--accent);
		transform: rotate(180deg);
	}

	.step-trigger:hover .step-label {
		color: var(--ink);
	}

	.step-panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.35s ease;
	}

	.step-panel.is-open {
		grid-template-rows: 1fr;
	}

	.step-panel-inner {
		overflow: hidden;
	}

	.step-desc {
		margin: 0;
		padding: 0 0.25rem 1.4rem calc(12px + clamp(0.9rem, 2vw, 1.5rem) + 2.2rem);
		max-width: 46ch;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.method-footer {
		margin: 3rem 0 0;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}

	@media (max-width: 560px) {
		.step-desc {
			padding-left: 0.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.step-panel,
		.step-chevron,
		.step-dot,
		.step-label {
			transition: none;
		}
	}
</style>

<script>
	const list = document.getElementById('methodList');
	const triggers = Array.from(document.querySelectorAll('.step-trigger')) as HTMLButtonElement[];

	list?.addEventListener('click', (event) => {
		const trigger = (event.target as HTMLElement).closest('.step-trigger') as HTMLButtonElement | null;
		if (!trigger) return;

		const isOpen = trigger.getAttribute('aria-expanded') === 'true';
		const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');

		triggers.forEach((t) => {
			t.setAttribute('aria-expanded', 'false');
			const p = document.getElementById(t.getAttribute('aria-controls') ?? '');
			p?.classList.remove('is-open');
		});

		if (!isOpen) {
			trigger.setAttribute('aria-expanded', 'true');
			panel?.classList.add('is-open');
		}
	});
</script>
