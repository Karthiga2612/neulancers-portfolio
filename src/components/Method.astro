---
// each step: the big word, one sentence, and a small line icon (24 grid)
const steps = [
	{
		label: 'Why?',
		desc: 'Before anything else, we ask why this needs to exist at all.',
		icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1 1-1.1 1.8M12 17h.01"/>',
	},
	{
		label: 'Problem',
		desc: "We sit with the real problem, not the version that's easy to solve.",
		icon: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
	},
	{
		label: 'Think',
		desc: 'No tools yet. Just people, a whiteboard, and hard questions.',
		icon: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>',
	},
	{
		label: 'Experiment',
		desc: 'Small, fast, disposable attempts — most of which will fail on purpose.',
		icon: '<path d="M9 3h6M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2.2h12.4A1.5 1.5 0 0 0 19.5 19L14 9V3"/><path d="M7.5 15h9"/>',
	},
	{
		label: 'Build',
		desc: 'What survives the experiments gets built for real.',
		icon: '<path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9L12 3Z"/><path d="M12 12 3.5 7.5M12 12l8.5-4.5M12 12v9"/>',
	},
	{
		label: 'Connect',
		desc: 'Wired into the systems and people that already exist — not replacing them.',
		icon: '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/>',
	},
	{
		label: 'Scale',
		desc: 'Once it works for one team, we make it work for everyone.',
		icon: '<path d="M4 20 20 4M20 4h-7M20 4v7"/>',
	},
];
---

<section class="method" id="method" aria-labelledby="method-title">
	<div class="method-bg" aria-hidden="true">
		<span class="bg-well bg-well--a"></span>
		<span class="bg-well bg-well--b"></span>
		<span class="bg-well bg-well--c"></span>
	</div>

	<div class="method-inner">
		<div class="method-head">
			<div class="method-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">05</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">The Neulancers Method</span>
			</div>

			<h2 class="method-heading reveal" id="method-title" style="--reveal-order: 1">We don&rsquo;t start with technology.</h2>
			<p class="method-sub reveal" style="--reveal-order: 2">Seven steps, in this order. Follow the line<span class="sub-hint">, and hover any step to read it again</span>.</p>
			<ol class="method-legend reveal" style="--reveal-order: 3" aria-label="Jump to a step">
				{steps.map((step, i) => (
					<li data-index={i}><button type="button" class="legend-btn"><span>{`0${i + 1}`}</span>{step.label}</button></li>
				))}
			</ol>
		</div>

		<div class="mp" id="methodPath">
			<svg class="mp-svg" aria-hidden="true" fill="none">
				<defs>
					<linearGradient id="mpGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color="#c4b5fd"></stop>
						<stop offset="1" stop-color="#7c3aed"></stop>
					</linearGradient>
				</defs>
				<path class="mp-track"></path>
				<path class="mp-prog"></path>
				<g class="mp-cap mp-cap--start"><circle class="cap-shadow" r="16"></circle><circle class="cap-dot" r="8"></circle></g>
				<g class="mp-cap mp-cap--end"><circle class="cap-shadow" r="16"></circle><circle class="cap-dot" r="8"></circle></g>
				<circle class="mp-pen" r="7"></circle>
			</svg>

			<ol class="mp-stops">
				{steps.map((step, i) => (
					<li class="stop" data-index={i}>
						<span class="stop-dot" aria-hidden="true"></span>
						<div class="stop-body">
							<p class="stop-n">{`0${i + 1}`}</p>
							<div class="stop-row" tabindex="0">
								<h3 class="stop-word">{step.label}</h3>
								<span class="stop-tile" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon}></svg>
								</span>
							</div>
							<div class="stop-desc">
								<p class="card-kicker"><span>{`Step 0${i + 1}`}</span><i aria-hidden="true"></i><span>{step.label.replace('?', '')}</span></p>
								<p class="card-text">{step.desc}</p>
								<ol class="card-dots" aria-hidden="true">
									{steps.map((_, k) => (
										<li class:list={[k < i && 'is-past', k === i && 'is-now']}></li>
									))}
								</ol>
							</div>
						</div>
					</li>
				))}
			</ol>
		</div>

		<div class="method-end reveal" style="--reveal-order: 0">
			<p class="method-footer">Technology is usually the last part of the conversation.</p>
			<a href="#contact" class="method-cta">
				<span>Bring us a problem</span>
				<span class="cta-arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const section = document.getElementById('method');
	const wrap = document.getElementById('methodPath');

	if (section && wrap) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const svg = wrap.querySelector<SVGSVGElement>('.mp-svg')!;
		const track = wrap.querySelector<SVGPathElement>('.mp-track')!;
		const prog = wrap.querySelector<SVGPathElement>('.mp-prog')!;
		const pen = wrap.querySelector<SVGCircleElement>('.mp-pen')!;
		const stops = Array.from(wrap.querySelectorAll<HTMLElement>('.stop'));
		const legend = Array.from(section.querySelectorAll<HTMLElement>('.method-legend li'));
		const N = stops.length;

		// ---------- entrance for the heading block ----------
		const revealEls = Array.from(section.querySelectorAll<HTMLElement>('.reveal'));
		if (reduceMotion || !('IntersectionObserver' in window)) {
			revealEls.forEach((el) => el.classList.add('is-visible'));
		} else {
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}),
				{ threshold: 0.15 },
			);
			revealEls.forEach((el) => io.observe(el));
		}

		// legend buttons jump to their step
		let stopY: number[] = [];
		section.querySelectorAll<HTMLButtonElement>('.legend-btn').forEach((btn, i) =>
			btn.addEventListener('click', () => {
				const y = wrap.getBoundingClientRect().top + window.scrollY + (stopY[i] ?? 0) - window.innerHeight * 0.4;
				window.scrollTo({ top: y, behavior: reduceMotion ? 'auto' : 'smooth' });
			}),
		);

		// the glow behind the line drifts a little against the scroll
		if (!reduceMotion) {
			gsap.to(section.querySelectorAll('.bg-well'), {
				yPercent: (i: number) => (i % 2 ? -10 : 10),
				ease: 'none',
				scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: true },
			});
		}

		// a smooth curve through the points. Each segment's handles are one third
		// of that segment's own length, pointing along the local direction, so
		// uneven point spacing (a long line next to a tight loop) can't make the
		// curve overshoot into little hooks.
		type P = { x: number; y: number };
		const curve = (p: P[]) => {
			const dir = (a: P, b: P) => {
				const l = Math.hypot(b.x - a.x, b.y - a.y) || 1;
				return { x: (b.x - a.x) / l, y: (b.y - a.y) / l };
			};
			let d = `M${p[0].x.toFixed(1)} ${p[0].y.toFixed(1)}`;
			for (let k = 0; k < p.length - 1; k++) {
				const p1 = p[k];
				const p2 = p[k + 1];
				const t1 = dir(p[k - 1] ?? p1, p2);
				const t2 = dir(p1, p[k + 2] ?? p2);
				const h = Math.hypot(p2.x - p1.x, p2.y - p1.y) / 3;
				d += ` C${(p1.x + t1.x * h).toFixed(1)} ${(p1.y + t1.y * h).toFixed(1)} ${(p2.x - t2.x * h).toFixed(1)} ${(p2.y - t2.y * h).toFixed(1)} ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
			}
			return d;
		};

		// a loop-the-loop in the line between two stops: the line runs straight,
		// curls once round a circle (drifting forward a little so it crosses
		// itself) and carries on, all sitting on the line between the two stops
		const loop = (a: P, b: P, flip: number, at: number): P[] => {
			const dx = b.x - a.x;
			const dy = b.y - a.y;
			const L = Math.hypot(dx, dy);
			const u = { x: dx / L, y: dy / L };
			const n = { x: -u.y * flip, y: u.x * flip };
			const R = Math.min(L * 0.17, 56);
			const D = R * 2.5;
			const base = { x: a.x + u.x * L * at, y: a.y + u.y * L * at };
			const out: P[] = [];
			const steps = 40;
			for (let k = 0; k <= steps; k++) {
				const th = (k / steps) * Math.PI * 2;
				const xl = R * Math.sin(th) + (D * th) / (Math.PI * 2);
				const yl = R * (1 - Math.cos(th));
				out.push({ x: base.x + u.x * xl + n.x * yl, y: base.y + u.y * xl + n.y * yl });
			}
			return out;
		};
		// loops: right after step 1, and into step 6
		const loopAfter = new Set([0, 4]);

		let ctx: gsap.Context | null = null;
		let width = 0;

		const build = () => {
			ctx?.revert();
			wrap.classList.add('is-ready');

			const W = wrap.clientWidth;
			width = W;
			const mobile = W < 700;
			wrap.classList.toggle('is-mobile', mobile);

			// the whole line is about three screens tall, so the last step arrives
			// after roughly three scrolls
			const vh = window.innerHeight;
			// three screens tall: steps 1-2 on the first screen, 3-4 on the second
			// and 5-7 on the third, as in the sketch
			const H = Math.max(mobile ? 1900 : 1600, Math.min(2 * vh, 2400));
			wrap.style.height = `${H}px`;
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			svg.setAttribute('width', String(W));
			svg.setAttribute('height', String(H));
			svg.querySelector('#mpGrad')?.setAttribute('y2', String(H));

			const right = W * (mobile ? 0.76 : 0.8);
			const left = W * (mobile ? 0.24 : 0.2);
			const plan: Array<[number, number]> = [
				[right, 0.07],
				[left, 0.205],
				[right, 0.345],
				[left, 0.49],
				[right, 0.64],
				[W * 0.34, 0.79],
				[W * (mobile ? 0.14 : 0.1), 0.92],
			];
			const stopPts: P[] = plan.map(([x, fy]) => ({ x, y: H * fy }));
			// the line comes in from the right edge of the screen and leaves by the
			// left edge (the svg overflows the page padding on purpose)
			const box = wrap.getBoundingClientRect();
			const rightGap = Math.max(0, window.innerWidth - box.right);
			const leftGap = Math.max(0, box.left);
			// every stop is passed on a diagonal aimed at its neighbours, with a
			// control point just before and after it, so the line sweeps in long
			// S-curves instead of running down vertical walls
			const near = (p: P, q: P, k: number): P => ({ x: p.x + (q.x - p.x) * k, y: p.y + (q.y - p.y) * k });
			const startPt = { x: W + rightGap - 34, y: H * 0.02 };
			const endPt = { x: -leftGap + 34, y: H * 0.955 };
			const pts: P[] = [startPt];
			stopPts.forEach((p, i) => {
				const pre = i > 0 ? near(p, stopPts[i - 1], 0.3) : null;
				const post = i < N - 1 ? near(p, stopPts[i + 1], 0.3) : null;
				if (pre) pts.push(pre);
				pts.push(p);
				if (post) {
					pts.push(post);
					const nextPre = near(stopPts[i + 1], p, 0.3);
					if (loopAfter.has(i)) {
						pts.push(...loop(post, nextPre, i % 2 === 0 ? 1 : -1, 0.5));
					} else {
						// a soft bow so the stretch between stops is a curve, not a ruler line
						const dx = nextPre.x - post.x;
						const dy = nextPre.y - post.y;
						const bow = (i % 2 === 0 ? -1 : 1) * 0.16;
						pts.push({ x: post.x + dx / 2 - dy * bow, y: post.y + dy / 2 + dx * bow });
					}
				}
			});
			pts.push(endPt);

			const d = curve(pts);
			[track, prog].forEach((path) => {
				path.setAttribute('d', d);
				path.setAttribute('pathLength', '1');
			});

			const placeCap = (sel: string, pt: P) => {
				svg.querySelectorAll<SVGCircleElement>(`${sel} circle`).forEach((c, k) => {
					c.setAttribute('cx', (pt.x + 0).toFixed(1));
					c.setAttribute('cy', (pt.y + 0).toFixed(1));
				});
			};
			placeCap('.mp-cap--start', startPt);
			placeCap('.mp-cap--end', endPt);

			stopY = stopPts.map((p) => p.y);
			stops.forEach((el, i) => {
				el.style.left = `${stopPts[i].x}px`;
				el.style.top = `${stopPts[i].y}px`;
				el.dataset.side = stopPts[i].x > W * 0.5 ? 'node-right' : 'node-left';
			});

			// where along the line each stop sits (0..1), found by sampling
			const len = track.getTotalLength();
			const samples = 1400;
			const frac = stops.map((_, i) => {
				const target = stopPts[i];
				let best = 0;
				let bestDist = Infinity;
				for (let s = 0; s <= samples; s++) {
					const pt = track.getPointAtLength((s / samples) * len);
					const dist = (pt.x - target.x) ** 2 + (pt.y - target.y) ** 2;
					if (dist < bestDist) {
						bestDist = dist;
						best = s / samples;
					}
				}
				return best;
			});

			const movePen = (p: number) => {
				const pt = prog.getPointAtLength(p * len);
				pen.setAttribute('cx', pt.x.toFixed(1));
				pen.setAttribute('cy', pt.y.toFixed(1));
			};

			// finished state: used when motion is off
			prog.style.strokeDasharray = '1';
			prog.style.strokeDashoffset = '0';
			movePen(1);
			legend.forEach((li) => li.classList.add('is-done'));
			stops.forEach((el) => el.classList.add('is-reached'));

			if (reduceMotion) {
				// no scroll story to follow, so every explanation stays open
				stops.forEach((el) => el.classList.add('is-current'));
				return;
			}

			ctx = gsap.context(() => {
				const parts = (el: HTMLElement) => ({
					dot: el.querySelector('.stop-dot')!,
					n: el.querySelector('.stop-n')!,
					icon: el.querySelector('.stop-tile')!,
					word: el.querySelector('.stop-word')!,
					desc: el.querySelector('.stop-desc')!,
				});

				gsap.set(prog, { strokeDashoffset: 1 });
				gsap.set(pen, { opacity: 0 });
				legend.forEach((li) => li.classList.remove('is-done'));
				stops.forEach((el) => el.classList.remove('is-reached', 'is-current'));

				// the legend lights up as the line passes each step; the newest
				// step reached is "current" and keeps its explanation open
				let tlRef: gsap.core.Timeline | null = null;
				const paint = () => {
					if (!tlRef) return;
					const p = tlRef.progress();
					let cur = -1;
					stops.forEach((el, i) => {
						const reached = p >= frac[i] - 0.01;
						el.classList.toggle('is-reached', reached);
						legend[i].classList.toggle('is-done', reached);
						if (reached) cur = i;
					});
					stops.forEach((el, i) => el.classList.toggle('is-current', i === cur));
					legend.forEach((li, i) => {
						li.classList.toggle('is-current', i === cur);
						const btn = li.querySelector('.legend-btn');
						if (i === cur) btn?.setAttribute('aria-current', 'step');
						else btn?.removeAttribute('aria-current');
					});
				};

				// paint runs off the timeline itself, not the scroll events: the line
				// trails the scroll by the scrub delay, so after a fast scroll or a
				// legend jump the state has to keep following the animation
				const tl = gsap.timeline({
					defaults: { ease: 'none' },
					onUpdate: paint,
					scrollTrigger: {
						trigger: wrap,
						start: 'top 92%',
						end: 'bottom 88%',
						scrub: 1.2,
						invalidateOnRefresh: true,
					},
				});
				tlRef = tl;

				// the line draws itself, and a dot rides its tip
				tl.to(prog, { strokeDashoffset: 0, duration: 1 }, 0);
				const head = { p: 0 };
				tl.to(head, { p: 1, duration: 1, onUpdate: () => movePen(head.p) }, 0);
				tl.fromTo(pen, { opacity: 0 }, { opacity: 1, duration: 0.02 }, 0);
				tl.to(pen, { opacity: 0, duration: 0.03 }, 0.97);

				// each stop opens as the line reaches it
				stops.forEach((el, i) => {
					const o = parts(el);
					const at = Math.max(0, frac[i] - 0.035);
					gsap.set([o.dot, o.n, o.icon, o.word], { opacity: 0 });
					tl.fromTo(o.dot, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.04, ease: 'back.out(3)' }, at);
					tl.fromTo(o.n, { opacity: 0, x: -8 }, { opacity: 1, x: 0, duration: 0.04, ease: 'power2.out' }, at + 0.005);
					tl.fromTo(o.icon, { scale: 0, rotation: -30, opacity: 0 }, { scale: 1, rotation: -4, opacity: 1, duration: 0.06, ease: 'back.out(2.5)' }, at + 0.01);
					tl.fromTo(o.word, { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.07, ease: 'power2.out' }, at + 0.01);
				});
			}, wrap);
		};

		build();

		// rebuild when the available width changes (not on every height change,
		// which would fire constantly with mobile address bars)
		let timer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(timer);
			timer = setTimeout(() => {
				if (Math.abs(wrap.clientWidth - width) > 1) {
					build();
					ScrollTrigger.refresh();
				}
			}, 200);
		});
	}
</script>

<style>
	.method {
		--accent-bright: #a78bfa;
		--mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
		overflow: hidden;
	}

	/* ---------- atmosphere: the hero's soft wells and faint rings ---------- */
	.method-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.bg-well {
		position: absolute;
		width: min(120vw, 1300px);
		aspect-ratio: 1.6;
		translate: -50% -50%;
		background: radial-gradient(ellipse at center, rgba(109, 40, 217, 0.2), rgba(109, 40, 217, 0.05) 38%, transparent 66%);
	}

	.bg-well::after {
		content: '';
		position: absolute;
		inset: -12%;
		border-radius: 50%;
		background: repeating-radial-gradient(ellipse at center, transparent 0 78px, rgba(255, 255, 255, 0.03) 78px 79px);
		-webkit-mask-image: radial-gradient(ellipse at center, #000 10%, transparent 62%);
		mask-image: radial-gradient(ellipse at center, #000 10%, transparent 62%);
	}

	.bg-well--a {
		left: 78%;
		top: 22%;
	}

	.bg-well--b {
		left: 22%;
		top: 52%;
	}

	.bg-well--c {
		left: 70%;
		top: 82%;
	}

	.method-inner {
		position: relative;
		z-index: 1;
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(72px, 9vw, 112px) clamp(20px, 4vw, 32px) clamp(72px, 9vw, 112px);
	}

	/* ---------- entrance ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 80ms);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: none;
	}

	.method-head {
		margin-bottom: clamp(1.5rem, 4vw, 3rem);
	}

	.method-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.9rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent-bright);
	}

	.method-heading {
		margin: 0 0 0.7rem;
		max-width: 18ch;
		font-size: clamp(2rem, 2.6vw + 1.1rem, 3.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
		text-wrap: balance;
	}

	.method-sub {
		margin: 0 0 1.4rem;
		font-size: 1rem;
		color: rgba(243, 243, 241, 0.7);
	}

	/* the seven steps as a quiet legend; each lights up as the line reaches it */
	.method-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.method-legend li {
		display: inline-flex;
		align-items: center;
