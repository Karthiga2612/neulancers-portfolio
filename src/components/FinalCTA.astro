---
// Contact: a short form on the right, the headline and a direct email on the left.
// There is no server here: sending opens the visitor's email app with the message filled in, and there are copy buttons as a fallback.
const email = 'hello@neulancers.com';
const fineprint = [
	"You don't need a specification.",
	"You don't need a technical document.",
	"Just tell us what isn't working.",
];
const topics = ['Manual work', 'Spreadsheets', 'Tools that don’t talk', 'An AI idea', 'Something else'];
const tick = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7"/></svg>';
---

<section class="final-cta" id="contact" aria-labelledby="ctaHeading">
	<div class="rings" id="rings" aria-hidden="true"><i></i><i></i></div>

	<div class="cta-inner">
		<div class="cta-left">
			<div class="cta-eyebrow" data-in>
				<span class="eyebrow-idx">12</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">Contact</span>
			</div>

			<h2 class="cta-heading" id="ctaHeading">
				<span class="line1">Got a strange problem?</span>
				<span class="heading-dim" data-in>Good. We like those.</span>
			</h2>

			<svg class="squig" viewBox="0 0 320 16" preserveAspectRatio="none" aria-hidden="true" data-in>
				<path id="squigPath" d="M0 8 L320 8" />
			</svg>

			<ul class="cta-fineprint">
				{fineprint.map((line) => (
					<li class="fine" data-in>
						<span class="fine-ico" set:html={tick} aria-hidden="true" />
						<span>{line}</span>
					</li>
				))}
			</ul>

			<div class="direct" data-in>
				<span class="direct-label">Prefer email?</span>
				<div class="direct-row">
					<a class="direct-mail" href={`mailto:${email}`}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="5" width="18" height="14" rx="2.5" />
							<path d="m4 7 8 6 8-6" />
						</svg>
						<span>{email}</span>
					</a>
					<button type="button" class="copy" id="copyEmail" data-copy={email}>
						<span class="copy-t">Copy</span>
					</button>
				</div>
			</div>
		</div>

		<div class="card" id="card" data-in>
			<i class="sweep" aria-hidden="true"></i>
			<form class="form" id="form" novalidate>
				<div class="meter" aria-hidden="true">
					<div class="seg"><span class="seg-bar"><i></i></span><span class="seg-t">You</span></div>
					<div class="seg"><span class="seg-bar"><i></i></span><span class="seg-t">Topic</span></div>
					<div class="seg"><span class="seg-bar"><i></i></span><span class="seg-t">Problem</span></div>
				</div>

				<div class="row two">
					<div class="field">
						<label for="cName">Your name</label>
						<input id="cName" name="name" type="text" autocomplete="name" placeholder="Jane Doe" />
					</div>
					<div class="field">
						<label for="cEmail">Your email</label>
						<input id="cEmail" name="email" type="email" autocomplete="email" placeholder="you@company.com" />
						<span class="err" id="cEmailErr" role="alert"></span>
					</div>
				</div>

				<fieldset class="topics">
					<legend>What&rsquo;s it about?</legend>
					<div class="chips">
						{topics.map((t) => (
							<button type="button" class="chip" aria-pressed="false">{t}</button>
						))}
					</div>
				</fieldset>

				<div class="field">
					<label for="cMsg">What isn&rsquo;t working?</label>
					<textarea id="cMsg" name="message" rows="5" placeholder="Tell us in your own words…"></textarea>
					<span class="err" id="cMsgErr" role="alert"></span>
				</div>

				<button type="submit" class="cta-btn" id="send">
					<i class="shine" aria-hidden="true"></i>
					<span class="btn-t">Tell us what you&rsquo;re trying to solve</span>
					<span class="cta-arrow" aria-hidden="true">&rarr;</span>
				</button>
			</form>

			<!-- shown after sending -->
			<div class="done" id="done" hidden>
				<span class="done-badge" aria-hidden="true">
					<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="24" cy="24" r="21" class="done-ring" />
						<path d="m14 25 7 7 13-15" class="done-tick" />
					</svg>
				</span>
				<h3 class="done-title">Your email app should be opening.</h3>
				<p class="done-text">If nothing opened, copy your message and send it to {email}.</p>
				<div class="done-actions">
					<button type="button" class="ghost" id="copyMsg">Copy my message</button>
					<button type="button" class="ghost" id="again">Write another</button>
				</div>
			</div>

			<p class="sr-only" id="ctaLive" aria-live="polite"></p>
		</div>
	</div>
</section>

<style>
	.final-cta {
		position: relative;
		overflow: hidden;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
	}

	/* two big outlined rings behind the card: drifting slowly, very faint */
	.rings {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.rings i {
		position: absolute;
		top: 50%;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 50%;
	}

	.rings i:nth-child(1) {
		right: -140px;
		width: 640px;
		height: 640px;
		margin-top: -320px;
	}

	.rings i:nth-child(2) {
		right: -300px;
		width: 960px;
		height: 960px;
		margin-top: -480px;
		border-color: rgba(167, 139, 250, 0.08);
	}

	.cta-inner {
		position: relative;
		max-width: 1040px;
		margin: 0 auto;
		padding: clamp(64px, 9vw, 120px) clamp(20px, 4vw, 32px);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(36px, 6vw, 80px);
		align-items: center;
	}

	.cta-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: clamp(1.2rem, 2.4vw, 1.6rem);
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.cta-heading {
		margin: 0 0 clamp(1.6rem, 3vw, 2.2rem);
		font-size: clamp(2.2rem, 3vw + 1.3rem, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.cta-heading :global(.mw) {
		display: inline-block;
		overflow: hidden;
		vertical-align: top;
		padding-bottom: 0.14em;
		margin-bottom: -0.14em;
	}

	.cta-heading :global(.w) {
		display: inline-block;
	}

	.heading-dim {
		display: block;
		margin-top: 0.2em;
		color: var(--muted);
	}

	/* the squiggle: a wobbly line that straightens as the form fills in */
	.squig {
		display: block;
		width: min(300px, 80%);
		height: 16px;
		margin: -0.9rem 0 1.5rem;
		overflow: visible;
		fill: none;
		stroke: var(--accent-bright, #a78bfa);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* ---------- the three reassurance lines ---------- */
	.cta-fineprint {
		display: grid;
		gap: 0.65rem;
		margin: 0 0 clamp(1.8rem, 3vw, 2.4rem);
		padding: 0;
		list-style: none;
	}

	.fine {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 0.98rem;
		color: var(--ink-soft, var(--ink));
	}

	.fine-ico {
		display: grid;
		place-items: center;
		flex: none;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: color-mix(in srgb, #34d399 20%, transparent);
		color: #34d399;
	}

	.fine-ico :global(svg) {
		width: 12px;
		height: 12px;
	}

	/* ---------- direct email ---------- */
	.direct-label {
		display: block;
		margin-bottom: 0.55rem;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.direct-row {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		max-width: 100%;
		padding: 0.35rem 0.4rem 0.35rem 0.9rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.025);
	}

	.direct-mail {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		color: var(--ink);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.direct-mail svg {
		flex: none;
		width: 18px;
		height: 18px;
		color: var(--accent-bright, #a78bfa);
	}

	.direct-mail span {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.direct-mail:hover {
		text-decoration: underline;
	}

	.copy {
		flex: none;
		min-height: 36px;
		padding: 0 0.95rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.07);
		color: var(--ink);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: background-color 0.2s;
	}

	.copy:hover,
	.copy:focus-visible {
		background: rgba(255, 255, 255, 0.14);
		outline: none;
	}

	.copy.is-done {
		background: color-mix(in srgb, #34d399 22%, transparent);
		color: #34d399;
	}

	/* ---------- the card ---------- */
	.card {
		position: relative;
		overflow: hidden;
		padding: clamp(1.2rem, 2.6vw, 1.9rem);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-top: 2px solid color-mix(in srgb, var(--accent-bright, #a78bfa) 35%, transparent);
		border-radius: 22px;
		background: linear-gradient(180deg, color-mix(in srgb, var(--accent-bright, #a78bfa) 6%, #0e1118), #0e1118);
		box-shadow: 0 30px 50px -36px rgba(0, 0, 0, 0.9);
	}

	/* a light that travels along the top edge */
	.sweep {
		position: absolute;
		top: -1px;
		left: 0;
		width: 38%;
		height: 2px;
		background: linear-gradient(90deg, transparent, #c4b5fd, transparent);
		pointer-events: none;
	}

	/* three bars: you, topic, problem. each fills when that part is done */
	.meter {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 8px;
	}

	.seg {
		display: grid;
		gap: 0.4rem;
	}

	.seg-bar {
		height: 4px;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.08);
		overflow: hidden;
	}

	.seg-bar i {
		display: block;
		height: 100%;
		background: #34d399;
		transform-origin: left;
		transform: scaleX(0);
	}

	.seg-t {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		transition: color 0.3s;
	}

	.seg.on .seg-t {
		color: #34d399;
	}

	.seg.on .seg-t::before {
		content: '\2713  ';
	}

	.form {
		display: grid;
		gap: 1.1rem;
	}

	.row.two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: start;
		gap: 0.9rem;
	}

	.field {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
	}

	.field label,
	.topics legend {
		padding: 0;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.field input,
	.field textarea {
		width: 100%;
		margin: 0;
		padding: 0.8rem 0.9rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.03);
		color: var(--ink);
		font: inherit;
		font-size: 0.98rem;
		line-height: 1.45;
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}

	.field textarea {
		resize: vertical;
		min-height: 120px;
	}

	.field input::placeholder,
	.field textarea::placeholder {
		color: var(--ink-faint);
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--accent-bright, #a78bfa);
		background: rgba(255, 255, 255, 0.05);
	}

	.field.is-bad input,
	.field.is-bad textarea {
		border-color: #f87171;
	}

	.err {
		min-height: 0;
		font-size: 0.8rem;
		color: #f87171;
	}

	.topics legend {
		margin-bottom: 0.55rem;
	}

	.topics {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.chip {
		min-height: 38px;
		padding: 0 0.95rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: transparent;
		color: var(--ink-faint);
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
		transition:
			border-color 0.2s,
			color 0.2s,
			background-color 0.2s;
	}

	.chip:hover,
	.chip:focus-visible {
		border-color: var(--accent-bright, #a78bfa);
		color: var(--ink);
		outline: none;
	}

	.chip[aria-pressed='true']::before {
		content: '\2713';
		margin-right: 0.4rem;
		color: var(--accent-bright, #a78bfa);
	}

	.chip[aria-pressed='true'] {
		border-color: transparent;
		background: color-mix(in srgb, var(--accent-bright, #a78bfa) 24%, transparent);
		color: var(--ink);
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6em;
		width: 100%;
		min-height: 52px;
		padding: 0.95rem 1.4rem;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-size: 1rem;
		font-weight: 600;
		text-align: center;
		cursor: pointer;
		transition: background-color 0.15s ease;
		will-change: transform;
		position: relative;
		overflow: hidden;
	}

	.btn-t,
	.cta-arrow {
		position: relative;
		z-index: 1;
	}

	.shine {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 34%;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.3), transparent);
		transform: skewX(-20deg);
		pointer-events: none;
	}

	.cta-btn:hover,
	.cta-btn:focus-visible {
		background: #5b21b6;
		outline: none;
	}

	.cta-btn:focus-visible {
		outline: 2px solid var(--accent-bright, #a78bfa);
		outline-offset: 3px;
	}

	.cta-arrow {
		display: inline-block;
	}

	/* ---------- after sending ---------- */
	.done {
		display: grid;
		justify-items: center;
		gap: 0.7rem;
		padding: clamp(1rem, 4vw, 2rem) 0.5rem;
		text-align: center;
	}

	.done[hidden] {
		display: none;
	}

	.done :global(.pip) {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 7px;
		height: 7px;
		margin: -3.5px 0 0 -3.5px;
		border-radius: 50%;
		pointer-events: none;
	}

	.done-badge {
		position: relative;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		color: #34d399;
	}

	.done-badge svg {
		width: 100%;
		height: 100%;
	}

	.done-title {
		margin: 0.3rem 0 0;
		font-size: 1.3rem;
		font-weight: 600;
	}

	.done-text {
		max-width: 34ch;
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--ink-faint);
	}

	.done-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 0.6rem;
	}

	.ghost {
		min-height: 42px;
		padding: 0 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		transition: border-color 0.2s;
	}

	.ghost:hover,
	.ghost:focus-visible {
		border-color: var(--accent-bright, #a78bfa);
		outline: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 860px) {
		.rings i:nth-child(2) {
			display: none;
		}
		.cta-inner {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 520px) {
		.row.two {
			grid-template-columns: 1fr;
		}
		.cta-btn {
			font-size: 0.95rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.field input,
		.field textarea,
		.chip,
		.cta-btn,
		.copy,
		.ghost {
			transition: none;
		}
		.shine,
		.sweep {
			display: none;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';

	const section = document.getElementById('contact');
	if (section) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const to = 'hello@neulancers.com';
		const q = <T extends HTMLElement>(s: string) => section.querySelector<T>(s)!;

		const heading = q('#ctaHeading');
		const line1 = q('.line1');
		const card = q('#card');
		const form = q<HTMLFormElement>('#form');
		const done = q('#done');
		const nameEl = q<HTMLInputElement>('#cName');
		const emailEl = q<HTMLInputElement>('#cEmail');
		const msgEl = q<HTMLTextAreaElement>('#cMsg');
		const emailErr = q('#cEmailErr');
		const msgErr = q('#cMsgErr');
		const chips = [...section.querySelectorAll<HTMLButtonElement>('.chip')];
		const send = q<HTMLButtonElement>('#send');
		const arrow = send.querySelector<HTMLElement>('.cta-arrow')!;
		const live = q('#ctaLive');
		const copyEmail = q<HTMLButtonElement>('#copyEmail');
		const copyMsg = q<HTMLButtonElement>('#copyMsg');
		const again = q<HTMLButtonElement>('#again');
		const squig = q<SVGPathElement>('#squigPath');
		const segs = [...section.querySelectorAll<HTMLElement>('.seg')];
		const sweep = q('.sweep');
		const shine = q('.shine');
		const rings = q('#rings');

		// ---------- heading words ----------
		const text = line1.textContent ?? '';
		heading.setAttribute('aria-label', `${text} ${heading.querySelector('.heading-dim')?.textContent ?? ''}`);
		line1.textContent = '';
		const words = text.split(' ').map((t, k, a) => {
			const mw = document.createElement('span');
			mw.className = 'mw';
			mw.setAttribute('aria-hidden', 'true');
			const w = document.createElement('span');
			w.className = 'w';
			w.textContent = t;
			mw.appendChild(w);
			line1.appendChild(mw);
			if (k < a.length - 1) line1.appendChild(document.createTextNode(' '));
			return w;
		});

		// ---------- the message ----------
		const topicsPicked = () => chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.textContent ?? '');
		const buildMessage = () => {
			const topics = topicsPicked();
			const who = [nameEl.value.trim(), emailEl.value.trim()].filter(Boolean).join(' · ');
			return [
				'Hi Neulancers,',
				'',
				msgEl.value.trim(),
				'',
				topics.length ? `About: ${topics.join(', ')}` : '',
				who ? `From: ${who}` : '',
			]
				.filter((l, i, a) => l !== '' || (i > 0 && a[i - 1] !== ''))
				.join('\n')
				.trim();
		};

		// ---------- the squiggle straightens, and the three bars fill, as the form is filled in ----------
		const wave = { amp: 6, phase: 0 };
		let inView = false;
		const draw = () => {
			let d = '';
			for (let i = 0; i <= 80; i++) {
				const x = i * 4;
				d += `${i ? 'L' : 'M'}${x} ${(8 + wave.amp * Math.sin((x / 320) * Math.PI * 5 + wave.phase)).toFixed(2)} `;
			}
			squig.setAttribute('d', d);
		};
		draw();
		if (!reduce) {
			gsap.ticker.add(() => {
				if (!inView || wave.amp < 0.15) return;
				wave.phase += 0.05;
				draw();
			});
			new IntersectionObserver((es) => (inView = es.some((e) => e.isIntersecting))).observe(section);
		}
		const done3 = [false, false, false];
		const progress = () => {
			const now = [!!(nameEl.value.trim() || emailEl.value.trim()), topicsPicked().length > 0, msgEl.value.trim().length >= 10];
			now.forEach((v, i) => {
				if (v === done3[i]) return;
				done3[i] = v;
				segs[i].classList.toggle('on', v);
				gsap.to(segs[i].querySelector('i'), { scaleX: v ? 1 : 0, duration: reduce ? 0 : 0.5, ease: 'power2.out' });
			});
			const n = now.filter(Boolean).length;
			gsap.to(wave, { amp: 6 * (1 - n / 3), duration: reduce ? 0 : 0.9, ease: 'power2.out', onUpdate: draw });
			gsap.to(squig, { stroke: n === 3 ? '#34d399' : '#a78bfa', duration: reduce ? 0 : 0.6 });
		};
		[nameEl, emailEl, msgEl].forEach((el) => el.addEventListener('input', progress));

		chips.forEach((c) =>
			c.addEventListener('click', () => {
				window.setTimeout(progress, 0);
				const on = c.getAttribute('aria-pressed') !== 'true';
				c.setAttribute('aria-pressed', String(on));
				if (!reduce) gsap.fromTo(c, { scale: 0.92 }, { scale: 1, duration: 0.4, ease: 'back.out(3)' });
			}),
		);

		// ---------- validation with a small shake ----------
		const shake = (el: HTMLElement) => {
			if (reduce) return;
			gsap.fromTo(el, { x: -6 }, { x: 0, duration: 0.5, ease: 'elastic.out(1, 0.25)' });
		};
		const bad = (field: HTMLElement, err: HTMLElement, msg: string) => {
			field.classList.add('is-bad');
			err.textContent = msg;
			shake(field);
		};
		const clear = (field: HTMLElement, err: HTMLElement) => {
			field.classList.remove('is-bad');
			err.textContent = '';
		};
		msgEl.addEventListener('input', () => clear(msgEl.closest('.field')!, msgErr));
		emailEl.addEventListener('input', () => clear(emailEl.closest('.field')!, emailErr));

		// ---------- copy buttons ----------
		const copy = async (value: string, btn: HTMLElement, label: HTMLElement, idle: string) => {
			let ok = false;
			try {
				await navigator.clipboard.writeText(value);
				ok = true;
			} catch {
				ok = false;
			}
			label.textContent = ok ? 'Copied' : 'Press Ctrl+C';
			btn.classList.toggle('is-done', ok);
			live.textContent = ok ? 'Copied to the clipboard.' : 'Could not copy automatically.';
			if (ok && !reduce) gsap.fromTo(btn, { scale: 0.92 }, { scale: 1, duration: 0.4, ease: 'back.out(3)' });
			window.setTimeout(() => {
				label.textContent = idle;
				btn.classList.remove('is-done');
			}, 1800);
		};
		copyEmail.addEventListener('click', () => copy(to, copyEmail, copyEmail.querySelector('.copy-t')!, 'Copy'));
		copyMsg.addEventListener('click', () => copy(buildMessage(), copyMsg, copyMsg, 'Copy my message'));

		// ---------- sending: opens the email app with everything filled in ----------
		const showDone = () => {
			const swap = () => {
				form.hidden = true;
				done.hidden = false;
				const ring = done.querySelector<SVGGeometryElement>('.done-ring')!;
				const tick = done.querySelector<SVGGeometryElement>('.done-tick')!;
				if (reduce) return;
				[ring, tick].forEach((p) => {
					const len = p.getTotalLength();
					gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
				});
				const badge = done.querySelector<HTMLElement>('.done-badge')!;
				for (let i = 0; i < 16; i++) {
					const pip = document.createElement('span');
					pip.className = 'pip';
					pip.style.background = i % 3 === 0 ? '#a78bfa' : i % 3 === 1 ? '#34d399' : '#fbbf24';
					badge.appendChild(pip);
					const a = (i / 16) * Math.PI * 2;
					const r = 60 + (i % 4) * 14;
					gsap.fromTo(pip, { x: 0, y: 0, scale: 1, opacity: 1 }, { x: Math.cos(a) * r, y: Math.sin(a) * r, scale: 0, opacity: 0, duration: 0.95, ease: 'power2.out', delay: 0.85, onComplete: () => pip.remove() });
				}
				gsap.to(ring, { strokeDashoffset: 0, duration: 0.7, ease: 'power2.out' });
				gsap.to(tick, { strokeDashoffset: 0, duration: 0.45, ease: 'power2.out', delay: 0.5 });
				gsap.from(done.querySelectorAll('.done-title, .done-text, .done-actions'), { opacity: 0, y: 14, duration: 0.55, stagger: 0.1, delay: 0.5, ease: 'power2.out' });
			};
			if (reduce) swap();
			else gsap.to(form, { opacity: 0, y: -10, duration: 0.3, onComplete: () => (swap(), gsap.set(form, { opacity: 1, y: 0 })) });
		};

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			let ok = true;
			const emailOk = !emailEl.value.trim() || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim());
			if (!emailOk) {
				bad(emailEl.closest('.field')!, emailErr, 'That email looks off.');
				ok = false;
			}
			if (!msgEl.value.trim()) {
				bad(msgEl.closest('.field')!, msgErr, 'Tell us a little about it first.');
				ok = false;
			}
			if (!ok) {
				(emailOk ? msgEl : emailEl).focus();
				return;
			}
			const topics = topicsPicked();
			const subject = topics.length ? `Contact: ${topics.join(', ')}` : 'A problem we could use help with';
			const href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(buildMessage())}`;
			live.textContent = 'Opening your email app.';
			if (!reduce) gsap.fromTo(arrow, { x: 0 }, { x: 16, duration: 0.22, ease: 'power2.in', yoyo: true, repeat: 1 });
			window.setTimeout(() => {
				window.location.href = href;
				showDone();
			}, reduce ? 0 : 380);
		});

		again.addEventListener('click', () => {
			done.hidden = true;
			form.hidden = false;
			msgEl.value = '';
			chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
			if (!reduce) gsap.from(form.children, { opacity: 0, y: 14, duration: 0.5, stagger: 0.07, ease: 'power2.out' });
			progress();
			msgEl.focus();
		});

		// ---------- ambient motion ----------
		if (!reduce) {
			gsap.fromTo(sweep, { xPercent: -120 }, { xPercent: 270, duration: 2.8, ease: 'power1.inOut', repeat: -1, repeatDelay: 1.6 });
			gsap.fromTo(shine, { xPercent: -220 }, { xPercent: 460, duration: 1.1, ease: 'power2.inOut', repeat: -1, repeatDelay: 3.4 });
			gsap.to(rings.children, { scale: 1.05, duration: 7, ease: 'sine.inOut', yoyo: true, repeat: -1, stagger: 1.5 });
			const rxk = gsap.quickTo(rings, 'x', { duration: 1.4, ease: 'power3.out' });
			const ryk = gsap.quickTo(rings, 'y', { duration: 1.4, ease: 'power3.out' });
			section.addEventListener('pointermove', (e) => {
				const r = section.getBoundingClientRect();
				rxk(((e.clientX - r.left) / r.width - 0.5) * -40);
				ryk(((e.clientY - r.top) / r.height - 0.5) * -28);
			});

			// the card leans a little toward the pointer, and settles while you type
			gsap.set(card, { transformPerspective: 900 });
			const tx = gsap.quickTo(card, 'rotationX', { duration: 0.6, ease: 'power3.out' });
			const ty = gsap.quickTo(card, 'rotationY', { duration: 0.6, ease: 'power3.out' });
			card.addEventListener('pointermove', (e) => {
				if (card.matches(':focus-within')) return;
				const r = card.getBoundingClientRect();
				ty(((e.clientX - r.left) / r.width - 0.5) * 5);
				tx(-((e.clientY - r.top) / r.height - 0.5) * 4);
			});
			const flat = () => (tx(0), ty(0));
			card.addEventListener('pointerleave', flat);
			card.addEventListener('focusin', flat);
		}

		// ---------- a gentle magnetic pull on the send button ----------
		if (!reduce) {
			const bx = gsap.quickTo(send, 'x', { duration: 0.4, ease: 'power3.out' });
			const by = gsap.quickTo(send, 'y', { duration: 0.4, ease: 'power3.out' });
			send.addEventListener('pointermove', (e) => {
				const r = send.getBoundingClientRect();
				bx((e.clientX - r.left - r.width / 2) * 0.06);
				by((e.clientY - r.top - r.height / 2) * 0.18);
			});
			send.addEventListener('pointerleave', () => {
				bx(0);
				by(0);
			});
		}

		// ---------- entrance ----------
		const items = [...section.querySelectorAll<HTMLElement>('[data-in]')];
		const fields = [...form.children] as HTMLElement[];
		if (!reduce && 'IntersectionObserver' in window) {
			gsap.set(items, { opacity: 0, y: 22 });
			gsap.set(fields, { opacity: 0, y: 16 });
			const io = new IntersectionObserver(
				(es) => {
					if (!es.some((e) => e.isIntersecting)) return;
					io.disconnect();
					gsap.from(words, { yPercent: 110, duration: 0.85, ease: 'power3.out', stagger: 0.09 });
					section.querySelectorAll<SVGGeometryElement>('.fine-ico path').forEach((p, i) => {
						const len = p.getTotalLength();
						gsap.fromTo(p, { strokeDasharray: len, strokeDashoffset: len }, { strokeDashoffset: 0, duration: 0.5, ease: 'power2.out', delay: 0.7 + i * 0.12 });
					});
					// the squiggle wobbles in
					gsap.from(wave, { amp: 0, duration: 1.2, ease: 'elastic.out(1, 0.4)', delay: 0.5, onUpdate: draw });
					gsap.to(items, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.1, delay: 0.15 });
					// the form fields fill in one after another once the card is up
					gsap.to(fields, { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out', stagger: 0.09, delay: 0.75 });
				},
				{ threshold: 0.2 },
			);
			io.observe(section);
		}
	}
</script>
