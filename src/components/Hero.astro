---
const tags = ['AI', 'Software', 'Automation', 'Products', 'Experiments'];

const icons: Record<string, string> = {
	bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.5.4.8 1 .8 1.6v.5h5.4v-.5c0-.6.3-1.2.8-1.6A6 6 0 0 0 12 3Z"/>',
	search: '<circle cx="10.5" cy="10.5" r="6"/><path d="m19.5 19.5-4.3-4.3"/>',
	spark: '<path d="M12 3l1.6 4.9L18.5 9l-4.9 1.6L12 15.5l-1.6-4.9L5.5 9l4.9-1.6L12 3Z"/>',
	code: '<path d="m9 8-4 4 4 4M15 8l4 4-4 4"/>',
	layers: '<path d="M12 4 3 9l9 5 9-5-9-5Z"/><path d="m3 14 9 5 9-5"/>',
	rocket:
		'<path d="M12 2.5c2 2 3 5 3 8 0 2-1 4-3 6-2-2-3-4-3-6 0-3 1-6 3-8Z"/><path d="m8.3 15-2.8 3.7 3.7-1M15.7 15l2.8 3.7-3.7-1"/>',
};

const stageMeta = [
	{ label: 'Problem', desc: 'A real challenge to solve.', icon: 'bulb' },
	{ label: 'Question', desc: 'Dig deeper, find the right one.', icon: 'search' },
	{ label: 'Idea', desc: 'Turn insights into possibilities.', icon: 'spark' },
	{ label: 'Prototype', desc: 'Build, test, learn fast.', icon: 'code' },
	{ label: 'System', desc: 'Make it work in the real world.', icon: 'layers' },
	{ label: 'Something real', desc: 'Create impact, not just output.', icon: 'rocket' },
];

// The arc is a partial circle CONCENTRIC with the main circle — same
// center, larger radius — not an independent bulge. Everything here is
// worked out in a fixed reference box (VISUAL_W × VISUAL_H) and then
// expressed as percentages of that box, so the circle, arc, nodes and
// cards all share one coordinate system and stay locked together.
// The box's aspect ratio is also applied to .hero-visual directly (via
// inline style), so the whole system scales fluidly with the grid
// column instead of being pinned to viewport-width breakpoints.
const VISUAL_W = 680;
const VISUAL_H = 560;
const CIRCLE_R = 92; // kept modest on purpose — a small, soft core, not the focal point
const CIRCLE_CX = CIRCLE_R; // circle sits flush against the box's left edge
const CIRCLE_CY = VISUAL_H / 2;
const ARC_R = CIRCLE_R + 170; // the orbit's radius — well clear of the circle, filling the box
const CARD_GAP = 14; // px (ref space) — card's pointed tip sits right at its node
// How far the 6 stages sweep above/below the orbit's horizontal center line.
// Less than a full ±90° on purpose: pulling the first/last stage in from the
// due-up/due-down extremes keeps "Something real" feeling like part of the
// loop rather than a tail hanging off the bottom.
const NODE_ANGLE_LIMIT = 66;
const ANGLE_START = -NODE_ANGLE_LIMIT;
const ANGLE_END = NODE_ANGLE_LIMIT;

const toRad = (deg: number) => (deg * Math.PI) / 180;
const toDeg = (rad: number) => (rad * 180) / Math.PI;
// used for the visible curve: uniform angle steps trace a smooth, evenly
// "dense" circular arc.
const angleAt = (t: number) => ANGLE_START + t * (ANGLE_END - ANGLE_START);
// used for the 6 stage nodes/cards: spacing them evenly by *angle* bunches
// them together near the sweep's tips (sine flattens out there) and spreads
// them apart near the middle. Spacing evenly by Y-projection instead keeps
// a consistent gap between cards top to bottom, scaled to the same
// ±NODE_ANGLE_LIMIT sweep as the visible arc.
const angleAtEvenY = (t: number) => {
	const limitSin = Math.sin(toRad(NODE_ANGLE_LIMIT));
	return toDeg(Math.asin((t * 2 - 1) * limitSin));
};
const pointAt = (angleDeg: number, radius: number) => {
	const rad = toRad(angleDeg);
	return {
		x: CIRCLE_CX + radius * Math.cos(rad),
		y: CIRCLE_CY + radius * Math.sin(rad),
	};
};

const stages = stageMeta.map((s, i) => {
	const t = stageMeta.length === 1 ? 0 : i / (stageMeta.length - 1);
	const node = pointAt(angleAtEvenY(t), ARC_R);
	return {
		...s,
		idx: `0${i + 1}`,
		nodeXPct: (node.x / VISUAL_W) * 100,
		nodeYPct: (node.y / VISUAL_H) * 100,
		cardLeftPct: ((node.x + CARD_GAP) / VISUAL_W) * 100,
		cardTopPct: (node.y / VISUAL_H) * 100,
	};
});

const arcPath = (() => {
	const steps = 48;
	let d = '';
	for (let i = 0; i <= steps; i++) {
		const p = pointAt(angleAt(i / steps), ARC_R);
		const x = ((p.x / VISUAL_W) * 100).toFixed(2);
		const y = ((p.y / VISUAL_H) * 100).toFixed(2);
		d += `${i === 0 ? 'M' : 'L'} ${x} ${y} `;
	}
	return d.trim();
})();
---

<section class="hero" id="hero">
	<div class="hero-inner">
		<div class="hero-content">
			<div class="tag-row reveal" style="--reveal-order: 0">
				{tags.map((tag) => <span class="tag">{tag}</span>)}
			</div>

			<h1 class="headline">
				<span class="line line--dim reveal" style="--reveal-order: 1">We don't build software.</span>
				<span class="line reveal" style="--reveal-order: 2">We build possibilities.</span>
			</h1>

			<div class="flow-hint reveal" style="--reveal-order: 3">
				<span class="flow-hint-dot" aria-hidden="true"></span>
				<span>Problem</span>
				<span class="flow-hint-arrow" aria-hidden="true">&rarr;</span>
				<span class="flow-hint-strong">Something real</span>
			</div>

			<div class="cta-row reveal" style="--reveal-order: 4">
				<a href="#contact" class="cta-btn">
					<span>Bring us a problem</span>
					<span class="cta-arrow">&rarr;</span>
				</a>
				<span class="cta-hint">Not &ldquo;Contact us.&rdquo;</span>
			</div>
		</div>

		<div
			class="hero-visual reveal"
			id="pipeline"
			aria-label="How an idea becomes something real"
			style={`--reveal-order: 5; aspect-ratio: ${VISUAL_W} / ${VISUAL_H};`}
		>
			<div class="hero-circle" aria-hidden="true">
				<span class="core-glow"></span>
				<span class="core-ring"></span>
				<span class="core-icon-wrap">
					{stageMeta.map((s, i) => (
						<svg
							class={`core-icon${i === 0 ? ' is-current' : ''}`}
							data-index={i}
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							set:html={icons[s.icon]}
						/>
					))}
				</span>
			</div>

			<svg class="arc-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
				<defs>
					<filter id="heroPulseGlow" x="-200%" y="-200%" width="500%" height="500%">
						<feGaussianBlur stdDeviation="1.4" result="blur"></feGaussianBlur>
						<feMerge>
							<feMergeNode in="blur"></feMergeNode>
							<feMergeNode in="SourceGraphic"></feMergeNode>
						</feMerge>
					</filter>
				</defs>
				<path d={arcPath} class="arc-base"></path>
				<circle class="arc-pulse" r="0.9" filter="url(#heroPulseGlow)">
					<animateMotion dur="9s" repeatCount="indefinite" path={arcPath}></animateMotion>
				</circle>
			</svg>

			{stages.map((s, i) => (
				<span class="node" data-index={i} style={`left:${s.nodeXPct}%; top:${s.nodeYPct}%;`}></span>
			))}

			{stages.map((s, i) => (
				<button
					type="button"
					class="stage-card"
					data-index={i}
					aria-pressed="false"
					style={`left:${s.cardLeftPct}%; top:${s.cardTopPct}%;`}
				>
					<div class="card-head">
						<span class="card-idx">{s.idx}</span>
						<svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]}></svg>
					</div>
					<span class="card-label">{s.label}</span>
					<span class="card-desc">{s.desc}</span>
				</button>
			))}
		</div>
	</div>
</section>

<style>
	.hero {
		--ink: #f3f3f1;
		--muted: #8b929d;
		--ink-faint: rgba(139, 146, 157, 0.75);
		--border: rgba(255, 255, 255, 0.12);
		--border-soft: rgba(255, 255, 255, 0.1);
		--accent: #6d28d9;
		--accent-hover: #5b21b6;
		--bg: #07080b;
		--circle-bg: #0b0c11;
		--card-bg: #0d1018;

		position: relative;
		display: flex;
		align-items: center;
		/* dvh tracks the real visible viewport on mobile browsers (accounting
		   for the address bar), falling back to vh where dvh isn't supported */
		min-height: 100vh;
		min-height: 100dvh;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
	}

	.hero-inner {
		position: relative;
		width: 100%;
		display: grid;
		/* ~45% / ~55% text-to-visual balance on large desktop, with a floor
		   on each track so neither column gets crushed near the breakpoint. */
		grid-template-columns: minmax(400px, 45fr) minmax(420px, 55fr);
		align-items: center;
		gap: clamp(24px, 3vw, 56px);
		max-width: 1320px;
		margin: 0 auto;
		padding: clamp(100px, 14vh, 140px) clamp(20px, 4vw, 32px) clamp(48px, 8vh, 88px);
	}

	/* ---------- page-load entrance ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 90ms);
	}

	.hero.is-visible .reveal {
		opacity: 1;
		transform: translateY(0);
	}

	/* ---------- left column ---------- */
	.hero-content {
		position: relative;
		z-index: 2;
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}

	.tag {
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		border: 1px solid var(--border-soft);
		border-radius: 6px;
		padding: 0.3rem 0.7rem;
	}

	.headline {
		margin: 0 0 1.75rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.02;
	}

	.headline .line {
		display: block;
		font-size: clamp(2rem, 1.3vw + 1.9rem, 3rem);
		color: var(--ink);
	}

	.headline .line--dim {
		color: var(--muted);
		font-weight: 600;
		margin-top: 0.3rem;
	}

	.cta-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.85rem 1.5rem;
		background: var(--accent);
		color: #ffffff;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		white-space: nowrap;
		transition: background-color 0.15s ease;
	}

	.cta-btn:hover,
	.cta-btn:focus-visible {
		background: var(--accent-hover);
	}

	.cta-arrow {
		transition: transform 0.2s ease;
	}

	.cta-btn:hover .cta-arrow {
		transform: translateX(3px);
	}

	.cta-hint {
		font-size: 0.85rem;
		color: var(--muted);
	}

	/* ---------- headline-to-workflow connector ---------- */
	.flow-hint {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin-bottom: 1.4rem;
	}

	.flow-hint-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.18);
		flex-shrink: 0;
	}

	.flow-hint-arrow {
		color: var(--accent);
	}

	.flow-hint-strong {
		color: var(--ink);
		font-weight: 600;
	}

	/* ---------- central circle ---------- */
	/* ---------- circle + orbit + cards: one shared coordinate system ----------
	   .hero-visual fills its grid column at width:100% and derives its height
	   from the VISUAL_W/VISUAL_H aspect-ratio (set inline from the same
	   constants the frontmatter uses for the arc math), so the reference box
	   and the rendered box always agree — no viewport-width clamps to keep
	   in sync by hand. */
	.hero-visual {
		position: relative;
		width: 100%;
		z-index: 1;
	}

	.hero-circle {
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 27%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--circle-bg);
		border: 1px solid var(--border);
		box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
		pointer-events: none;
		overflow: hidden;
	}

	.core-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 50%, rgba(109, 40, 217, 0.4), transparent 68%);
		animation: coreGlowPulse 6s ease-in-out infinite;
	}

	.core-ring {
		position: absolute;
		inset: 12%;
		border-radius: 50%;
		border: 1px dashed rgba(109, 40, 217, 0.35);
		animation: coreRingSpin 26s linear infinite;
	}

	.core-icon-wrap {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.core-icon {
		position: absolute;
		width: 32%;
		height: 32%;
		color: var(--accent);
		opacity: 0;
		transform: scale(0.85);
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.core-icon.is-current {
		opacity: 0.9;
		transform: scale(1);
	}

	@keyframes coreGlowPulse {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(0.94);
		}
		50% {
			opacity: 0.9;
			transform: scale(1.04);
		}
	}

	@keyframes coreRingSpin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.arc-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.arc-base {
		fill: none;
		stroke: var(--accent);
		stroke-width: 0.35;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.arc-pulse {
		fill: var(--accent);
		opacity: 0.8;
	}

	/* plain HTML dots, not SVG — an SVG circle inside a non-square
	   viewBox stretched with preserveAspectRatio="none" renders as an
	   oval, not a circle, so nodes live outside the distorted SVG */
	.node {
		position: absolute;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--bg);
		border: 1px solid rgba(255, 255, 255, 0.4);
		transform: translate(-50%, -50%);
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		pointer-events: none;
	}

	.node.is-current {
		background: #a78bfa;
		border-color: #a78bfa;
		box-shadow:
			0 0 0 5px rgba(109, 40, 217, 0.22),
			0 0 14px 2px rgba(167, 139, 250, 0.55);
		transform: translate(-50%, -50%) scale(1.6);
	}

	.stage-card {
		position: absolute;
		transform: translateY(-50%);
		width: clamp(158px, 14vw, 205px);
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		background: rgba(13, 16, 24, 0.55);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid var(--border-soft);
		border-radius: 12px;
		/* left edge angles inward to a point at mid-height, like a flag
		   pointing back toward the node it connects to — not just a
		   single corner cut. */
		clip-path: polygon(22px 0, 100% 0, 100% 100%, 22px 100%, 0 50%);
		padding: 0.65rem 0.8rem 0.8rem 1.1rem;
		text-align: left;
		cursor: pointer;
		font-family: inherit;
		transition:
			border-color 0.3s ease,
			background-color 0.3s ease,
			box-shadow 0.3s ease,
			transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 10px 22px rgba(0, 0, 0, 0.28);
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.card-idx {
		font-size: 0.66rem;
		color: var(--ink-faint);
	}

	.card-icon {
		width: 16px;
		height: 16px;
		color: var(--accent);
		flex-shrink: 0;
	}

	.card-label {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--ink);
		transition: color 0.25s ease;
	}

	.card-desc {
		font-size: 0.74rem;
		line-height: 1.35;
		color: var(--ink-faint);
	}

	.stage-card.is-current {
		border-color: var(--accent);
		background: rgba(109, 40, 217, 0.18);
		box-shadow:
			0 0 0 1px rgba(109, 40, 217, 0.35),
			0 18px 40px rgba(109, 40, 217, 0.22);
		transform: translateY(-50%) scale(1.045);
	}

	.stage-card:hover:not(.is-current) {
		border-color: rgba(109, 40, 217, 0.3);
		transform: translateY(-50%) scale(1.015);
	}

	/* ---------- responsive ---------- */
	@media (max-width: 1080px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero-content {
			max-width: 560px;
		}

		.hero-visual {
			max-width: 640px;
			margin: 1.5rem auto 0;
		}
	}

	@media (max-width: 680px) {
		.headline .line {
			font-size: clamp(1.85rem, 8vw, 2.3rem);
		}

		.hero-circle {
			display: none;
		}

		.stage-card {
			width: clamp(130px, 46vw, 170px);
			padding: 0.55rem 0.65rem;
		}

		.card-desc {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.node,
		.card-label,
		.stage-card,
		.cta-btn,
		.cta-arrow {
			transition: none;
		}

		.reveal {
			transition: none;
		}

		.core-glow,
		.core-ring {
			animation: none;
		}

		.arc-pulse {
			opacity: 0;
		}

		.core-icon {
			transition: none;
		}
	}
</style>

<noscript>
	<style>
		.hero .reveal {
			opacity: 1 !important;
		}

		.hero .tag-row.reveal,
		.hero .line.reveal,
		.hero .cta-row.reveal,
		.hero .hero-visual.reveal {
			transform: none !important;
		}
	</style>
</noscript>

<script>
	const heroSection = document.getElementById('hero');
	const stageCards = Array.from(document.querySelectorAll('.stage-card')) as HTMLButtonElement[];
	const nodeEls = Array.from(document.querySelectorAll('.node')) as HTMLElement[];
	const coreIcons = Array.from(document.querySelectorAll('.core-icon')) as HTMLElement[];
	const pipeline = document.getElementById('pipeline');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// page-load entrance: reduced-motion just snaps everything visible;
	// otherwise wait a frame so the browser paints the hidden state first,
	// then add the class that triggers the staggered fade/slide-in.
	if (reduceMotion) {
		heroSection?.classList.add('is-visible');
	} else {
		requestAnimationFrame(() => {
			requestAnimationFrame(() => heroSection?.classList.add('is-visible'));
		});
	}

	let current = 0;
	let timer: ReturnType<typeof setTimeout> | null = null;

	const render = () => {
		stageCards.forEach((el, i) => {
			el.classList.toggle('is-current', i === current);
			el.setAttribute('aria-pressed', String(i === current));
		});
		nodeEls.forEach((el, i) => {
			el.classList.toggle('is-current', i === current);
		});
		coreIcons.forEach((el, i) => {
			el.classList.toggle('is-current', i === current);
		});
	};

	const scheduleNext = () => {
		if (reduceMotion) return;
		const atEnd = current === stageCards.length - 1;
		timer = setTimeout(
			() => {
				current = atEnd ? 0 : current + 1;
				render();
				scheduleNext();
			},
			atEnd ? 2800 : 1700,
		);
	};

	const start = () => {
		if (!timer) scheduleNext();
	};

	const stop = () => {
		if (timer) {
			clearTimeout(timer);
			timer = null;
		}
	};

	stageCards.forEach((btn) => {
		const setFromButton = () => {
			current = Number(btn.dataset.index);
			render();
		};
		btn.addEventListener('mouseenter', setFromButton);
		btn.addEventListener('focus', setFromButton);
		btn.addEventListener('click', setFromButton);
	});

	pipeline?.addEventListener('pointerenter', stop);
	pipeline?.addEventListener('pointerleave', start);

	pipeline?.addEventListener('focusout', (event) => {
		const next = (event as FocusEvent).relatedTarget as Node | null;
		if (!pipeline.contains(next)) start();
	});

	render();
	start();
</script>
