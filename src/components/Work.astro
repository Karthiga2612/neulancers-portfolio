---
const icons: Record<string, string> = {
	chart: '<path d="M4 20V11M10 20V4M16 20v-8M22 20H2"/>',
	document: '<path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/>',
	droplet: '<path d="M12 2s7 8 7 13a7 7 0 0 1-14 0c0-5 7-13 7-13Z"/>',
	spark: '<path d="M12 3l1.6 4.9L18.5 9l-4.9 1.6L12 15.5l-1.6-4.9L5.5 9l4.9-1.6L12 3Z"/>',
	layers: '<path d="M12 4 3 9l9 5 9-5-9-5Z"/><path d="m3 14 9 5 9-5"/>',
};

// Abstract panel art per project, drawn on a 320x200 grid, stroke only, so
// each card has its own diagram until real screenshots exist.
const art: Record<string, string> = {
	chart:
		'<path class="a-dim" d="M20 170h280M20 130h280M20 90h280M20 50h280"/><path class="a-dim" d="M60 170V120M110 170V100M160 170V130M210 170V70M260 170V40"/><path class="a-main" d="M60 120 110 100 160 130 210 70 260 40"/><circle class="a-dot" cx="260" cy="40" r="5"/>',
	document:
		'<rect class="a-dim" x="70" y="30" width="150" height="150" rx="8"/><rect class="a-dim" x="95" y="20" width="150" height="150" rx="8"/><rect class="a-main" x="120" y="10" width="150" height="150" rx="8"/><path class="a-main" d="M145 50h70M145 78h100M145 106h60"/><path class="a-main" d="m232 120 10 10 20-22"/>',
	droplet:
		'<circle class="a-dim" cx="160" cy="100" r="88"/><circle class="a-dim" cx="160" cy="100" r="62"/><circle class="a-main" cx="160" cy="100" r="36"/><circle class="a-dot" cx="160" cy="100" r="6"/><path class="a-dim" d="M10 100h300"/>',
	spark:
		'<path class="a-dim" d="M60 50 160 100 60 150M160 100 270 40M160 100 270 100M160 100 270 160"/><circle class="a-main" cx="160" cy="100" r="16"/><circle class="a-dot" cx="60" cy="50" r="6"/><circle class="a-dot" cx="60" cy="150" r="6"/><circle class="a-dot" cx="270" cy="40" r="6"/><circle class="a-dot" cx="270" cy="100" r="6"/><circle class="a-dot" cx="270" cy="160" r="6"/>',
	layers:
		'<path class="a-dim" d="M160 120 40 150 160 180 280 150Z"/><path class="a-dim" d="M160 85 40 115 160 145 280 115Z"/><path class="a-main" d="M160 50 40 80 160 110 280 80Z"/><path class="a-dim" d="M160 20v30"/>',
};

const projects = [
	{
		name: 'Finveda',
		icon: 'chart',
		category: 'Fintech, India',
		tagline: 'Financial intelligence for CA firms.',
		desc: 'A system that turns raw financial data into clear, actionable intelligence for chartered accountants — built from scratch, not bolted onto existing software.',
		status: 'Built',
		focus: 'Financial ops',
		format: 'Web platform',
	},
	{
		name: 'Litwatch',
		icon: 'document',
		category: 'Legaltech, India',
		tagline: 'Keeping track of tax & legal matters.',
		desc: "Deadlines, filings, and compliance shouldn't live in someone's memory. Litwatch turns scattered legal obligations into a single, dependable system.",
		status: 'Building',
		focus: 'Compliance',
		format: 'Web platform',
	},
	{
		name: 'Mr. Water',
		icon: 'droplet',
		category: 'Operations, India',
		tagline: 'Turning a traditional water business into a connected operation.',
		desc: 'From delivery schedules to customer requests, we rebuilt how a decades-old water business runs — without asking it to become a tech company.',
		status: 'Built',
		focus: 'Field operations',
		format: 'Internal tool',
	},
	{
		name: 'AI Agents',
		icon: 'spark',
		category: 'Artificial intelligence',
		tagline: "Machines that don't just talk. They work.",
		desc: 'We build agents that take real action — checking documents, updating records, closing loops — not just answering questions.',
		status: 'Breaking',
		focus: 'Agent workflows',
		format: 'Agent system',
	},
	{
		name: 'Automation Systems',
		icon: 'layers',
		category: 'Automation',
		tagline: 'Removing repetitive work from businesses.',
		desc: 'The parts of a job nobody wants to do by hand, we quietly automate — so people can spend time on the parts that actually need them.',
		status: 'Building',
		focus: 'Process automation',
		format: 'Automation suite',
	},
];

// one consistent vocabulary for the three states in the copy
const statusLabel = (status: string) => ({ Built: 'Live', Building: 'In build', Breaking: 'In build' })[status] ?? status;

const sectors = ['Fintech', 'Legaltech', 'Field operations', 'AI agents', 'Process automation'];
const total = String(projects.length).padStart(2, '0');

// loose shapes that drift at different depths behind the pinned scene
const bits = [
	{ x: 6, y: 14, d: 0.5, s: 14, k: 'pill' },
	{ x: 18, y: 78, d: 1.3, s: 22, k: 'ring' },
	{ x: 30, y: 30, d: 0.8, s: 10, k: 'dot' },
	{ x: 44, y: 88, d: 0.6, s: 16, k: 'pill' },
	{ x: 52, y: 10, d: 1.5, s: 26, k: 'plus' },
	{ x: 63, y: 62, d: 0.4, s: 12, k: 'dot' },
	{ x: 72, y: 22, d: 1.1, s: 18, k: 'pill' },
	{ x: 83, y: 80, d: 0.9, s: 24, k: 'ring' },
	{ x: 92, y: 40, d: 1.4, s: 14, k: 'plus' },
	{ x: 12, y: 50, d: 0.7, s: 9, k: 'dot' },
	{ x: 38, y: 58, d: 1.6, s: 20, k: 'pill' },
	{ x: 58, y: 38, d: 0.35, s: 8, k: 'dot' },
	{ x: 78, y: 54, d: 1.2, s: 12, k: 'plus' },
	{ x: 95, y: 12, d: 0.55, s: 16, k: 'ring' },
];
---

<section class="work" id="work" aria-labelledby="work-title">
	<div class="work-inner">
		<div class="work-head">
			<div class="work-eyebrow reveal" style="--reveal-order: 0">
				<span class="eyebrow-idx">04</span>
				<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
				<span class="eyebrow-label">Case Studies</span>
			</div>

			<h2 class="work-heading reveal" id="work-title" style="--reveal-order: 1">What We've Built</h2>
			<p class="work-sub reveal" style="--reveal-order: 2">Systems we built, and are still building.</p>
		</div>
	</div>

	<div class="work-marquee reveal" style="--reveal-order: 3" aria-hidden="true">
		<div class="marquee-track">
			{[0, 1].map(() => (
				<ul class="marquee-set">
					{sectors.map((s) => (
						<li><span>{s}</span><i></i></li>
					))}
					{sectors.map((s) => (
						<li><span>{s}</span><i></i></li>
					))}
				</ul>
			))}
		</div>
	</div>

	<div class="work-inner">
		<div class="work-index reveal" style="--reveal-order: 4">
			<p class="index-count" aria-hidden="true">
				<b class="count-cur">01</b> / {total}
			</p>

			<ol class="index-list">
				{projects.map((p, i) => (
					<li class:list={['project', i === 0 && 'is-active']} data-index={i}>
						<button type="button" class="row" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`detail-${i}`}>
							<span class="row-n">{`0${i + 1}`}</span>
							<span class="row-name">{p.name}</span>
							<span class="row-cat">{p.category}</span>
							<span class="row-plus" aria-hidden="true"></span>
						</button>

						<div class="detail" id={`detail-${i}`}>
						<div class="detail-in">
							<div class="frame" aria-hidden="true">
								<div class="frame-bar">
									<span></span><span></span><span></span>
									<em>Preview</em>
								</div>
								<div class="frame-body">
									<svg class="visual-art" viewBox="0 0 320 200" fill="none" set:html={art[p.icon]}></svg>
								</div>
							</div>

							<div class="detail-text">
								<p class="detail-status">
									<span class:list={['status-dot', `is-${p.status.toLowerCase()}`]} aria-hidden="true"></span>
									{statusLabel(p.status)}
								</p>
								<h3 class="detail-lead">{p.tagline}</h3>
								<p class="detail-desc">{p.desc}</p>

								<dl class="detail-facts">
									<div><dt>Focus</dt><dd>{p.focus}</dd></div>
									<div><dt>Format</dt><dd>{p.format}</dd></div>
								</dl>

								<a href="#contact" class="detail-cta">
									<span>Build something like this</span>
									<span class="cta-arrow" aria-hidden="true">&rarr;</span>
								</a>
							</div>
						</div>
						</div>
					</li>
				))}
			</ol>
		</div>

		<div class="wk-stage" aria-label="Projects">
			<div class="wk-bits" aria-hidden="true">
				<span class="wk-well"></span>
				<span class="wk-rings"></span>
				{bits.map((b) => (
					<span class={`wk-bit wk-bit--${b.k}`} data-depth={b.d} style={`left:${b.x}%; top:${b.y}%; --s:${b.s}px;`}></span>
				))}
			</div>

			<div class="wk-deckwrap">
				<div class="wk-info-col">
					<p class="wk-count" aria-hidden="true">Case study &middot; <b class="wk-cur">01</b> / {total}</p>

					<div class="wk-infos" aria-live="polite" aria-atomic="true">
						{projects.map((p, i) => (
							<div class:list={['wk-info', i === 0 && 'is-on']} data-index={i}>
								<p class="d-tag">
									<span class:list={['status-dot', `is-${p.status.toLowerCase()}`]} aria-hidden="true"></span>
									<span>{p.category}</span>
									<i aria-hidden="true"></i>
									<span>{statusLabel(p.status)}</span>
								</p>

								<h3 class="d-title" style={`--len: ${p.name.length};`}>
									<span class="wk-sr">{p.name}</span>
									<span aria-hidden="true">
										{p.name.split(' ').map((w) => (
											<span class="d-line">
												<span class="d-w">{[...w].map((c) => <span class="d-c">{c}</span>)}</span>
											</span>
										))}
									</span>
								</h3>

								<h4 class="detail-lead d-lead">{p.tagline}</h4>
								<p class="detail-desc">{p.desc}</p>
								<dl class="detail-facts">
									<div><dt>Focus</dt><dd>{p.focus}</dd></div>
									<div><dt>Format</dt><dd>{p.format}</dd></div>
								</dl>
								<a href="#contact" class="detail-cta" data-magnetic>
									<span>Build something like this</span>
									<span class="cta-arrow" aria-hidden="true">&rarr;</span>
								</a>
							</div>
						))}
					</div>
				</div>

				<div class="wk-deck-col">
				<div class="wk-deck" role="group" tabindex="0" aria-label="Project deck. Use the left and right arrow keys to browse.">
					{projects.map((p, i) => (
						<div class="wk-card" data-index={i} aria-hidden="true">
							<div class="card-top">
								<span class="card-n">{`0${i + 1}`}</span>
								<span class:list={['card-chip', `is-${p.status.toLowerCase()}`]}>{statusLabel(p.status)}</span>
							</div>
							<div class="card-art">
								<svg class="visual-art d-art" viewBox="0 0 320 200" fill="none" set:html={art[p.icon]}></svg>
							</div>
							<div class="card-bottom">
								<span class="card-cat">{p.category}</span>
								<span class="card-name">{p.name}</span>
							</div>
						</div>
					))}
					<span class="wk-drag" aria-hidden="true"></span>
				</div>

				<div class="wk-controls">
					<button type="button" class="wk-arrow" id="wkPrev" aria-label="Previous project">&larr;</button>
					<ol class="wk-dots" aria-label="Jump to project">
						{projects.map((p, i) => (
							<li>
								<button type="button" class:list={['wk-dot', i === 0 && 'is-on']} data-index={i} aria-label={`Show ${p.name}`}></button>
							</li>
						))}
					</ol>
					<button type="button" class="wk-arrow" id="wkNext" aria-label="Next project">&rarr;</button>
				</div>
				<p class="wk-hint" aria-hidden="true">Drag, click or use the arrows</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const root = document.getElementById('work');

	if (root) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const rows = Array.from(root.querySelectorAll<HTMLLIElement>('.project'));
		const countCur = root.querySelector<HTMLElement>('.count-cur')!;
		const desktop = window.matchMedia('(min-width: 861px)');
		const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
		let current = 0;

		const setActive = (i: number, animate = true) => {
			if (i === current) return;
			const prev = current;
			current = i;

			rows.forEach((row, k) => {
				const on = k === i;
				row.classList.toggle('is-active', on);
				row.querySelector('.row')?.setAttribute('aria-expanded', String(on));
			});

			countCur.textContent = String(i + 1).padStart(2, '0');

			if (!animate || reduceMotion || !desktop.matches) return;

			// the incoming detail's pieces arrive one after another; killing the
			// old tweens first keeps a fast hover from leaving anything half-faded
			const parts = rows[i].querySelectorAll('.frame, .detail-status, .detail-lead, .detail-desc, .detail-facts, .detail-cta');
			gsap.killTweensOf(rows[prev].querySelectorAll('.frame, .detail-status, .detail-lead, .detail-desc, .detail-facts, .detail-cta'));
			gsap.killTweensOf(parts);
			gsap.fromTo(
				parts,
				{ autoAlpha: 0, y: 16 },
				{ autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.06, ease: 'power3.out', clearProps: 'opacity,visibility,transform' },
			);
			gsap.fromTo(
				rows[i].querySelectorAll('.visual-art [class^="a-"]'),
				{ opacity: 0 },
				{ opacity: 1, duration: 0.6, stagger: 0.05, ease: 'power2.out', clearProps: 'opacity' },
			);
		};

		rows.forEach((row, i) => {
			const btn = row.querySelector<HTMLButtonElement>('.row')!;
			btn.addEventListener('click', () => {
				// on phones the open row can be tapped again to close it
				if (!desktop.matches && i === current) {
					row.classList.toggle('is-active');
					btn.setAttribute('aria-expanded', String(row.classList.contains('is-active')));
					return;
				}
				setActive(i);
			});
			btn.addEventListener('focus', () => desktop.matches && setActive(i));
			btn.addEventListener('pointerenter', () => desktop.matches && canHover.matches && setActive(i));
		});

		// ---------- entrance + marquee ----------
		const revealEls = Array.from(root.querySelectorAll<HTMLElement>('.reveal'));
		if (reduceMotion || !('IntersectionObserver' in window)) {
			revealEls.forEach((el) => el.classList.add('is-visible'));
		} else {
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}),
				{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
			);
			revealEls.forEach((el) => io.observe(el));

			// the strip runs faster the faster you scroll (and reverses with the
			// direction); it stops while the pointer is over it and carries on from
			// the same spot afterwards
			const track = root.querySelector('.marquee-track');
			const strip = root.querySelector('.work-marquee');
			if (track && strip) {
				const run = gsap.to(track, { xPercent: -50, duration: 38, ease: 'none', repeat: -1 });
				let hovered = false;
				let settle: ReturnType<typeof setTimeout>;
				strip.addEventListener('pointerenter', () => {
					hovered = true;
					gsap.to(run, { timeScale: 0, duration: 0.4, overwrite: true });
				});
				strip.addEventListener('pointerleave', () => {
					hovered = false;
					gsap.to(run, { timeScale: 1, duration: 0.6, overwrite: true });
				});
				ScrollTrigger.create({
					trigger: root,
					start: 'top bottom',
					end: 'bottom top',
					onUpdate: (self) => {
						if (hovered) return;
						const v = self.getVelocity();
						const boost = Math.min(6, 1 + Math.abs(v) / 350);
						gsap.to(run, { timeScale: v < 0 ? -boost : boost, duration: 0.3, overwrite: true });
						clearTimeout(settle);
						settle = setTimeout(() => !hovered && gsap.to(run, { timeScale: 1, duration: 0.9, overwrite: true }), 140);
					},
				});
			}
		}

		// ============ shuffling deck: desktop ============
		// the projects are a fanned stack of cards. The top card throws off
		// (click, drag it away, or the arrows) and the next comes forward; the
		// text beside the deck changes word by letter in step. No scroll
		// pinning, so the page keeps scrolling normally.
		const stage = root.querySelector<HTMLElement>('.wk-stage');
		if (stage) {
			const cards = Array.from(stage.querySelectorAll<HTMLElement>('.wk-card'));
			const infos = Array.from(stage.querySelectorAll<HTMLElement>('.wk-info'));
			const bits = Array.from(stage.querySelectorAll<HTMLElement>('.wk-bit'));
			const curEl = stage.querySelector<HTMLElement>('.wk-cur')!;
			const prevBtn = stage.querySelector<HTMLButtonElement>('#wkPrev')!;
			const nextBtn = stage.querySelector<HTMLButtonElement>('#wkNext')!;
			const dots = Array.from(stage.querySelectorAll<HTMLButtonElement>('.wk-dot'));
			const dragLabel = stage.querySelector<HTMLElement>('.wk-drag')!;
			const N = cards.length;

			const infoParts = (el: HTMLElement) => ({
				chars: el.querySelectorAll('.d-c'),
				rest: el.querySelectorAll('.d-tag, .d-lead, .detail-desc, .detail-facts, .detail-cta'),
			});
			const strokesOf = (card: HTMLElement) =>
				card.querySelectorAll('.d-art path:not(.a-dot), .d-art rect, .d-art circle:not(.a-dot)');

			// every stroke drawable with one dash offset
			cards.forEach((card) =>
				card.querySelectorAll<SVGGeometryElement>('.d-art path, .d-art rect, .d-art circle').forEach((el) => {
					if (el.classList.contains('a-dot')) return;
					el.setAttribute('pathLength', '1');
					el.style.strokeDasharray = '1';
				}),
			);

			gsap.matchMedia().add('(min-width: 1px)', () => {
				root.classList.add('is-deck');
				const ac = new AbortController();

				// order[0] is the card on top
				let order = cards.map((_, i) => i);
				let busy = false;
				let shown = 0;
				const dur = (s: number) => (reduceMotion ? 0 : s);

				// where a card sits at depth d in the fan
				const tilt = [0, 3.5, -3, 5, -4.5];
				const slot = (d: number) => ({
					x: d * 30,
					y: d * -14,
					rotation: tilt[d] ?? 0,
					scale: 1 - d * 0.05,
					opacity: d === 0 ? 1 : Math.max(0.5, 0.95 - d * 0.12),
				});

				const place = () => order.forEach((idx, d) => gsap.set(cards[idx], { ...slot(d), zIndex: N - d, xPercent: -50, yPercent: -50 }));

				let queued: number | null = null;
				let infoTl: gsap.core.Timeline | null = null;
				const resetInfo = () => infos.forEach((el) => gsap.set([infoParts(el).chars, infoParts(el).rest], { clearProps: 'transform,opacity' }));

				const setInfo = (to: number, animate: boolean) => {
					const from = shown;
					shown = to;
					curEl.textContent = String(to + 1).padStart(2, '0');
					dots.forEach((d, k) => {
						d.classList.toggle('is-on', k === to);
						d.setAttribute('aria-current', String(k === to));
					});
					infos.forEach((el, k) => el.toggleAttribute('inert', k !== to));

					// a reveal that is still running is stopped and its letters put
					// back, so two reveals never fight over the same letters
					if (infoTl) {
						infoTl.kill();
						infos.forEach((el) => gsap.killTweensOf([infoParts(el).chars, infoParts(el).rest]));
						resetInfo();
						infos.forEach((el, k) => el.classList.toggle('is-on', k === from));
					}

					const incoming = infoParts(infos[to]);
					if (!animate || from === to) {
						infos.forEach((el, k) => el.classList.toggle('is-on', k === to));
						return null;
					}
					const outgoing = infoParts(infos[from]);
					const tl = gsap.timeline();
					infoTl = tl;
					tl.to(outgoing.chars, { yPercent: -115, duration: dur(0.3), stagger: 0.012, ease: 'power2.in' }, 0)
						.to(outgoing.rest, { opacity: 0, y: -12, duration: dur(0.25), ease: 'power2.in' }, 0)
						.add(() => {
							infos[from].classList.remove('is-on');
							infos[to].classList.add('is-on');
							gsap.set([outgoing.chars, outgoing.rest], { clearProps: 'transform,opacity' });
						}, dur(0.32))
						.fromTo(incoming.chars, { yPercent: 115 }, { yPercent: 0, duration: dur(0.55), stagger: 0.018, ease: 'power3.out' }, dur(0.3))
						.fromTo(incoming.rest, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: dur(0.5), stagger: 0.06, ease: 'power3.out' }, dur(0.42))
						// whatever happens, finish with the full name showing
						.add(() => gsap.set([incoming.chars, incoming.rest], { clearProps: 'transform,opacity' }));
					return tl;
				};

				// input stays locked until both the cards and the text have settled
				const settle = (cardsTl: gsap.core.Timeline, _textTl: gsap.core.Timeline | null) => {
					cardsTl.eventCallback('onComplete', () => {
						busy = false;
						// a dot clicked mid-move runs as soon as the cards settle
						if (queued !== null) {
							const target = queued;
							queued = null;
							jump(target);
						}
					});
				};

				const drawIn = (card: HTMLElement) =>
					gsap.fromTo(strokesOf(card), { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: dur(0.9), stagger: 0.05, ease: 'power2.out', delay: dur(0.3) });

				// throw the top card away and bring the next forward
				const next = (dir = 1) => {
					if (busy) return;
					busy = true;
					const front = order.shift()!;
					order.push(front);
					const tl = gsap.timeline();

					tl.to(cards[front], { x: `+=${dir * 520}`, rotation: `+=${dir * 16}`, opacity: 0, duration: dur(0.5), ease: 'power2.in' }, 0);
					tl.set(cards[front], { zIndex: 0, ...slot(N - 1), x: slot(N - 1).x + dir * 40, opacity: 0 }, dur(0.5));
					tl.to(cards[front], { x: slot(N - 1).x, opacity: slot(N - 1).opacity, duration: dur(0.5), ease: 'power3.out' }, dur(0.52));

					order.slice(0, N - 1).forEach((idx, d) => {
						tl.set(cards[idx], { zIndex: N - d }, dur(0.12));
						tl.to(cards[idx], { ...slot(d), duration: dur(0.75), ease: 'power3.out' }, dur(0.12));
					});

					settle(tl, setInfo(order[0], true));
					drawIn(cards[order[0]]);
				};

				// bring a chosen card to the front, whatever its place in the stack
				const jump = (i: number): void => {
					if (busy) {
						queued = i;
						return;
					}
					if (i === order[0]) return;
					busy = true;
					const old = order[0];
					const k = order.indexOf(i);
					order = [...order.slice(k), ...order.slice(0, k)];
					const tl = gsap.timeline();

					tl.to(cards[old], { x: '+=520', rotation: '+=16', opacity: 0, duration: dur(0.45), ease: 'power2.in' }, 0);
					order.forEach((idx, d) => {
						if (idx === old) {
							tl.set(cards[idx], { zIndex: N - d, ...slot(d), opacity: 0 }, dur(0.46));
							tl.to(cards[idx], { opacity: slot(d).opacity, duration: dur(0.4) }, dur(0.5));
							return;
						}
						tl.set(cards[idx], { zIndex: N - d }, dur(0.1));
						tl.to(cards[idx], { ...slot(d), duration: dur(0.75), ease: 'power3.out' }, dur(0.1));
					});

					settle(tl, setInfo(i, true));
					drawIn(cards[i]);
				};

				// bring the last card back to the front
				const prev = () => {
					if (busy) return;
					busy = true;
					const back = order.pop()!;
					order.unshift(back);
					const tl = gsap.timeline();

					tl.set(cards[back], { zIndex: N + 1 }, 0);
					tl.fromTo(cards[back], { x: -560, y: 0, rotation: -18, scale: 1, opacity: 0 }, { ...slot(0), duration: dur(0.75), ease: 'power3.out' }, 0.05);

					order.slice(1).forEach((idx, k) => {
						const d = k + 1;
						tl.set(cards[idx], { zIndex: N - d }, 0);
						tl.to(cards[idx], { ...slot(d), duration: dur(0.75), ease: 'power3.out' }, 0.05);
					});

					settle(tl, setInfo(back, true));
					drawIn(cards[back]);
				};

				place();

				// entrance: the deck deals itself in when it scrolls into view
				if (!reduceMotion) {
					const first = infoParts(infos[0]);
					gsap.set(first.chars, { yPercent: 115 });
					gsap.set(first.rest, { opacity: 0 });
					gsap.set(cards, { opacity: 0, y: '+=110' });
					gsap.set(strokesOf(cards[0]), { strokeDashoffset: 1 });
					ScrollTrigger.create({
						trigger: stage,
						start: 'top 70%',
						once: true,
						onEnter: () => {
							order.forEach((idx, d) => gsap.to(cards[idx], { ...slot(d), duration: 0.9, ease: 'power3.out', delay: d * 0.09 }));
							gsap.to(first.chars, { yPercent: 0, duration: 0.7, stagger: 0.025, ease: 'power3.out', delay: 0.2 });
							gsap.to(first.rest, { opacity: 1, duration: 0.5, stagger: 0.06, delay: 0.4 });
				drawIn(cards[0]);
							// a single nudge on the top card, if nobody has touched it yet
							gsap.delayedCall(2, () => {
								if (touched || busy) return;
								gsap.to(cards[order[0]], { x: '+=34', rotation: '+=2.2', duration: 0.45, ease: 'power2.inOut', yoyo: true, repeat: 1 });
							});
						},
					});
				}

				let touched = false;
				const touch = () => (touched = true);
				nextBtn.addEventListener('click', () => (touch(), next(1)), { signal: ac.signal });
				dots.forEach((dot, k) => dot.addEventListener('click', () => (touch(), jump(k)), { signal: ac.signal }));
				prevBtn.addEventListener('click', () => (touch(), prev()), { signal: ac.signal });
				stage.addEventListener(
					'keydown',
					(event) => {
						if (event.key === 'ArrowRight') next(1);
						if (event.key === 'ArrowLeft') prev();
					},
					{ signal: ac.signal },
				);

				// drag the top card: past the threshold it is thrown, otherwise
				// it springs back; a plain click also throws it
				const deck = stage.querySelector<HTMLElement>('.wk-deck')!;
				let dragging: { id: number; startX: number; dx: number } | null = null;
				deck.style.touchAction = 'pan-y';
				deck.addEventListener(
					'pointerdown',
					(event) => {
						if (busy || !(event.target as HTMLElement).closest('.wk-card')) return;
						const top = cards[order[0]];
						if (!top.contains(event.target as Node)) return;
						dragging = { id: event.pointerId, startX: event.clientX, dx: 0 };
						deck.setPointerCapture(event.pointerId);
					},
					{ signal: ac.signal },
				);
				deck.addEventListener(
					'pointermove',
					(event) => {
						if (!dragging || event.pointerId !== dragging.id) return;
						dragging.dx = event.clientX - dragging.startX;
						gsap.set(cards[order[0]], { x: dragging.dx, rotation: dragging.dx * 0.05 });
						dragLabel.textContent = dragging.dx < 0 ? '\u2190 Next' : 'Next \u2192';
						dragLabel.style.opacity = String(Math.min(1, Math.abs(dragging.dx) / 110));
					},
					{ signal: ac.signal },
				);
				const release = (event: PointerEvent, cancelled = false) => {
					if (!dragging || event.pointerId !== dragging.id) return;
					const { dx } = dragging;
					dragging = null;
					dragLabel.style.opacity = '0';
					const top = cards[order[0]];
					touch();
					if (!cancelled && (Math.abs(dx) < 6 || Math.abs(dx) > 110)) next(dx < 0 ? -1 : 1);
					else gsap.to(top, { ...slot(0), duration: dur(0.7), ease: 'elastic.out(1, 0.5)' });
				};
				deck.addEventListener('pointerup', (event) => release(event), { signal: ac.signal });
				deck.addEventListener('pointercancel', (event) => release(event, true), { signal: ac.signal });

				// magnetic links: the CTA leans toward the pointer
				stage.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
					el.addEventListener(
						'pointermove',
						(event) => {
							const r = el.getBoundingClientRect();
							gsap.to(el, { x: (event.clientX - (r.left + r.width / 2)) * 0.25, y: (event.clientY - (r.top + r.height / 2)) * 0.4, duration: 0.4, ease: 'power2.out', overwrite: true });
						},
						{ signal: ac.signal },
					);
					el.addEventListener('pointerleave', () => gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)', overwrite: true }), { signal: ac.signal });
				});

				// loose shapes: drift with scroll at their own depth, plus a little
				// pointer parallax
				let prog = 0;
				let mx = 0, my = 0, tmx = 0, tmy = 0;
				ScrollTrigger.create({ trigger: stage, start: 'top bottom', end: 'bottom top', onUpdate: (self) => (prog = self.progress) });
				const tick = () => {
					mx += (tmx - mx) * 0.06;
					my += (tmy - my) * 0.06;
					const pos = prog * (N - 1);
					bits.forEach((bit) => {
						const dep = Number(bit.dataset.depth);
						bit.style.transform = `translate3d(${mx * dep * -34}px, ${-pos * dep * 150 + my * dep * -22}px, 0) rotate(${pos * dep * 36}deg)`;
					});
				};
				gsap.ticker.add(tick);
				tick();
				stage.addEventListener(
					'pointermove',
					(event) => {
						const r = stage.getBoundingClientRect();
						tmx = ((event.clientX - r.left) / r.width - 0.5) * 2;
						tmy = ((event.clientY - r.top) / r.height - 0.5) * 2;
					},
					{ signal: ac.signal },
				);

				return () => {
					ac.abort();
					gsap.ticker.remove(tick);
					root.classList.remove('is-deck');
					[...bits, ...cards].forEach((el) => el.removeAttribute('style'));
					infos.forEach((el, k) => {
						el.removeAttribute('inert');
						el.classList.toggle('is-on', k === 0);
					});
				};
			});
		}
	}
</script>

