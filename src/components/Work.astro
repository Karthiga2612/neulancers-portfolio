---
const icons: Record<string, string> = {
	chart: '<path d="M4 20V11M10 20V4M16 20v-8M22 20H2"/>',
	document: '<path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/>',
	droplet: '<path d="M12 2s7 8 7 13a7 7 0 0 1-14 0c0-5 7-13 7-13Z"/>',
	spark: '<path d="M12 3l1.6 4.9L18.5 9l-4.9 1.6L12 15.5l-1.6-4.9L5.5 9l4.9-1.6L12 3Z"/>',
	layers: '<path d="M12 4 3 9l9 5 9-5-9-5Z"/><path d="m3 14 9 5 9-5"/>',
};

const projects = [
	{
		name: 'Finveda',
		icon: 'chart',
		category: 'Fintech, India',
		tagline: 'Financial intelligence for CA firms.',
		desc: 'A system that turns raw financial data into clear, actionable intelligence for chartered accountants — built from scratch, not bolted onto existing software.',
		status: 'Built',
		focus: 'Financial ops',
		format: 'Web platform',
	},
	{
		name: 'Litwatch',
		icon: 'document',
		category: 'Legaltech, India',
		tagline: 'Keeping track of tax & legal matters.',
		desc: "Deadlines, filings, and compliance shouldn't live in someone's memory. Litwatch turns scattered legal obligations into a single, dependable system.",
		status: 'Building',
		focus: 'Compliance',
		format: 'Web platform',
	},
	{
		name: 'Mr. Water',
		icon: 'droplet',
		category: 'Operations, India',
		tagline: 'Turning a traditional water business into a connected operation.',
		desc: 'From delivery schedules to customer requests, we rebuilt how a decades-old water business runs — without asking it to become a tech company.',
		status: 'Built',
		focus: 'Field operations',
		format: 'Internal tool',
	},
	{
		name: 'AI Agents',
		icon: 'spark',
		category: 'Artificial intelligence',
		tagline: "Machines that don't just talk. They work.",
		desc: 'We build agents that take real action — checking documents, updating records, closing loops — not just answering questions.',
		status: 'Breaking',
		focus: 'Agent workflows',
		format: 'Agent system',
	},
	{
		name: 'Automation Systems',
		icon: 'layers',
		category: 'Automation',
		tagline: 'Removing repetitive work from businesses.',
		desc: 'The parts of a job nobody wants to do by hand, we quietly automate — so people can spend time on the parts that actually need them.',
		status: 'Building',
		focus: 'Process automation',
		format: 'Automation suite',
	},
];
---

<section class="work" id="work">
	<div class="work-head">
		<div class="work-eyebrow reveal" style="--reveal-order: 0">
			<span class="eyebrow-idx">03</span>
			<span class="eyebrow-dot" aria-hidden="true">&bull;</span>
			<span class="eyebrow-label">Case Studies</span>
		</div>

		<h2 class="work-heading reveal" style="--reveal-order: 1">What We've Built</h2>
		<p class="work-not reveal" style="--reveal-order: 2">Not &ldquo;Our Services.&rdquo;</p>
	</div>

	<div class="work-list">
		{projects.map((p, i) => (
			<article class:list={['work-card', 'reveal', i % 2 === 1 && 'work-card--reverse']} style={`--reveal-order: ${i + 3}`}>
				<div class="card-left">
					<div class="card-tag">
						<span class="tag-dot" aria-hidden="true"></span>
						<span>{p.category}</span>
					</div>

					<h3 class="card-name">{p.name}</h3>

					<p class="card-desc">{p.desc}</p>

					<div class="card-facts">
						<div class="fact">
							<span class="fact-value">{p.status}</span>
							<span class="fact-label">Status</span>
						</div>
						<div class="fact">
							<span class="fact-value">{p.focus}</span>
							<span class="fact-label">Focus</span>
						</div>
						<div class="fact">
							<span class="fact-value">{p.format}</span>
							<span class="fact-label">Format</span>
						</div>
					</div>

					<a href="#contact" class="card-explore">
						<span>Explore</span>
						<span class="explore-arrow">&rarr;</span>
					</a>
				</div>

				<div class="card-right">
					<span class="visual-letter" aria-hidden="true">{p.name.charAt(0)}</span>
					<svg class="visual-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]}></svg>
					<span class="visual-caption">{p.tagline}</span>
				</div>
			</article>
		))}
	</div>

	<div class="work-cta reveal" style={`--reveal-order: ${projects.length + 3}`}>
		<a href="#contact" class="cta-btn">
			<span>Bring us a problem</span>
			<span class="cta-arrow">&rarr;</span>
		</a>
	</div>
</section>

<style>
	.work {
		--ink: #f3f3f1;
		--muted: #8b929d;
		--ink-faint: rgba(139, 146, 157, 0.75);
		--border-soft: rgba(255, 255, 255, 0.1);
		--accent: #6d28d9;
		--accent-hover: #5b21b6;
		--bg: #0a0a0d;
		--visual-bg: #121620;

		position: relative;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
		border-top: 1px solid var(--border-soft);
		padding: clamp(72px, 10vw, 128px) clamp(20px, 4vw, 32px) clamp(72px, 9vw, 110px);
	}

	/* ---------- scroll-in reveal ---------- */
	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--reveal-order, 0) * 90ms);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.work-head {
		max-width: 640px;
		margin: 0 auto clamp(48px, 6vw, 72px);
		text-align: center;
	}

	.work-eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}

	.eyebrow-idx,
	.eyebrow-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow-dot {
		color: var(--accent);
		font-size: 0.6rem;
	}

	.work-heading {
		margin: 0 0 0.6rem;
		font-size: clamp(2rem, 1.6vw + 1.7rem, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.work-not {
		margin: 0;
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.82rem;
		color: var(--ink-faint);
	}

	/* ---------- project cards ---------- */
	.work-list {
		display: flex;
		flex-direction: column;
		max-width: 1320px;
		margin: 0 auto;
	}

	/* projects sit directly on the section background, separated by a
	   divider — not individually boxed cards */
	.work-card {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: center;
		border-top: 1px solid var(--border-soft);
		padding: clamp(2.5rem, 5vw, 4rem) 0;
	}

	.work-card:last-child {
		border-bottom: 1px solid var(--border-soft);
	}

	.card-left {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		order: 1;
	}

	/* every other project swaps sides — image left/right alternates
	   down the list instead of staying fixed */
	.work-card--reverse .card-left {
		order: 2;
	}

	.work-card--reverse .card-right {
		order: 1;
	}

	.card-tag {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.tag-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	.card-name {
		margin: 0;
		font-size: clamp(1.9rem, 2.1vw + 1.3rem, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.015em;
	}

	.card-desc {
		margin: 0;
		max-width: 42ch;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.card-facts {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		margin-top: 0.4rem;
	}

	.fact {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.fact-value {
		font-size: clamp(1.15rem, 1.1vw + 0.9rem, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.fact-label {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.64rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.card-explore {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		margin-top: auto;
		padding-top: 1rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.card-explore:hover,
	.card-explore:focus-visible {
		color: var(--accent);
	}

	.explore-arrow {
		transition: transform 0.2s ease;
	}

	.card-explore:hover .explore-arrow {
		transform: translateX(3px);
	}

	/* ---------- visual panel ---------- */
	.card-right {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		order: 2;
		min-height: clamp(220px, 26vw, 320px);
		background: var(--visual-bg);
		border: 1px solid var(--border-soft);
		border-radius: 18px;
		overflow: hidden;
		padding: 1.5rem;
		text-align: center;
	}

	.visual-letter {
		font-size: clamp(4.5rem, 9vw, 6.5rem);
		font-weight: 800;
		color: rgba(109, 40, 217, 0.18);
		line-height: 1;
		user-select: none;
	}

	.visual-icon {
		position: absolute;
		top: 1.1rem;
		right: 1.1rem;
		width: 26px;
		height: 26px;
		color: var(--accent);
	}

	.visual-caption {
		font-size: 0.85rem;
		color: var(--ink-faint);
		max-width: 26ch;
	}

	/* ---------- cta ---------- */
	.work-cta {
		display: flex;
		justify-content: center;
		margin-top: clamp(3rem, 6vw, 4.5rem);
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.85rem 1.6rem;
		background: var(--accent);
		color: #ffffff;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		transition: background-color 0.15s ease;
	}

	.cta-btn:hover,
	.cta-btn:focus-visible {
		background: var(--accent-hover);
	}

	.cta-arrow {
		transition: transform 0.2s ease;
	}

	.cta-btn:hover .cta-arrow {
		transform: translateX(3px);
	}

	/* ---------- responsive ---------- */
	@media (max-width: 780px) {
		.work-card {
			grid-template-columns: 1fr;
		}

		.card-right {
			order: -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.card-explore,
		.explore-arrow,
		.cta-btn,
		.cta-arrow {
			transition: none;
		}
	}
</style>

<noscript>
	<style>
		.work .reveal {
			opacity: 1 !important;
			transform: none !important;
		}
	</style>
</noscript>

<script>
	const revealEls = Array.from(document.querySelectorAll('.work .reveal')) as HTMLElement[];
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (reduceMotion || !('IntersectionObserver' in window)) {
		revealEls.forEach((el) => el.classList.add('is-visible'));
	} else {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						revealObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
		);
		revealEls.forEach((el) => revealObserver.observe(el));
	}
</script>
